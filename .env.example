# GRC Tool — environment variables
# Copy to .env and fill in values:  cp .env.example .env

NODE_ENV=production
PORT=3000

# Required: the PostgreSQL 16 database. Boot refuses a database that is not
# UTF8 with the C collation; create it with
#   createdb --template=template0 --encoding=UTF8 --locale-provider=libc --lc-collate=C --lc-ctype=C isms
# URL parameters such as sslmode and sslrootcert are passed on to the backup tools.
DATABASE_URL=postgres://isms:<choose-a-password>@127.0.0.1:5432/isms
# Docker Compose (deploy/DEPLOY.md) starts PostgreSQL with this password; set
# DATABASE_URL to postgres://isms:<the same password>@db:5432/isms there.
# POSTGRES_PASSWORD=<choose-a-password>
# Connections in the application's pool (default 10).
# PG_POOL_MAX=10
# How long a transaction waits for a lock before it fails instead of hanging,
# in milliseconds (default 30000).
# PG_LOCK_TIMEOUT_MS=30000

ISMS_UPLOADS_DIR=/app/uploads
ISMS_BACKUP_DIR=/app/data/backups
ISMS_BACKUP_RETAIN=14
ISMS_BACKUP_LOCK_STALE_MIN=360
# Daily schedule allows one missed hour beyond a 24-hour RPO.
ISMS_BACKUP_MAX_AGE_HOURS=26
# Optional: mount separate encrypted/off-host storage at this path first.
# BACKUP_MIRROR_DIR=/app/backup-mirror
# Backups use pg_dump and pg_restore from the PostgreSQL 16 client, found on
# PATH; these name other binaries.
# PG_DUMP=/usr/lib/postgresql/16/bin/pg_dump
# PG_RESTORE=/usr/lib/postgresql/16/bin/pg_restore
# A connection that may CREATE DATABASE, for the scratch databases of restore
# drills and restores, when the application's own role may not (default:
# DATABASE_URL).
# ISMS_RESTORE_ADMIN_URL=postgres://admin:<password>@127.0.0.1:5432/postgres
# Set to 1 where no recovery generations are kept (an RDS-only deployment);
# otherwise the monthly restore drill records a failure every hour.
# ISMS_RESTORE_DRILL_DISABLED=1

# Runtime drain and scheduled housekeeping.
SHUTDOWN_TIMEOUT_MS=15000
ISMS_JOB_INTERVAL_MIN=60

# Required: generate with  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
ISMS_MASTER_KEY=

# Evidence upload malware scanning. Production defaults to required and uses
# clamscan; set CLAMAV_BIN to clamdscan when a daemon is available.
UPLOAD_AV_MODE=required
# CLAMAV_BIN=/usr/bin/clamscan
# CLAMAV_TIMEOUT_MS=30000

# Initial admin account (used on first boot only)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_NAME=Admin
INITIAL_ADMIN_PASSWORD=

# Required only when running a demo seed in production. Use a unique password
# and rotate or disable the demo accounts before exposing the deployment.
DEMO_SEED_PASSWORD=

# Optional: AI assistant (powers guided risk drafting and the ISO 27001
# assessment copilot). Choose OpenRouter for open/free models, or Anthropic.
# When both keys exist, set AI_PROVIDER.
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# The Guided Assessment dropdown also includes five curated free models; this
# remains the default selection when the page opens.
# OPENROUTER_SITE_URL=https://yourdomain.com
# OPENROUTER_APP_NAME="Nimbus GRC"
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# Local policy coverage search. Embeddings and reranking run on this host and
# do not use the OpenRouter key. Install the pinned, hash-verified ONNX assets
# once with: npm run policy-models:install
POLICY_RETRIEVAL_ENABLED=true
# POLICY_MODEL_DIR=/app/models/policy-retrieval
# Keep concurrency low on small servers.
POLICY_MODEL_THREADS=1
POLICY_MODEL_BATCH_SIZE=8
# Cross-encoder relevance-logit floor. Tune only against a labelled policy set.
POLICY_RERANK_MIN_SCORE=0

# Optional non-production OpenRouter/NVIDIA policy-retrieval trial. This reuses
# OPENROUTER_API_KEY but is deliberately off by default. The two fixed free
# endpoints log inputs/outputs and must receive only public, synthetic, or
# sanitized non-confidential test data. Nimbus disables this path whenever
# NODE_ENV=production, even if this flag is true.
OPENROUTER_POLICY_RETRIEVAL_ENABLED=false
# Durable Evidence Library indexing and control-time retrieval use the same
# fixed logged free endpoints, but require their own explicit trial switch.
OPENROUTER_EVIDENCE_RETRIEVAL_ENABLED=false
OPENROUTER_POLICY_EMBED_BATCH_SIZE=128
OPENROUTER_POLICY_TIMEOUT_MS=90000
OPENROUTER_POLICY_RERANK_MIN_SCORE=0
OPENROUTER_EVIDENCE_RERANK_MIN_SCORE=0

# Transactional email is required for production readiness. Configure Resend,
# Brevo, or Gmail; the application selects the available provider.
# RESEND_API_KEY=
# BREVO_API_KEY=
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# EMAIL_FROM_DEFAULT="ISMS <noreply@yourdomain.com>"
# With no provider configured, mail is appended to data/email-dev-outbox.log;
# this names another file.
# EMAIL_DEV_OUTBOX=/app/data/email-dev-outbox.log

# Required in production: the externally reachable HTTPS URL used in links.
# APP_BASE_URL=https://yourdomain.com

# Optional: signed Third-party risk monitoring webhook verification. Configure
# a connector with the reference env://TPRM_MONITORING_WEBHOOK_SECRET, then
# inject the secret at runtime. Secret values are never entered in the UI or
# stored in the database. Use a unique random value of at least 32 bytes.
# TPRM_MONITORING_WEBHOOK_SECRET=

# Optional: public evaluation and responsible-disclosure contacts. Configure
# these before exposing the site to prospective clients. The evaluation URL
# must use HTTPS; when omitted, the public page explains how to contact the
# organization that supplied the address.
# EVALUATION_REQUEST_URL=https://yourdomain.com/request-evaluation
# EVALUATION_CONTACT_EMAIL=evaluations@yourdomain.com
# SECURITY_CONTACT_EMAIL=security@yourdomain.com

# Role experience: leave unset for per-firm production rollout (off by default).
# Set 0 for presentation rollback or 1 for isolated development/pilot override.
# Domain permissions, review protections and draft storage are always enforced.
# EXPERIENCE_ENABLED=0
