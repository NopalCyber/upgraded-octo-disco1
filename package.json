{
  "name": "iso27001-tool",
  "version": "0.1.0",
  "description": "ISO 27001:2022 implementation and audit tool for consulting firms and their clients",
  "main": "server.js",
  "scripts": {
    "seed:iso27001-test-clients": "node scripts/seed-iso27001-test-clients.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed.js",
    "backup": "node scripts/backup.js",
    "content-staleness": "node scripts/content-staleness.js",
    "policy-models:install": "node scripts/install-policy-models.js",
    "policy-models:verify": "node scripts/install-policy-models.js --verify-only",
    "policy-models:self-test": "node scripts/self-test-policy-models.js",
    "test": "node scripts/run-tests.js",
    "test:routes": "node tests/routes.test.js",
    "restore-check": "node scripts/restore-check.js",
    "test:security": "node --test --test-force-exit tests/security.test.js tests/authz-boundaries.test.js tests/platform-security.test.js tests/rbac.test.js tests/upload-security.test.js",
    "test:tprm": "node scripts/run-tprm-tests.js",
    "test:browser": "node tests/browser-ui.js"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.3.0",
    "compression": "^1.8.1",
    "content-disposition": "0.5.4",
    "docx": "^9.0.2",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-session": "^1.18.1",
    "helmet": "^8.2.0",
    "html-to-docx": "1.1.2",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.1.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.10",
    "onnxruntime-web": "1.24.3",
    "pdf-parse": "^2.4.5",
    "pg": "8.23.1",
    "puppeteer": "^25.0.4",
    "sanitize-html": "^2.17.6",
    "tinymce": "^8.8.2"
  }
}
