<%- include('partials/header', { title: 'Access reviews', user, ws, active: 'access' }) %>

<a href="/workspaces/<%= ws.id %>/access" class="link-muted text-base">← Access &amp; permissions</a>

<div class="page-head" style="margin-top:8px">
  <div><h1 class="page-title">Access reviews</h1>
    <div class="page-subtitle">A.5.18: review user access at planned intervals. Each review snapshots the current member list and lets reviewers attest, modify, or remove.</div></div>
  <form class="row-center" method="POST" action="/workspaces/<%= ws.id %>/access-reviews">
    <input class="input" name="reviewer" placeholder="Reviewer">
    <button class="btn btn-primary btn-xs">Open new review</button>
  </form>
</div>

<div class="panel"><table class="t">
  <thead><tr><th>Period</th><th>Reviewer</th><th class="num">Members</th><th class="num">Decided</th><th>Status</th><th>Closed</th></tr></thead>
  <tbody>
    <% if (!reviews.length) { %><tr><td colspan="6" class="t-empty">No reviews yet.</td></tr><% } %>
    <% reviews.forEach(r => { %>
      <tr style="cursor:pointer" onclick="location='/workspaces/<%= ws.id %>/access-reviews/<%= r.id %>'">
        <td class="meta num"><%= r.period_start %> → <%= r.period_end %></td>
        <td><%= r.reviewer || '-' %></td>
        <td class="num"><%= r.total %></td>
        <td class="num"><%= r.decided %> / <%= r.total %></td>
        <td><span class="tag <%= r.status === 'closed' ? 'tag-success' : 'tag-info' %>"><%= r.status %></span></td>
        <td class="meta"><%= r.closed_at || '-' %></td>
      </tr>
    <% }) %>
  </tbody>
</table></div>

<%- include('partials/footer') %>
