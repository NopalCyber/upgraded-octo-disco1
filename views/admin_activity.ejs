<%- include('partials/header', { title: 'Activity', user: user, ws: ws, active: active }) %>

<style>
  @media (max-width: 600px) {
    .admin-activity-row {
      grid-template-columns: 1fr !important;
      gap: 4px !important;
      min-height: 44px;
      padding: 11px 14px !important;
    }
    .admin-activity-row > span { min-width: 0; white-space: normal !important; }
    .admin-activity-row > span:last-child { font-weight: 600 !important; }
  }
</style>

<div class="page-head" style="margin-bottom:18px;">
  <div>
    <h1 class="page-title">Activity</h1>
    <div class="page-subtitle">What's happened across every client in the firm. Last 90 days, most recent 200 events. Filtered to actionable events - logins and page views are excluded so the signal stays high.</div>
  </div>
</div>

<%
  const events = (recentActivity || []).filter(a => !/^(login|logout|view_|page_)/.test(a.action || ''));
%>

<% if (!events.length) { %>
  <div class="panel panel-pad">
    <div class="t-empty">No activity recorded in the last 90 days.</div>
  </div>
<% } else { %>
  <div class="panel" style="padding:0;">
    <div style="padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:baseline;justify-content:space-between;">
      <h2 style="margin:0;font-size:14px;">Recent activity across clients</h2>
      <span class="meta text-xs"><%= events.length %> event<%= events.length === 1 ? '' : 's' %></span>
    </div>
    <% events.forEach(a => {
        const actionLabel = (a.action || '').replace(/_/g, ' ');
    %>
      <a class="admin-activity-row" href="/workspaces/<%= a.workspace_id %>" style="display:grid;grid-template-columns:160px 1fr auto;gap:14px;padding:9px 18px;border-bottom:1px solid var(--border);text-decoration:none;color:inherit;align-items:center;">
        <span class="num text-xs" style="font-family:'SF Mono',Menlo,monospace;color:var(--text-tertiary);"><%= a.created_at %></span>
        <span style="font-size:13px;color:var(--text-secondary);min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
          <strong style="font-weight: 500;color:var(--text);"><%= a.user_name || 'system' %></strong>
          <%= actionLabel %>
          <% if (a.entity_type) { %><span class="meta"><%= a.entity_type %><% if (a.entity_id) { %> #<%= a.entity_id %><% } %></span><% } %>
        </span>
        <span class="text-xs" style="color:var(--text-tertiary);font-weight:500;"><%= a.client_name %></span>
      </a>
    <% }) %>
  </div>
<% } %>

<% if (typeof pg !== 'undefined' && pg) { %><%- include('partials/pager', { pg, pagerHref }) %><% } %>

<%- include('partials/footer') %>
