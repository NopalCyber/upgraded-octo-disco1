<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>">
<link rel="stylesheet" href="/fonts/source-serif-4.css">
<link rel="stylesheet" href="/page-loader.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>">
<script src="/page-loader.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>" defer></script>
<style>
  body { margin: 0; padding: 0; background: #f2f1ec; color: #18181b; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; font-size: 14px; line-height: 1.5; min-height: 100vh; min-height: 100dvh; display: flex; align-items: center; justify-content: center; }
  .card { background: #fbfbf8; border: 1px solid #ecebe5; border-radius: 8px; padding: 36px 40px; max-width: 520px; width: calc(100% - 32px); text-align: center; box-shadow: none; }
  .icon { width: 56px; height: 56px; border-radius: 28px; margin: 0 auto 18px; display: inline-flex; align-items: center; justify-content: center; font-size: 28px; color: #fff; font-weight: 500; background: #a16207; }
  h1 { font-family: 'Source Serif 4', Georgia, serif; font-size: 22px; font-weight: 500; letter-spacing: -0.01em; margin: 8px 0 14px; }
  p { color: #51525c; margin: 0; line-height: 1.6; }
</style>
</head>
<body>
<%- include('partials/page_loader') %>
  <div class="card">
    <div class="icon">!</div>
    <h1><%= title %></h1>
    <p><%= message %></p>
  </div>
</body>
</html>
