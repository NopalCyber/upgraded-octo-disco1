<%- include('partials/header', { title: 'Generate assurance report', user, ws, active: 'assurance' }) %>
<%
  const formNow = new Date();
  const formPad = n => String(n).padStart(2, '0');
  const formToday = `${formNow.getFullYear()}-${formPad(formNow.getMonth()+1)}-${formPad(formNow.getDate())}`;
  const formCutoff = `${formToday}T${formPad(formNow.getHours())}:${formPad(formNow.getMinutes())}`;
  const qualityItems = preview && Array.isArray(preview.quality) ? preview.quality : [];
  const criticalQualityItems = qualityItems.filter(q => q.severity === 'critical');
%>

<style>
  .build-layout{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:18px;align-items:start}.build-card{border:1px solid var(--border);border-radius:8px;background:var(--surface);overflow:hidden}.build-head{padding:20px 22px;border-bottom:1px solid var(--border);background:var(--bg-subtle)}.build-head h1{font-family:var(--font-display);font-size:27px;margin:4px 0}.build-body{padding:22px}.form-section{padding:0 0 22px;margin-bottom:22px;border-bottom:1px solid var(--border)}.form-section:last-child{border:0;margin:0;padding:0}.form-section h2{font-size:14px;margin:0 0 13px}.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.type-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:1px solid var(--border);border-radius:7px;overflow:hidden}.type-tab{padding:12px;border:0;border-left:1px solid var(--border);border-radius:0;text-decoration:none;color:inherit;font-size:11px;line-height:1.3}.type-tab:first-child{border-left:0}.type-tab.active{background:var(--ink);color:var(--bg)}.sections{display:grid;grid-template-columns:1fr 1fr;gap:7px}.section-check{display:flex;align-items:center;gap:8px;padding:9px;border:1px solid var(--border);border-radius:7px;font-size:12px}.build-side{position:sticky;top:18px}.side-block{padding:16px;border:1px solid var(--border);border-radius:8px;background:var(--surface);margin-bottom:12px}.side-block h3{font-size:13px;margin:0 0 8px}.side-block p,.side-block li{font-size:11px;color:var(--text-muted);line-height:1.5}.quality-row{display:flex;gap:8px;padding:8px 0;border-bottom:1px solid var(--border);font-size:11px}.quality-row:last-child{border:0}.quality-icon{width:8px;height:8px;border-radius:50%;background:#278159;margin-top:4px;flex:0 0 auto}.quality-icon.critical{background:#b42318}.quality-icon.warning{background:#d48300}.quality-gate{border-color:#f1b4ad;background:#fff7f6}.quality-banner{border:1px solid #e9aaa3;background:#fff7f6;border-radius:7px;padding:14px 16px;margin-bottom:20px}.quality-banner strong{display:block;color:#8f251d;margin-bottom:4px}.quality-banner p{margin:0;font-size:12px;line-height:1.5;color:var(--text-muted)}.quality-fix{display:inline-block;margin-top:5px;font-size:10px;font-weight:650}.ack{padding:12px;background:#fff5e6;border:1px solid #f2ca86;border-radius:7px;font-size:11px}.generate-actions{display:grid;gap:10px}.generate-bar{display:flex;justify-content:space-between;align-items:center;gap:12px;background:#202934;color:#fff;padding:16px;border-radius:7px}.generate-bar small{color:#b8c0cc}.generate-bar .btn{white-space:nowrap}.generate-bar .btn:disabled{cursor:not-allowed;opacity:.55}
  @media(max-width:980px){.build-layout{grid-template-columns:1fr}.build-side{position:static}.type-tabs{grid-template-columns:1fr}.two,.sections{grid-template-columns:1fr}}

  @media (max-width: 760px) {
    .quality-fix
    { font-size: 11px; }
  }
</style>

<div class="page-head"><div><a href="/workspaces/<%= ws.id %>/assurance" class="link-muted text-base">← Assurance &amp; reports</a></div></div>

<div class="build-layout">
  <div class="build-card">
    <div class="build-head"><div class="meta" style="text-transform:uppercase;letter-spacing:.08em">Frozen report builder</div><h1><%= definition.name %></h1><div class="meta"><%= definition.short %></div></div>
    <div class="build-body">
      <% if (preview && preview.error) { %><div class="alert alert-error" style="margin-bottom:16px">Could not build a preview: <%= preview.error %></div><% } %>
      <% if (criticalQualityItems.length) { %><div class="quality-banner" id="quality-gate" role="alert" tabindex="-1"><strong>Preflight complete - acknowledgment required</strong><p><%= criticalQualityItems.length %> critical data-quality <%= criticalQualityItems.length === 1 ? 'issue was' : 'issues were' %> found. You can still generate the report: review the findings, then acknowledge them in the generation panel below.</p></div><% } %>
      <form id="assurance-report-form" method="POST" action="/workspaces/<%= ws.id %>/assurance/runs?type=<%= definition.key %>">
        <input type="hidden" name="report_key" value="<%= definition.key %>">
        <div class="form-section"><h2>1. Report type</h2><div class="type-tabs"><% definitions.forEach(d => { %><a class="type-tab <%= d.key === definition.key ? 'active' : '' %>" href="/workspaces/<%= ws.id %>/assurance/new?type=<%= d.key %>"><strong><%= d.name %></strong><br><span class="meta"><%= d.audience %></span></a><% }) %></div></div>
        <div class="form-section"><h2>2. Report identity and audience</h2>
          <div><label class="label" for="assurance-title">Report title</label><input id="assurance-title" class="input" name="title" required maxlength="180" value="<%= form.title || definition.name %>"></div>
          <div class="two" style="margin-top:10px"><div><label class="label" for="assurance-prepared-for">Prepared for</label><input id="assurance-prepared-for" class="input" name="prepared_for" value="<%= form.prepared_for || ws.client_name %>"></div><div><label class="label" for="assurance-prepared-by">Prepared by</label><input id="assurance-prepared-by" class="input" name="prepared_by" value="<%= form.prepared_by || '' %>" placeholder="Consultancy or report owner"></div></div>
          <div class="two" style="margin-top:10px"><div><label class="label" for="assurance-audience">Audience</label><input id="assurance-audience" class="input" name="audience" value="<%= form.audience || definition.audience %>"></div><div><label class="label" for="assurance-classification">Classification</label><select id="assurance-classification" class="select" name="classification"><% ['Confidential','Strictly confidential','Internal','Public'].forEach(v=>{ %><option <%= (form.classification || 'Confidential')===v?'selected':'' %>><%= v %></option><% }) %></select></div></div>
        </div>
        <div class="form-section"><h2>3. Scope and cutoff</h2>
          <div class="two"><div><label class="label">Reporting period starts</label><input class="input" type="date" name="reporting_period_start" value="<%= form.reporting_period_start || `${formNow.getFullYear()}-01-01` %>"></div><div><label class="label">Reporting period ends</label><input class="input" type="date" name="reporting_period_end" value="<%= form.reporting_period_end || formToday %>"></div></div>
          <div class="two" style="margin-top:10px"><div><label class="label">Data cutoff</label><input class="input" type="datetime-local" name="cutoff_at" value="<%= form.cutoff_at || formCutoff %>"><div class="help">Records are copied into an immutable snapshot at generation.</div></div><div><label class="label">Framework</label><input class="input" name="framework" value="<%= form.framework || (definition.key === 'supplier_due_diligence' ? 'ISO/IEC 27001:2022 A.5.19–A.5.23' : 'ISO/IEC 27001:2022') %>"></div></div>
          <div style="margin-top:10px"><label class="label">Scope label</label><input class="input" name="scope_label" value="<%= form.scope_label || ws.scope || '' %>" placeholder="Scope represented by this report"></div>
          <% if (definition.key === 'supplier_due_diligence') { %><div style="margin-top:10px"><label class="label">Third party</label><select class="select" name="supplier_id" required><option value="">Choose a third party…</option><% suppliers.forEach(s=>{ %><option value="<%= s.id %>" <%= String(form.supplier_id||'')===String(s.id)?'selected':'' %>><%= s.name %> · <%= s.tier ? s.tier.replaceAll('_',' ') : 'not assessed' %> · consultancy residual risk <%= s.residual_risk_band || 'not concluded' %> · client <%= s.client_decision ? s.client_decision.replaceAll('_',' ') : 'decision pending' %></option><% }) %></select><div class="help">The residual-risk conclusion is the consultancy's assessment. The client's final onboarding decision is shown separately.</div></div><% } %>
        </div>
        <div class="form-section"><h2>4. Narrative and sections</h2>
          <div><label class="label">Executive summary</label><textarea class="textarea" name="executive_summary" rows="5" maxlength="6000" placeholder="Optional. If blank, the report creates a factual summary from the frozen data."><%= form.executive_summary || '' %></textarea></div>
          <div style="margin-top:12px"><label class="label">Included sections</label><div class="sections"><% definition.sections.forEach(s=>{ const checked=!form.selected_sections || form.selected_sections.includes(s); %><label class="section-check"><input type="checkbox" name="sections" value="<%= s %>" <%= checked?'checked':'' %>><span><%= s.replaceAll('_',' ') %></span></label><% }) %></div></div>
          <div class="two" style="margin-top:10px"><div><label class="label">Watermark (optional)</label><input class="input" name="watermark" value="<%= form.watermark || '' %>" placeholder="DRAFT / BOARD COPY"></div></div>
        </div>
        <div class="generate-actions" id="generation-actions">
          <% if (criticalQualityItems.length) { %><div class="ack"><label style="display:flex;gap:8px;align-items:flex-start"><input id="ack-quality" type="checkbox" name="ack_quality" value="1" required><span><strong>I acknowledge the <%= criticalQualityItems.length %> critical data-quality <%= criticalQualityItems.length === 1 ? 'warning' : 'warnings' %>.</strong><br>They will be embedded in this immutable report version and remain visible to reviewers.</span></label></div><% } %>
          <div class="generate-bar"><div><strong><%= preview ? 'Generate immutable version' : 'Preflight and generate report' %></strong><br><small><%= preview ? 'The approved inputs will be frozen and hash-verified.' : 'If critical gaps are found, generation will pause for your acknowledgment.' %></small></div><button id="generate-assurance-report" class="btn btn-primary" <%= criticalQualityItems.length ? 'disabled' : '' %>><%= criticalQualityItems.length ? 'Generate with warnings' : (preview ? 'Generate report' : 'Check data & generate') %></button></div>
        </div>
      </form>
    </div>
  </div>
  <aside class="build-side">
    <div class="side-block"><h3>Production controls</h3><ul style="padding-left:17px;margin:0"><li>Workspace-scoped source queries</li><li>Frozen snapshot and source digests</li><li>Exact PDF, DOCX and JSON artifacts</li><li>Independent maker-checker approval</li><li>Audited status transitions</li></ul></div>
    <% if (preview && preview.quality) { %><div class="side-block <%= criticalQualityItems.length?'quality-gate':'' %>"><h3>Data-quality preflight</h3><% preview.quality.forEach(q=>{ %><div class="quality-row"><span class="quality-icon <%= q.severity %>"></span><div><strong><%= q.severity.toUpperCase() %></strong><br><%= q.message %><% if (q.href) { %><br><a class="quality-fix" href="<%= q.href %>">Fix source data →</a><% } %></div></div><% }) %></div><% } else { %><div class="side-block"><h3>Data-quality preflight</h3><p>First, check the live source set. If blocking gaps are found, you can fix them or explicitly acknowledge them before a version is frozen.</p></div><% } %>
  </aside>
</div>

<script>
  (() => {
    const acknowledgement = document.getElementById('ack-quality');
    const generateButton = document.getElementById('generate-assurance-report');
    if (acknowledgement && generateButton) {
      const syncGenerateState = () => { generateButton.disabled = !acknowledgement.checked; };
      acknowledgement.addEventListener('change', syncGenerateState);
      syncGenerateState();
      const gate = document.getElementById('quality-gate');
      if (gate) {
        gate.focus({ preventScroll: true });
        gate.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  })();
</script>

<%- include('partials/footer') %>
