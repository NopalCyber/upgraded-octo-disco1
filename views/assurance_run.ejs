<%- include('partials/header', { title: run.title, user, ws, active: 'assurance' }) %>

<style>
  .run-head{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;margin-bottom:16px}.run-head h1{font-family:var(--font-display);font-size:27px;margin:5px 0 6px}.run-actions{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}.status-pill{display:inline-flex;align-items:center;border-radius:99px;padding:4px 9px;font-size:10px;font-weight:750;text-transform:uppercase;letter-spacing:.05em;background:#eef1f5;color:#475467}.status-pill.approved,.status-pill.published{background:#e8f5ee;color:#157347}.status-pill.in_review{background:#fff4df;color:#8a5300}.status-pill.changes_requested{background:#fff0ef;color:#b42318}
  .integrity-bar{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:10px;overflow:hidden;margin-bottom:16px}.integrity-cell{background:var(--surface);padding:12px 14px}.integrity-cell span{display:block;font-size:9px;text-transform:uppercase;letter-spacing:.07em;color:var(--text-muted)}.integrity-cell strong{display:block;margin-top:3px;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mono{font-family:ui-monospace,SFMono-Regular,monospace}
  .run-layout{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:16px;align-items:start}.preview-shell{border:1px solid var(--border);background:#e9ebef;border-radius:10px;padding:12px}.preview-shell iframe{display:block;width:100%;height:760px;border:0;background:#fff;box-shadow:0 4px 17px rgba(20,25,30,.12)}.side-card{border:1px solid var(--border);border-radius:10px;background:var(--surface);margin-bottom:12px;overflow:hidden}.side-card h3{font-size:13px;margin:0;padding:13px 14px;border-bottom:1px solid var(--border)}.side-pad{padding:13px 14px}.quality-row,.event-row,.artifact-row{font-size:11px;padding:9px 0;border-bottom:1px solid var(--border)}.quality-row:last-child,.event-row:last-child,.artifact-row:last-child{border:0}.quality-row{display:flex;gap:8px}.dot{width:8px;height:8px;border-radius:50%;margin-top:4px;background:#278159;flex:none}.dot.critical{background:#b42318}.dot.warning{background:#d48300}.event-row strong{display:flex;justify-content:space-between;gap:8px}.event-row time{font-weight:400;color:var(--text-muted)}.artifact-row{display:flex;justify-content:space-between;align-items:center;gap:8px}.transition-form textarea{min-height:66px;margin-bottom:8px}.maker-note{font-size:10px;color:var(--text-muted);line-height:1.45;margin-top:7px}.warning-box{padding:11px;border:1px solid #f0c36f;background:#fff8e9;border-radius:8px;font-size:11px;margin-bottom:10px}
  @media(max-width:1000px){.run-layout{grid-template-columns:1fr}.integrity-bar{grid-template-columns:1fr 1fr}.run-head{flex-direction:column}.run-actions{justify-content:flex-start}}

  @media (max-width: 760px) {
    .status-pill,
    .integrity-cell span,
    .maker-note
    { font-size: 11px; }
  }
</style>

<div class="run-head">
  <div><a href="/workspaces/<%= ws.id %>/assurance" class="link-muted text-base">← Assurance &amp; reports</a><h1><%= run.title %></h1><div style="display:flex;align-items:center;gap:8px"><span class="status-pill <%= run.status %>"><%= run.status.replaceAll('_',' ') %></span><span class="meta"><%= run.definition_name %> · version <%= run.version_number %></span></div></div>
  <div class="run-actions">
    <a class="btn btn-secondary btn-xs" target="_blank" href="/workspaces/<%= ws.id %>/assurance/runs/<%= run.id %>/preview">Full-screen preview</a>
    <% if (caps.export) { %><a class="btn btn-secondary btn-xs" href="/workspaces/<%= ws.id %>/assurance/runs/<%= run.id %>/json">Source JSON</a><a class="btn btn-secondary btn-xs" href="/workspaces/<%= ws.id %>/assurance/runs/<%= run.id %>/docx">Word</a><a class="btn btn-primary btn-xs" href="/workspaces/<%= ws.id %>/assurance/runs/<%= run.id %>/pdf">PDF</a><% } %>
  </div>
</div>

<div class="integrity-bar">
  <div class="integrity-cell"><span>Data cutoff</span><strong><%= String(run.cutoff_at).slice(0,16).replace('T',' ') %></strong></div>
  <div class="integrity-cell"><span>Frozen snapshot</span><strong class="mono" title="<%= run.snapshot_hash %>"><%= run.snapshot_hash.slice(0,18) %>…</strong></div>
  <div class="integrity-cell"><span>Source records</span><strong><%= run.manifest.length %></strong></div>
  <div class="integrity-cell"><span>Generated by</span><strong><%= run.creator_name || '-' %> · <%= String(run.generated_at).slice(0,10) %></strong></div>
</div>

<div class="run-layout">
  <div class="preview-shell"><iframe title="Frozen report preview" src="/workspaces/<%= ws.id %>/assurance/runs/<%= run.id %>/preview"></iframe></div>
  <aside>
    <% if (run.status === 'generated') { %><div class="side-card"><h3>Submit for review</h3><div class="side-pad"><form method="POST" action="/workspaces/<%= ws.id %>/assurance/runs/<%= run.id %>/submit" class="transition-form"><textarea class="textarea" name="note" placeholder="Context for the reviewer"></textarea><button class="btn btn-primary btn-xs" <%= caps.generate?'':'disabled' %>>Submit frozen version</button></form><div class="maker-note">Submitting locks this exact snapshot into the maker-checker workflow. Requested changes require a newly generated version.</div></div></div><% } %>
    <% if (run.status === 'changes_requested' && caps.generate) { %><div class="side-card"><h3>Replacement version required</h3><div class="side-pad"><div class="warning-box">This snapshot remains immutable. Generate a new version with the requested corrections, then submit that replacement for review.</div><a class="btn btn-primary btn-xs" href="/workspaces/<%= ws.id %>/assurance/new?type=<%= run.report_key %>">Generate replacement</a></div></div><% } %>
    <% if (run.status === 'in_review' && (caps.review || caps.approve)) { %><div class="side-card"><h3>Independent review</h3><div class="side-pad"><% if (Number(run.created_by) === Number(user.id)) { %><div class="warning-box"><strong>Maker-checker separation</strong><br>You created this version, so another authorised user must approve it.</div><% } %><% if (caps.approve && Number(run.created_by) !== Number(user.id)) { %><form method="POST" action="/workspaces/<%= ws.id %>/assurance/runs/<%= run.id %>/approve" class="transition-form"><textarea class="textarea" name="note" required placeholder="Approval basis and limitations"></textarea><button class="btn btn-primary btn-xs">Approve report</button></form><hr style="border:0;border-top:1px solid var(--border);margin:12px 0"><% } %><% if (caps.review) { %><form method="POST" action="/workspaces/<%= ws.id %>/assurance/runs/<%= run.id %>/request-changes" class="transition-form"><textarea class="textarea" name="note" required placeholder="Describe the required changes"></textarea><button class="btn btn-danger btn-xs">Request changes</button></form><% } %></div></div><% } %>
    <% if (run.status === 'approved' && caps.publish) { %><div class="side-card"><h3>Publish approved report</h3><div class="side-pad"><form method="POST" action="/workspaces/<%= ws.id %>/assurance/runs/<%= run.id %>/publish" class="transition-form"><textarea class="textarea" name="note" placeholder="Publication note"></textarea><button class="btn btn-primary btn-xs">Publish report</button></form></div></div><% } %>
    <div class="side-card"><h3>Data-quality assessment</h3><div class="side-pad"><% run.quality.forEach(q=>{ %><div class="quality-row"><span class="dot <%= q.severity %>"></span><div><strong><%= q.severity.toUpperCase() %></strong><br><%= q.message %><% if(q.href){ %><br><a class="link-muted" href="<%= q.href %>">Open source area →</a><% } %></div></div><% }) %></div></div>
    <div class="side-card"><h3>Stored artifacts</h3><div class="side-pad"><% if (!artifacts.length) { %><div class="meta">Artifacts are created on first download, then served byte-for-byte from immutable storage.</div><% } %><% artifacts.forEach(a=>{ %><div class="artifact-row"><div><strong><%= a.format.toUpperCase() %></strong><br><span class="mono"><%= a.content_hash.slice(0,10) %>…</span></div><span><%= Math.ceil(a.size_bytes/1024) %> KB</span></div><% }) %></div></div>
    <div class="side-card"><h3>Lifecycle history</h3><div class="side-pad"><% events.forEach(ev=>{ %><div class="event-row"><strong><span><%= ev.action.replaceAll('_',' ') %></span><time><%= String(ev.created_at).slice(0,16) %></time></strong><div><%= ev.actor_name || 'System' %></div><div class="meta"><%= ev.note || '' %></div></div><% }) %></div></div>
  </aside>
</div>

<%- include('partials/footer') %>
