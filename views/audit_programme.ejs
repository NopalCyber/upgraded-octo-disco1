<%- include('partials/header', { title: 'Audit programme ' + year, user, ws, active: 'audits' }) %>

<div class="page-head">
  <div><h1 class="page-title">Internal audit</h1>
    <div class="page-subtitle">Programme - <%= year %>. Clause 9.2.2 requires a documented internal audit programme: frequency, methods, responsibilities, reporting.</div></div>
  <div class="row">
    <a href="?year=<%= year - 1 %>" class="btn btn-secondary btn-xs">← <%= year - 1 %></a>
    <a href="?year=<%= year + 1 %>" class="btn btn-secondary btn-xs"><%= year + 1 %> →</a>
  </div>
</div>

<%- include('partials/audit_tabs', { ws, tab: 'programme' }) %>

<div class="panel" style="margin-bottom:14px">
  <div class="panel-head"><h2>Programme</h2><% if (programme.approved_by) { %><span class="tag tag-success">approved by <%= programme.approved_by %> on <%= programme.approved_at %></span><% } %></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/audit-programme/<%= programme.id %>" class="panel-pad" style="display:grid;gap:10px;">
    <textarea class="textarea" name="description" rows="3" placeholder="Programme description: scope, frequency, methods, responsibilities, reporting…"><%= programme.description || '' %></textarea>
    <div style="display:flex;gap:6px;align-items:end;">
      <div style="flex:1;"><label class="label">Approve as</label><input class="input" name="approved_by" placeholder="ISMS Manager / Top Management"></div>
      <button class="btn btn-primary btn-xs">Save</button>
    </div>
  </form>
</div>

<div class="panel" style="margin-bottom:14px">
  <div class="panel-head"><h2>Schedule an audit</h2></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/audits" class="panel-pad" style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr auto;gap:8px;align-items:end;">
    <div><label class="label">Title</label><input class="input" name="title" required placeholder="e.g., <%= year %> Q2 ISMS Internal Audit"></div>
    <div><label class="label">Scope</label><input class="input" name="scope" placeholder="e.g., A.5 + Clauses 4–10"></div>
    <div><label class="label">Date</label><input class="input" type="date" name="audit_date" min="<%= year %>-01-01" max="<%= year %>-12-31" required></div>
    <div><label class="label">Auditor</label><input class="input" name="auditor_name" placeholder="Name / firm"></div>
    <div><button class="btn btn-primary">Add</button></div>
  </form>
</div>

<div class="panel"><div class="panel-head"><h2>Scheduled audits</h2>
  <div class="text-xs" style="display:flex;gap:10px;">
    <span style="display:flex;align-items:center;gap:4px;"><span style="width:8px;height:8px;border-radius:50%;background:#0ea5e9;"></span>planned</span>
    <span style="display:flex;align-items:center;gap:4px;"><span style="width:8px;height:8px;border-radius:50%;background:#ea580c;"></span>in progress</span>
    <span style="display:flex;align-items:center;gap:4px;"><span style="width:8px;height:8px;border-radius:50%;background:#16a34a;"></span>complete</span>
  </div>
</div>
<% const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
   const statusColor = s => s === 'complete' ? '#16a34a' : s === 'in_progress' ? '#ea580c' : '#0ea5e9';
   const statusBg    = s => s === 'complete' ? 'rgba(22,163,74,0.08)' : s === 'in_progress' ? 'rgba(234,88,12,0.08)' : 'rgba(14,165,233,0.08)';
%>
<div style="display:grid;grid-template-columns:repeat(12,1fr);gap:1px;padding:14px;background:var(--border);">
  <% for (let m = 0; m < 12; m++) { %>
    <% const monthAudits = audits.filter(a => a.audit_date && new Date(a.audit_date).getMonth() === m && new Date(a.audit_date).getFullYear() === year); %>
    <div style="background:var(--bg);padding:10px;min-height:120px;">
      <div class="meta text-eyebrow" style="font-weight: 500;text-transform:uppercase;letter-spacing:0.04em;"><%= months[m] %></div>
      <% monthAudits.forEach(a => { %>
        <a href="/workspaces/<%= ws.id %>/audits/<%= a.id %>" class="link-muted" style="display:block;font-size:11.5px;margin-top:6px;padding:5px 7px;border-radius:4px;background:<%= statusBg(a.status) %>;color:var(--text);">
          <strong style="font-weight:500;"><%= a.title %></strong>
          <div class="meta text-eyebrow"><%= a.audit_date %> · <%= (a.status || 'planned').replace('_',' ') %></div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>
</div>

<%- include('partials/footer') %>
