<%- include('partials/header', { title: 'Activity timeline', user, ws, active: 'activity' }) %>

<div class="page-head">
  <div><h1 class="page-title">Activity log</h1>
    <div class="page-subtitle">Timeline - every action by the selected user on the selected day, in order.</div></div>
  <form class="row" method="GET">
    <select name="user_id" class="select"><% users.forEach(u => { %><option value="<%= u.id %>" <%= u.id === userId ? 'selected' : '' %>><%= u.name %></option><% }) %></select>
    <input class="input" type="date" name="day" value="<%= day %>">
    <button class="btn btn-primary btn-xs">Show</button>
  </form>
</div>

<%- include('partials/activity_tabs', { ws, tab: 'timeline' }) %>

<div class="panel">
  <% if (!log.length) { %><div class="empty-state"><div class="empty-sub">No activity for this user on this day.</div></div><% } %>
  <% log.forEach((l, i) => { %>
    <div style="padding:8px 16px;border-bottom:1px solid var(--border);display:grid;grid-template-columns:120px 1fr;gap:12px;">
      <div class="meta mono text-xs"><%= l.created_at.slice(11, 19) %></div>
      <div>
        <span class="mono text-md" style="font-weight:500;"><%= l.action %></span>
        <% if (l.entity_type) { %><span class="meta">· <%= l.entity_type %><% if (l.entity_id) { %> #<%= l.entity_id %><% } %></span><% } %>
        <% if (l.ip_address) { %><span class="meta mono text-eyebrow" style="float:right;"><%= l.ip_address %></span><% } %>
        <% if (l.details) { %><div class="meta text-xs" style="font-family:ui-monospace,monospace;margin-top:2px;"><%= l.details.slice(0,160) %></div><% } %>
      </div>
    </div>
  <% }) %>
</div>

<%- include('partials/footer') %>
