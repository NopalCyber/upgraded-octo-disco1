<%- include('partials/auditor_header', { title: 'Evidence index', token, share, workspace, active: 'evidence' }) %>

<div class="a-page-head">
  <h1 class="a-page-title">Evidence index</h1>
  <div class="a-page-sub">
    Every uploaded evidence file with its SHA-256 hash and originator. Click <strong>Download</strong> to retrieve the raw file; every download is logged with timestamp, IP, and user agent.
  </div>
</div>

<% if (!evidence.length) { %>
  <div class="empty-pane">
    <div class="empty-pane-title">No evidence files yet</div>
    <div>The client has not yet uploaded any evidence.</div>
  </div>
<% } else { %>
  <div class="panel">
    <div class="panel-head"><h2>Evidence on file</h2><span class="meta"><%= evidence.length %> file<%= evidence.length === 1 ? '' : 's' %></span></div>
    <table class="t">
      <thead><tr>
        <th style="width:96px;">Control</th>
        <th>Filename</th>
        <th>SHA-256</th>
        <th class="num" style="width:80px;">Size</th>
        <th style="width:130px;">Uploader</th>
        <th style="width:110px;">Date</th>
        <th style="width:110px;text-align:right;">Action</th>
      </tr></thead>
      <tbody>
        <% evidence.forEach(e => { %>
          <tr>
            <td><% if (e.iso_item_id) { %><span class="iso-ref"><%= String(e.iso_item_id).replace('annex-','').toUpperCase() %></span><% } else { %><span class="meta">-</span><% } %></td>
            <td>
              <%= e.filename %>
              <% if (e.description) { %><div class="meta text-sm" style="margin-top:3px;"><%= e.description.slice(0,160) %><%= e.description.length > 160 ? '…' : '' %></div><% } %>
            </td>
            <td class="hash"><%= (e.sha256 || '').slice(0,32) %><%= e.sha256 && e.sha256.length > 32 ? '…' : '' %></td>
            <td class="num meta"><%= bytes(e.size_bytes) %></td>
            <td class="meta"><%= e.uploader || '-' %></td>
            <td class="meta"><%= fmtDate(e.uploaded_at) %></td>
            <td style="text-align:right;">
              <a href="/auditor/<%= token %>/evidence/<%= e.id %>/download" class="btn btn-secondary btn-xs">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Download
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('partials/auditor_footer') %>
