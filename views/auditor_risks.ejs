<% const pageTitle = 'Risk register'; %>
<%- include('partials/auditor_header', { title: pageTitle, token, share, workspace, active: 'risks' }) %>

<%
  const lScale = methodology.likelihood_scale;
  const iScale = methodology.impact_scale;
  const bands = methodology.thresholds;
  const bandCounts = {};
  risks.forEach(r => { if (r.band) bandCounts[r.band] = (bandCounts[r.band] || 0) + 1; });
%>

<div class="a-page-head">
  <h1 class="a-page-title"><%= pageTitle %></h1>
  <div class="a-page-sub">
    Methodology: <strong><%= methodology.name %></strong> · <%= lScale.length %>×<%= iScale.length %> matrix. The heatmap shows inherent risk count per cell; the table lists every risk in descending score order.
  </div>
</div>

<% if (risks.length === 0) { %>
  <div class="empty-pane">
    <div class="empty-pane-title">No risks recorded</div>
    <div>The risk register is currently empty.</div>
  </div>
<% } else { %>
  <div class="panel" style="margin-bottom:16px;">
    <div class="panel-head"><h2>Inherent risk heatmap</h2><span class="meta"><%= risks.length %> risk<%= risks.length === 1 ? '' : 's' %> · per active methodology</span></div>
    <div class="panel-pad">
      <table style="width:100%;border-collapse:separate;border-spacing:4px;">
        <thead>
          <tr><th></th><% iScale.forEach(i => { %><th style="font-size:11px;font-weight: 500;text-transform:uppercase;letter-spacing:0.04em;color:var(--text-tertiary);padding:6px;text-align:center;"><%= i.value %> · <%= i.label %></th><% }) %></tr>
        </thead>
        <tbody>
          <% for (let li = lScale.length - 1; li >= 0; li--) { const l = lScale[li]; %>
            <tr>
              <th style="text-align:right;font-size:11px;font-weight: 500;color:var(--text-tertiary);padding-right:10px;text-transform:uppercase;letter-spacing:0.04em;"><%= l.value %> · <%= l.label %></th>
              <% iScale.forEach((iL, ii) => {
                   const band = methodology.matrix[li][ii];
                   const color = bands[band] ? bands[band].color : '#a3a3a3';
                   const cellRisks = risks.filter(r => r.likelihood === l.value && r.impact === iL.value);
              %>
                <td style="text-align:center;padding:10px;background:<%= color %>1a;border:1px solid <%= color %>40;border-radius:5px;color:<%= color %>;font-weight: 500;">
                  <% if (cellRisks.length) { %>
                    <div style="font-size:18px;line-height:1.1;"><%= cellRisks.length %></div>
                    <div style="font-size:9px;font-weight: 500;text-transform:uppercase;opacity:0.7;letter-spacing:0.04em;margin-top:2px;"><%= band %></div>
                  <% } else { %>
                    <div style="font-size:9px;font-weight: 500;text-transform:uppercase;opacity:0.4;letter-spacing:0.04em;"><%= band %></div>
                  <% } %>
                </td>
              <% }) %>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head"><h2><%= pageTitle %> · all <%= risks.length %> risks</h2></div>
    <table class="t">
      <thead><tr>
        <th style="width:64px;">ID</th>
        <th>Title</th>
        <th style="width:140px;">Asset</th>
        <th class="num" style="width:60px;">L · I</th>
        <th style="width:96px;">Band</th>
        <th style="width:110px;">Treatment</th>
        <th style="width:96px;">Status</th>
        <th style="width:130px;">Owner</th>
      </tr></thead>
      <tbody>
        <% risks.forEach(r => {
             const bandColor = (r.band && bands[r.band]) ? bands[r.band].color : '#52525b';
             const statusS = String(r.status || '').toLowerCase();
             const statusKind = ['closed','treated','done'].includes(statusS) ? 'good'
                              : ['accepted','in_progress','in progress'].includes(statusS) ? 'warn'
                              : ['open'].includes(statusS) ? 'bad' : 'neutral';
        %>
          <tr>
            <td class="mono meta">R-<%= String(r.id).padStart(3,'0') %></td>
            <td>
              <%= r.title %>
              <% if (r.description) { %><div class="meta text-sm" style="margin-top:3px;"><%= r.description.slice(0,140) %><%= r.description.length > 140 ? '…' : '' %></div><% } %>
            </td>
            <td class="meta"><%= r.asset_name || '-' %></td>
            <td class="num meta"><%= r.likelihood %>·<%= r.impact %></td>
            <td>
              <% if (r.band) { %><span class="chip" style="background:<%= bandColor %>1a;color:<%= bandColor %>;text-transform:uppercase;"><%= r.band %></span><% } else { %>-<% } %>
            </td>
            <td class="meta" style="text-transform:capitalize;"><%= r.treatment || '-' %></td>
            <td><span class="chip chip-<%= statusKind %>"><%= r.status %></span></td>
            <td class="meta"><%= r.owner_name || '-' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('partials/auditor_footer') %>
