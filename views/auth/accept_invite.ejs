<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Accept invitation &middot; Compliance Sphere</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>" />
  <link rel="stylesheet" href="/page-loader.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>" />
  <script src="/page-loader.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>" defer></script>
  <style>
    :root { color-scheme: light; }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      min-height: 100dvh;
      background: #FAFAF8;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
      color: #1a1a1a;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem 2rem;
    }
    .auth-shell { width: 100%; max-width: 400px; }

    .brand { display: flex; align-items: center; gap: 9px; margin-bottom: 2.5rem; }
    .brand .name { font-size: 15px; font-weight: 500; color: #1a1a1a; letter-spacing: -0.3px; }

    h1 { font-size: 22px; font-weight: 500; margin: 0 0 0.5rem; color: #1a1a1a; letter-spacing: -0.4px; }
    .sub { font-size: 13px; color: #6b6b66; margin: 0 0 1.5rem; line-height: 1.5; }

    .inv-meta {
      background: #ffffff;
      border: 1px solid #ecebe5;
      border-radius: 6px;
      padding: 12px 14px;
      margin-bottom: 1.5rem;
    }
    .inv-meta dl {
      margin: 0;
      display: grid;
      grid-template-columns: 88px 1fr;
      gap: 6px 12px;
      font-size: 12.5px;
    }
    .inv-meta dt { color: #8a8a87; font-weight: 500; align-self: center; }
    .inv-meta dd { margin: 0; color: #1a1a1a; font-weight: 500; }

    .auth-form { display: flex; flex-direction: column; gap: 16px; }
    .field label {
      display: block;
      font-size: 12px;
      color: #4a4a47;
      margin-bottom: 6px;
      font-weight: 500;
    }
    .field input[type="text"],
    .field input[type="email"],
    .field input[type="password"] {
      width: 100%;
      height: 38px;
      padding: 0 12px;
      font-size: 13px;
      font-family: inherit;
      border: 1px solid #d8d6cf;
      background: #ffffff;
      border-radius: 6px;
      color: #1a1a1a;
      outline: none;
      transition: border-color 0.1s;
    }
    .field input:focus { border-color: #1a1a1a; }
    .field input[disabled] { background: #f4f3ee; color: #8a8a87; cursor: not-allowed; }
    .field .hint { display: block; font-size: 11.5px; color: #8a8a87; margin-top: 4px; }

    .btn-primary {
      width: 100%;
      height: 38px;
      background: #1a1a1a;
      color: #ffffff;
      border: none;
      padding: 10px;
      font-size: 13px;
      font-weight: 500;
      border-radius: 6px;
      cursor: pointer;
      margin-top: 6px;
      font-family: inherit;
      transition: background 0.1s;
    }
    .btn-primary:hover { background: #333; }

    .alert {
      font-size: 12.5px;
      padding: 10px 12px;
      border-radius: 6px;
      margin-bottom: 16px;
      line-height: 1.45;
    }
    .alert-err { background: #fbeaea; color: #7a1010; border: 1px solid #ecc6c6; }
  </style>
</head>
<body>
  <%- include('../partials/page_loader') %>
  <div class="auth-shell">
    <div class="brand">
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
        <circle cx="11" cy="11" r="9.5" fill="none" stroke="#1a1a1a" stroke-width="1.3"/>
        <circle cx="11" cy="11" r="6"   fill="none" stroke="#1a1a1a" stroke-width="1.3"/>
        <circle cx="11" cy="11" r="2.5" fill="#1a1a1a"/>
      </svg>
      <span class="name">Compliance Sphere</span>
    </div>

    <h1>Accept invitation</h1>
    <p class="sub">Choose a password to finish setting up your account. You&rsquo;ll be signed in straight away.</p>

    <div class="inv-meta">
      <dl>
        <dt>Firm</dt><dd><%= invitation.firm_name || '-' %></dd>
        <dt>Role</dt>
        <dd>
          <%
            const FIRM_LABELS = { manager: 'Manager', senior_consultant: 'Senior consultant', consultant: 'Consultant' };
            const CLIENT_LABELS = { client_owner: 'Client sponsor', isms_manager: 'Client coordinator', contributor: 'Contributor' };
          %>
          <% if (invitation.user_type === 'firm') { %>
            <%= FIRM_LABELS[invitation.firm_role] || 'Consultant' %>
          <% } else { %>
            <%= CLIENT_LABELS[invitation.workspace_role] || (invitation.workspace_role || 'member').replace('_', ' ') %>
          <% } %>
        </dd>
        <% if (invitation.workspace_name) { %>
          <dt>Workspace</dt><dd><%= invitation.workspace_name %></dd>
        <% } %>
        <dt>Email</dt><dd><%= invitation.email %></dd>
      </dl>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-err"><%= error %></div>
    <% } %>

    <form method="POST" action="/invite/<%= token %>" class="auth-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="name">Your name</label>
        <input type="text" id="name" name="name" required value="<%= invitation.name || '' %>" autocomplete="name" autofocus>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= invitation.email %>" disabled>
        <span class="hint">The invitation is tied to this address.</span>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password">
        <span class="hint">Minimum 8 characters.</span>
      </div>
      <div class="field">
        <label for="password2">Confirm password</label>
        <input type="password" id="password2" name="password2" required minlength="8" autocomplete="new-password">
      </div>
      <button type="submit" class="btn-primary">Set password and sign in</button>
    </form>
  </div>
</body>
</html>
