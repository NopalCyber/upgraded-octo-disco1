<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Forgot password &middot; Compliance Sphere</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>" />
  <link rel="stylesheet" href="/page-loader.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>" />
  <script src="/page-loader.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>" defer></script>
  <style>
    :root { color-scheme: light; }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      min-height: 100dvh;
      background: #FAFAF8;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
      color: #1a1a1a;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem 2rem;
    }
    .auth-shell { width: 100%; max-width: 360px; }

    .brand { display: flex; align-items: center; gap: 9px; margin-bottom: 2.5rem; }
    .brand .name { font-size: 15px; font-weight: 500; color: #1a1a1a; letter-spacing: -0.3px; }

    h1 { font-size: 22px; font-weight: 500; margin: 0 0 0.5rem; color: #1a1a1a; letter-spacing: -0.4px; }
    .sub { font-size: 13px; color: #6b6b66; margin: 0 0 2rem; line-height: 1.5; }

    .auth-form { display: flex; flex-direction: column; gap: 16px; }
    .field label {
      display: block;
      font-size: 12px;
      color: #4a4a47;
      margin-bottom: 6px;
      font-weight: 500;
    }
    .field input[type="email"] {
      width: 100%;
      height: 38px;
      padding: 0 12px;
      font-size: 13px;
      font-family: inherit;
      border: 1px solid #d8d6cf;
      background: #ffffff;
      border-radius: 6px;
      color: #1a1a1a;
      outline: none;
      transition: border-color 0.1s;
    }
    .field input[type="email"]:focus { border-color: #1a1a1a; }

    .btn-primary {
      width: 100%;
      height: 38px;
      background: #1a1a1a;
      color: #ffffff;
      border: none;
      padding: 10px;
      font-size: 13px;
      font-weight: 500;
      border-radius: 6px;
      cursor: pointer;
      margin-top: 6px;
      font-family: inherit;
      transition: background 0.1s;
    }
    .btn-primary:hover { background: #333; }

    .back-row { text-align: center; margin-top: 1.5rem; font-size: 12px; }
    .back-row a {
      color: #1a1a1a;
      text-decoration: none;
      border-bottom: 1px solid #d8d6cf;
    }
    .back-row a:hover { border-bottom-color: #1a1a1a; }

    .alert {
      font-size: 12.5px;
      padding: 10px 12px;
      border-radius: 6px;
      margin-bottom: 16px;
      line-height: 1.45;
    }
    .alert-err { background: #fbeaea; color: #7a1010; border: 1px solid #ecc6c6; }
    .alert-ok  { background: #e9f4ec; color: #0f5132; border: 1px solid #c7e2cf; }
  </style>
</head>
<body>
  <%- include('../partials/page_loader') %>
  <div class="auth-shell">
    <div class="brand">
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
        <circle cx="11" cy="11" r="9.5" fill="none" stroke="#1a1a1a" stroke-width="1.3"/>
        <circle cx="11" cy="11" r="6"   fill="none" stroke="#1a1a1a" stroke-width="1.3"/>
        <circle cx="11" cy="11" r="2.5" fill="#1a1a1a"/>
      </svg>
      <span class="name">Compliance Sphere</span>
    </div>

    <h1>Forgot password</h1>
    <p class="sub">Enter the email on your account. We&rsquo;ll send you a single-use link to choose a new password.</p>

    <% if (typeof notice !== 'undefined' && notice) { %>
      <div class="alert alert-ok"><%= notice %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-err"><%= error %></div>
    <% } %>

    <% if (!(typeof submitted !== 'undefined' && submitted)) { %>
      <form method="POST" action="/forgot" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="name@company.com"
            autocomplete="email"
            required
            autofocus
            value="<%= typeof prefillEmail !== 'undefined' ? prefillEmail : '' %>"
          />
        </div>
        <button type="submit" class="btn-primary">Send reset link</button>
      </form>
    <% } %>

    <div class="back-row"><a href="/login">Back to sign in</a></div>
  </div>
</body>
</html>
