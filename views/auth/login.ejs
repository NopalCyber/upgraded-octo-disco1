<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="view-transition" content="same-origin" />
  <title>Sign in &middot; Compliance Sphere</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>" />
  <link rel="stylesheet" href="/page-loader.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>" />
  <script src="/page-loader.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>" defer></script>
  <style>
    @view-transition { navigation: auto; }
    ::view-transition-old(root),
    ::view-transition-new(root) { animation-duration: 0s; }

    :root { color-scheme: light; }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      min-height: 100dvh;
      background: #FAFAF8;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
      color: #1a1a1a;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem 2rem;
    }
    .auth-shell { width: 100%; max-width: 360px; }

    .brand { display: flex; align-items: center; gap: 9px; margin-bottom: 2.5rem; }
    .brand .name { font-size: 15px; font-weight: 500; color: #1a1a1a; letter-spacing: -0.3px; }

    h1 { font-size: 22px; font-weight: 500; margin: 0 0 0.5rem; color: #1a1a1a; letter-spacing: -0.4px; }
    .sub { font-size: 13px; color: #6b6b66; margin: 0 0 2rem; }

    .auth-form { display: flex; flex-direction: column; gap: 16px; }
    .field label {
      display: block;
      font-size: 12px;
      color: #4a4a47;
      margin-bottom: 6px;
      font-weight: 500;
    }
    .field input[type="email"], .field input[type="password"] {
      width: 100%;
      height: 38px;
      padding: 0 12px;
      font-size: 13px;
      font-family: inherit;
      border: 1px solid #d8d6cf;
      background: #ffffff;
      border-radius: 6px;
      color: #1a1a1a;
      outline: none;
      transition: border-color 0.1s;
    }
    .field input[type="email"]:focus, .field input[type="password"]:focus { border-color: #1a1a1a; }

    .row-between {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 2px;
    }
    .remember {
      display: flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      font-size: 12px;
      color: #4a4a47;
      margin: 0;
    }
    .remember input[type="checkbox"] { margin: 0; width: 13px; height: 13px; accent-color: #1a1a1a; }
    .row-between a {
      font-size: 12px;
      color: #1a1a1a;
      text-decoration: none;
      border-bottom: 1px solid #d8d6cf;
    }
    .row-between a:hover { border-bottom-color: #1a1a1a; }

    .btn-primary {
      width: 100%;
      height: 38px;
      background: #1a1a1a;
      color: #ffffff;
      border: none;
      padding: 10px;
      font-size: 13px;
      font-weight: 500;
      border-radius: 6px;
      cursor: pointer;
      margin-top: 6px;
      font-family: inherit;
      transition: background 0.1s;
    }
    .btn-primary:hover { background: #333; }

    .foot {
      font-size: 12px;
      color: #6b6b66;
      text-align: center;
      margin: 2.5rem 0 0;
    }
    .foot a {
      color: #1a1a1a;
      text-decoration: none;
      font-weight: 500;
    }
    .foot a:hover { text-decoration: underline; }
    .public-links { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 14px; margin-top: 18px; font-size: 11.5px; }
    .public-links a { color: #6b6b66; text-underline-offset: 3px; }

    .alert {
      font-size: 12.5px;
      padding: 10px 12px;
      border-radius: 6px;
      margin-bottom: 16px;
      line-height: 1.45;
    }
    .alert-err { background: #fbeaea; color: #7a1010; border: 1px solid #ecc6c6; }
    .alert-ok  { background: #e9f4ec; color: #0f5132; border: 1px solid #c7e2cf; }
  </style>
</head>
<body>
  <%- include('../partials/page_loader') %>
  <div class="auth-shell">
    <div class="brand">
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
        <circle cx="11" cy="11" r="9.5" fill="none" stroke="#1a1a1a" stroke-width="1.3"/>
        <circle cx="11" cy="11" r="6"   fill="none" stroke="#1a1a1a" stroke-width="1.3"/>
        <circle cx="11" cy="11" r="2.5" fill="#1a1a1a"/>
      </svg>
      <span class="name">Compliance Sphere</span>
    </div>

    <h1>Sign in</h1>
    <p class="sub">Welcome back. Please enter your details.</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-err"><%= error %></div>
    <% } %>
    <% if (typeof notice !== 'undefined' && notice) { %>
      <div class="alert alert-ok"><%= notice %></div>
    <% } %>

    <form method="POST" action="/login" class="auth-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (typeof next_url !== 'undefined' && next_url) { %>
        <input type="hidden" name="next" value="<%= next_url %>">
      <% } %>

      <div class="field">
        <label for="email">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="name@company.com"
          autocomplete="username"
          required
          autofocus
          value="<%= typeof prefillEmail !== 'undefined' ? prefillEmail : '' %>"
        />
      </div>

      <div class="field">
        <label for="password">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          autocomplete="current-password"
          required
        />
      </div>

      <div class="row-between">
        <label class="remember">
          <input type="checkbox" name="remember" value="1"> Remember me
        </label>
        <a href="/forgot">Forgot password</a>
      </div>

      <button type="submit" class="btn-primary">Sign in</button>
    </form>
    <p class="foot">Need access? <a href="/register">Request an evaluation</a></p>
    <nav class="public-links" aria-label="Public information">
      <a href="/">Overview</a><a href="/security">Security</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a>
    </nav>
  </div>
</body>
</html>
