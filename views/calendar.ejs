<%- include('partials/header', { title: 'Calendar', user, ws, active: 'calendar' }) %>

<%
  const today = new Date().toISOString().slice(0, 10);
  const kindColor = {
    'audit':       '#0891b2',
    'mrm':         '#475569',
    'nc':          '#b91c1c',
    'cert':        '#16a34a',
    'doc-review':  '#a16207',
    'treatment':   '#ea580c',
    'risk-accept': '#dc2626',
    'plan-milestone': '#0f766e',
    'deliverable': '#7c3aed',
    'task': '#64748b'
  };
  const kindLabel = {
    'audit': 'audit', 'mrm': 'MRM', 'nc': 'NC', 'cert': 'cert event',
    'doc-review': 'doc review', 'treatment': 'treatment', 'risk-accept': 'risk acceptance',
    'plan-milestone': 'plan milestone', 'deliverable': 'deliverable', 'task': 'task'
  };
%>

<style>
  .calendar-mobile-agenda { display: none; }
  .calendar-mobile-day + .calendar-mobile-day { border-top: 1px solid var(--border); }
  .calendar-mobile-day { padding: 12px 14px; }
  .calendar-mobile-date { display: block; margin-bottom: 8px; font-weight: 600; }
  .calendar-mobile-event {
    display: grid;
    grid-template-columns: 9px minmax(0, 1fr) auto;
    gap: 8px;
    align-items: baseline;
    min-height: 44px;
    padding: 8px 0;
    color: inherit;
    text-decoration: none;
  }
  .calendar-mobile-event + .calendar-mobile-event { border-top: 1px dashed var(--border); }
  .calendar-mobile-dot { width: 8px; height: 8px; border-radius: 2px; }
  @media (max-width: 600px) {
    .calendar-month-nav {
      display: grid !important;
      grid-template-columns: 1fr 1fr;
      width: 100%;
    }
    .calendar-month-nav > strong {
      grid-column: 1 / -1;
      grid-row: 1;
      min-width: 0 !important;
    }
    .calendar-month-nav > .btn { justify-content: center; }
    .calendar-month-nav > .meta {
      grid-column: 1 / -1;
      margin: 2px 0 0 !important;
      text-align: center;
    }
    .calendar-desktop-grid { display: none; }
    .calendar-mobile-agenda { display: block; }
  }
</style>

<div class="page-head">
  <div>
    <h1 class="page-title">Calendar</h1>
    <div class="page-subtitle">Date projection of the delivery plan and operational registers: milestones, deliverables, tasks, audits, reviews, findings and recurring obligations.</div>
  </div>
  <div class="row-center calendar-month-nav">
    <a href="?month=<%= prevMo %>" class="btn btn-secondary btn-xs">← Prev</a>
    <strong class="text-xl" style="min-width:160px;text-align:center;"><%= monthLabel %></strong>
    <a href="?month=<%= nextMo %>" class="btn btn-secondary btn-xs">Next →</a>
    <span class="meta text-base" style="margin-left:12px;"><%= totalEvents %> event<%= totalEvents === 1 ? '' : 's' %> this month</span>
  </div>
</div>

<div class="text-sm" style="display:flex;gap:14px;flex-wrap:wrap;margin-bottom:14px;">
  <% Object.keys(kindLabel).forEach(k => { %>
    <span style="display:inline-flex;gap:4px;align-items:center;">
      <span style="width:10px;height:10px;border-radius:2px;background:<%= kindColor[k] %>;"></span>
      <%= kindLabel[k] %>
    </span>
  <% }) %>
</div>

<div class="panel calendar-desktop-grid" style="overflow:hidden;">
  <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:0;">
    <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(d => { %>
      <div class="text-xs text-secondary" style="padding:8px 10px;font-weight: 500;text-transform:uppercase;letter-spacing:0.05em;border-bottom:1px solid var(--border);background:var(--bg-subtle);text-align:center;"><%= d %></div>
    <% }) %>
    <% cells.forEach((c, idx) => {
         const isToday = c && c.date === today;
         const colIdx = idx % 7;
    %>
      <div style="min-height:96px;padding:6px 8px;border-right:<%= colIdx < 6 ? '1px solid var(--border)' : 'none' %>;border-bottom:1px solid var(--border);<%= isToday ? 'background:rgba(8,145,178,0.05);' : '' %>">
        <% if (c) { %>
          <div style="font-size:11.5px;font-weight:<%= isToday ? '700' : '500' %>;color:<%= isToday ? '#0891b2' : 'var(--text-secondary)' %>;margin-bottom:4px;"><%= c.day %></div>
          <% c.events.slice(0, 3).forEach(e => { %>
            <a href="<%= e.link %>" style="display:block;text-decoration:none;font-size:10.5px;line-height:1.35;padding:1px 4px;margin-bottom:2px;border-radius:2px;background:<%= kindColor[e.kind] || '#666' %>;color:white;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= kindLabel[e.kind] || e.kind %>: <%= e.title %>"><%= e.title %></a>
          <% }) %>
          <% if (c.events.length > 3) { %>
            <div class="meta text-xxs">+ <%= c.events.length - 3 %> more</div>
          <% } %>
        <% } %>
      </div>
    <% }) %>
  </div>
</div>

<section class="panel calendar-mobile-agenda" aria-label="Events in <%= monthLabel %>">
  <%
    const agendaDays = cells.filter(c => c && c.events.length);
  %>
  <% if (!agendaDays.length) { %>
    <div class="empty-state"><div class="empty-sub">No events this month.</div></div>
  <% } else { %>
    <% agendaDays.forEach(c => { %>
      <div class="calendar-mobile-day">
        <time class="calendar-mobile-date" datetime="<%= c.date %>"><%= new Date(c.date + 'T00:00:00').toLocaleDateString('en', { weekday: 'long', day: 'numeric', month: 'short' }) %></time>
        <% c.events.forEach(e => { %>
          <a class="calendar-mobile-event" href="<%= e.link %>">
            <span class="calendar-mobile-dot" style="background:<%= kindColor[e.kind] || '#666' %>;"></span>
            <span><%= e.title %></span>
            <span class="meta text-xs"><%= kindLabel[e.kind] || e.kind %></span>
          </a>
        <% }) %>
      </div>
    <% }) %>
  <% } %>
</section>

<%- include('partials/footer') %>
