<%- include('partials/header', { title: 'Certification cycle', user, ws, active: 'cert-cycle' }) %>

<%
  const today = new Date().toISOString().slice(0,10);
  const ETYPES = {};
  eventTypes.forEach(t => { ETYPES[t.key] = t; });
  const canManageNc = typeof userPerms !== 'undefined' && rbac.hasPermission(userPerms, 'nc.manage');
  const daysUntil = (d) => {
    if (!d) return null;
    const ms = new Date(d).getTime() - Date.now();
    return Math.floor(ms / 86400000);
  };
  const upcoming = events.filter(e => e.status !== 'closed' && e.planned_date && e.planned_date >= today)
                          .sort((a,b) => (a.planned_date < b.planned_date ? -1 : 1))[0];
%>

<div class="page-head">
  <div>
    <h1 class="page-title">Certification cycle</h1>
    <div class="page-subtitle">Stage 1 → Stage 2 → annual surveillance for two years → 3-year recertification. Plan the calendar, track actuals, never miss a surveillance window.</div>
  </div>
</div>

<% if (upcoming) {
     const days = daysUntil(upcoming.planned_date);
     const t = ETYPES[upcoming.event_type];
%>
  <div class="panel kpi" style="margin-bottom:18px;">
    <div class="panel-pad">
      <div class="meta text-sm" style="text-transform:uppercase;letter-spacing:0.05em;">Next event</div>
      <div style="font-size:18px;font-weight: 500;margin-top:4px;"><%= t ? t.label : upcoming.event_type %></div>
      <div class="meta text-lg" style="margin-top:2px;">
        <%= upcoming.planned_date %>
        <% if (days >= 0) { %>· <strong style="color:<%= days < 30 ? '#b91c1c' : days < 90 ? '#a16207' : 'var(--text)' %>;"><%= days %> day<%= days === 1 ? '' : 's' %></strong> away<% } %>
      </div>
    </div>
  </div>
<% } %>

<div class="panel" style="margin-bottom:18px;">
  <div class="panel-head" style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;">
    <div>
      <h2>Stage 2 delivery checkpoint</h2>
      <div class="meta text-sm" style="margin-top:3px;">The consulting team supports and represents the client during the Stage 2 audit, records the certification-body outcome, and coordinates corrective action through validated closure.</div>
    </div>
    <a class="btn btn-secondary btn-xs" href="/workspaces/<%= ws.id %>/engagement-plan">Open delivery milestones</a>
  </div>
  <div class="panel-pad" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;">
    <div style="padding:12px;border:1px solid var(--border);border-radius:8px;">
      <div class="meta text-sm">Stage 2 audit support</div>
      <strong class="<%= stage2State.auditComplete ? 'text-success' : 'text-warning' %>" style="display:block;margin-top:4px;"><%= stage2State.auditComplete ? 'Completed and dated' : 'Completion not recorded' %></strong>
    </div>
    <div style="padding:12px;border:1px solid var(--border);border-radius:8px;">
      <div class="meta text-sm">Open material findings</div>
      <strong class="<%= stage2State.openMaterialFindings ? 'text-danger' : 'text-success' %>" style="display:block;margin-top:4px;"><%= stage2State.openMaterialFindings %> major or minor</strong>
    </div>
    <div style="padding:12px;border:1px solid var(--border);border-radius:8px;">
      <div class="meta text-sm">Open observations</div>
      <strong class="<%= stage2State.openObservations ? 'text-danger' : 'text-success' %>" style="display:block;margin-top:4px;"><%= stage2State.openObservations %> tracked</strong>
    </div>
  </div>
</div>

<% if (events.length === 0) { %>
  <div class="panel" style="margin-bottom:18px;">
    <div class="panel-head"><h2>No cycle planned yet</h2></div>
    <div class="panel-pad">
      <div class="text-lg" style="line-height:1.55;margin-bottom:14px;">
        A typical first-cert path: Stage 1 in ~60 days, Stage 2 ~30 days after Stage 1, surveillance audits at year 1 and year 2, recertification at year 3. Seed these defaults to start, then edit the dates as the cert body confirms.
      </div>
      <form method="POST" action="/workspaces/<%= ws.id %>/cert-cycle/seed" style="display:inline;">
        <button class="btn btn-primary">Seed default cycle (5 events)</button>
      </form>
    </div>
  </div>
<% } else { %>
  <div class="panel" style="margin-bottom:18px;">
    <div class="panel-head"><h2>Cycle (<%= events.length %>)</h2></div>
    <table class="t">
      <thead><tr>
        <th style="width:240px;">Event</th>
        <th style="width:130px;">Planned</th>
        <th style="width:130px;">Actual</th>
        <th style="width:120px;">Status</th>
        <th style="width:160px;">Cert body</th>
        <th>Notes</th>
        <th style="width:80px;"></th>
      </tr></thead>
      <tbody>
        <% events.forEach(e => {
             const t = ETYPES[e.event_type] || { label: e.event_type, desc: '' };
             const days = daysUntil(e.planned_date);
             const overdue = e.planned_date && e.planned_date < today && e.status !== 'closed' && !e.actual_date;
        %>
          <form method="POST" action="/workspaces/<%= ws.id %>/cert-cycle/<%= e.id %>" class="contents">
            <tr id="cert-event-row-<%= e.id %>">
              <td>
                <div class="text-lg" style="font-weight:500;"><%= t.label %></div>
                <div class="meta text-sm"><%= t.desc %></div>
              </td>
              <td>
                <input type="date" name="planned_date" value="<%= e.planned_date || '' %>" class="input" style="font-size:12px;<%= overdue ? 'border-color:#b91c1c;color:#b91c1c;' : '' %>">
                <% if (days != null && e.status !== 'closed' && !e.actual_date) { %>
                  <div class="meta text-eyebrow"><%= days < 0 ? Math.abs(days) + 'd overdue' : days + 'd away' %></div>
                <% } %>
              </td>
              <td><input type="date" name="actual_date" value="<%= e.actual_date || '' %>" class="input text-base"></td>
              <td>
                <select name="status" class="select text-base">
                  <% ['planned','in_progress','closed','rescheduled'].forEach(s => { %>
                    <option value="<%= s %>" <%= e.status === s ? 'selected' : '' %>><%= s %></option>
                  <% }) %>
                </select>
              </td>
              <td><input type="text" name="certification_body" value="<%= e.certification_body || '' %>" class="input text-base" placeholder="-"></td>
              <td><input type="text" name="notes" value="<%= e.notes || '' %>" class="input text-base" placeholder="-"></td>
              <td><button class="btn btn-ghost btn-xs text-xs">Save</button></td>
            </tr>
          </form>
          <% if (['stage_1','stage_2'].includes(e.event_type)) {
               const stageLabel = e.event_type === 'stage_1' ? 'Stage 1' : 'Stage 2';
          %>
            <tr id="cert-event-<%= e.id %>">
              <td colspan="7" style="padding:0;background:var(--bg-subtle);">
                <div style="padding:14px 18px;display:grid;gap:12px;">
                  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;">
                    <div>
                      <strong><%= stageLabel %> support, representation and findings</strong>
                      <div class="meta text-sm" style="margin-top:3px;">Enter the actual audit date and close the event only after the certification-body audit is complete. Record every finding below so remediation retains direct audit lineage.</div>
                    </div>
                    <div class="row-center" style="flex-wrap:wrap;justify-content:flex-end;">
                      <span class="tag <%= e.status === 'closed' && e.actual_date ? 'tag-success' : 'tag-neutral' %>"><%= e.status === 'closed' && e.actual_date ? 'Audit complete' : 'Audit support open' %></span>
                      <span class="tag <%= e.open_material_findings ? 'tag-danger' : 'tag-success' %>"><%= e.open_material_findings %> material open</span>
                      <span class="tag <%= e.open_observations ? 'tag-danger' : 'tag-success' %>"><%= e.open_observations %> observation<%= e.open_observations === 1 ? '' : 's' %> open</span>
                    </div>
                  </div>

                  <% if (e.findings.length) { %>
                    <table class="t" style="background:var(--bg);border:1px solid var(--border);">
                      <thead><tr><th>Finding / observation</th><th style="width:110px;">Severity</th><th style="width:120px;">Status</th><th style="width:90px;"></th></tr></thead>
                      <tbody>
                        <% e.findings.forEach(finding => { %>
                          <tr>
                            <td><strong><%= finding.title %></strong><% if (finding.description) { %><div class="meta text-sm" style="margin-top:2px;"><%= finding.description %></div><% } %></td>
                            <td><span class="tag <%= finding.severity === 'major' ? 'tag-danger' : finding.severity === 'minor' ? 'tag-warn' : 'tag-neutral' %>"><%= finding.severity %></span></td>
                            <td><span class="status s-<%= ['closed','verified'].includes(finding.status) ? 'done' : finding.status %>"><%= finding.status.replaceAll('_',' ') %></span></td>
                            <td><a class="btn btn-secondary btn-xs" href="/workspaces/<%= ws.id %>/nonconformities/<%= finding.id %>">Manage</a></td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  <% } else { %>
                    <div class="meta text-sm">No <%= stageLabel %> findings have been recorded. If the certification body raises none, the remediation milestone becomes clear when this audit is closed with an actual date.</div>
                  <% } %>

                  <% if (canManageNc) { %>
                    <details>
                      <summary class="btn btn-secondary btn-xs" style="display:inline-flex;list-style:none;cursor:pointer;">+ Record <%= stageLabel %> finding or observation</summary>
                      <form method="POST" action="/workspaces/<%= ws.id %>/cert-cycle/<%= e.id %>/findings" style="display:grid;grid-template-columns:minmax(220px,1fr) 150px minmax(260px,1.4fr) auto;gap:8px;align-items:end;margin-top:10px;">
                        <div><label class="label">Title</label><input class="input" name="title" required maxlength="300" placeholder="Certification-body finding"></div>
                        <div><label class="label">Classification</label><select class="select" name="severity"><option value="major">Major NC</option><option value="minor">Minor NC</option><option value="observation" selected>Observation</option></select></div>
                        <div><label class="label">Condition / auditor note</label><input class="input" name="description" maxlength="5000" placeholder="What the auditor observed"></div>
                        <button class="btn btn-primary">Record</button>
                      </form>
                    </details>
                  <% } %>
                  <div class="meta text-xs">Every open nonconformity and observation blocks this audit's remediation milestone. Stage 2 remediation must be clear before the certification-support engagement can complete.</div>
                </div>
              </td>
            </tr>
          <% } %>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<div class="panel">
  <div class="panel-head"><h2>Add ad-hoc event</h2></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/cert-cycle" class="panel-pad" style="display:grid;grid-template-columns:200px 130px 1fr 1fr auto;gap:8px;align-items:end;">
    <div>
      <label class="label">Event type</label>
      <select name="event_type" class="select" required>
        <% eventTypes.forEach(t => { %><option value="<%= t.key %>"><%= t.label %></option><% }) %>
      </select>
    </div>
    <div><label class="label">Planned</label><input type="date" name="planned_date" class="input"></div>
    <div><label class="label">Cert body</label><input type="text" name="certification_body" class="input" placeholder="BSI / DNV / etc."></div>
    <div><label class="label">Notes</label><input type="text" name="notes" class="input"></div>
    <div><button class="btn btn-primary">Add</button></div>
  </form>
</div>

<%- include('partials/footer') %>
