<%- include('partials/header', { title: change.title, user, ws, active: 'changes' }) %>

<a href="/workspaces/<%= ws.id %>/changes" class="link-muted text-base">&larr; All changes</a>

<%
  const statuses = ['draft','submitted','approved','implemented','closed'];
  const currentIdx = statuses.indexOf(change.status);
  const isRejected = change.status === 'rejected';
  const isDraft = change.status === 'draft';
  const isSubmitted = change.status === 'submitted';
  const isApproved = change.status === 'approved';
  const isImplemented = change.status === 'implemented';
  const isClosed = change.status === 'closed';
  const isEmergency = change.change_type === 'emergency';
  const editable = isDraft || isRejected;
  const needsPIR = isImplemented && !change.closed_at;
  const needsRetroApproval = isEmergency && isImplemented && !approvals.some(a => a.decision === 'approved');
%>

<div class="panel" style="margin-top:12px;padding:16px 20px;">
  <div style="display:flex;align-items:center;gap:0;">
    <% statuses.forEach((s, i) => { %>
      <div style="flex:1;text-align:center;">
        <div style="display:flex;align-items:center;">
          <% if (i > 0) { %>
            <div style="flex:1;height:3px;background:<%= (isRejected ? (i <= 1 ? 'var(--accent)' : 'var(--border)') : i <= currentIdx ? 'var(--accent)' : 'var(--border)') %>;"></div>
          <% } %>
          <div style="width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight: 500;flex-shrink:0;
            background:<%= (isRejected && i > 1) ? 'var(--border)' : i <= currentIdx ? 'var(--accent)' : 'var(--border)' %>;
            color:<%= (isRejected && i > 1) ? 'var(--text-secondary)' : i <= currentIdx ? '#fff' : 'var(--text-secondary)' %>;">
            <%= i < currentIdx ? '&#10003;' : i + 1 %>
          </div>
          <% if (i < statuses.length - 1) { %>
            <div style="flex:1;height:3px;background:<%= (isRejected ? (i < 1 ? 'var(--accent)' : 'var(--border)') : i < currentIdx ? 'var(--accent)' : 'var(--border)') %>;"></div>
          <% } %>
        </div>
        <div class="meta text-xs" style="margin-top:4px;text-transform:capitalize;<%= i === currentIdx ? 'font-weight: 500;color:var(--text-primary);' : '' %>"><%= s %></div>
      </div>
    <% }) %>
  </div>
  <% if (isRejected) { %>
    <div style="margin-top:10px;text-align:center;">
      <span class="tag tag-danger" style="font-size:13px;padding:4px 12px;">REJECTED</span>
    </div>
  <% } %>
</div>

<div class="panel" style="margin-top:12px">
  <div class="panel-pad" style="border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:12px;">
    <div>
      <div class="mono meta">CHG-<%= String(change.id).padStart(3,'0') %></div>
      <h1 class="page-title" style="margin-top:2px;"><%= change.title %></h1>
    </div>
    <div class="row-center" style="gap:8px;">
      <span class="tag <%= isEmergency ? 'tag-danger' : change.change_type === 'standard' ? 'tag-ok' : 'tag-info' %>"><%= change.change_type %></span>
      <span class="tag <%= change.risk_level === 'critical' || change.risk_level === 'high' ? 'tag-danger' : change.risk_level === 'medium' ? 'tag-warn' : 'tag-neutral' %>"><%= change.risk_level %> risk</span>
      <span class="status s-<%= isClosed ? 'done' : isRejected ? 'overdue' : 'open' %>"><%= change.status %></span>
    </div>
  </div>

  <% if (isEmergency) { %>
    <div style="padding:10px 20px;background:rgba(220,38,38,0.06);border-bottom:1px solid rgba(220,38,38,0.15);color:#b91c1c;font-size:13px;">
      <strong>Emergency change</strong>: bypasses normal approval. Retrospective approval required before closure.
    </div>
  <% } %>

  <% if (needsPIR) { %>
    <div style="padding:10px 20px;background:rgba(202,138,4,0.08);border-bottom:1px solid rgba(202,138,4,0.2);color:#a16207;font-size:13px;">
      <strong>Post-implementation review required.</strong> This change has been implemented but not yet closed. Complete the PIR section below to close it.
      <% if (needsRetroApproval) { %>
        <br><strong>Retrospective approval also required</strong> for this emergency change before it can be closed.
      <% } %>
    </div>
  <% } %>

  <div class="panel-pad grid-2" style="border-bottom:1px solid var(--border);">
    <div><span class="label">Requester</span><div class="text-base"><%= change.requester_name || '-' %></div></div>
    <div><span class="label">Category</span><div class="text-base"><%= change.category ? categoryLabel(change.category) : '-' %></div></div>
    <div><span class="label">Created</span><div class="text-base mono meta"><%= change.created_at %></div></div>
    <div><span class="label">Status</span><div class="text-base" style="text-transform:capitalize;"><%= change.status %></div></div>
    <% if (change.submitted_at) { %><div><span class="label">Submitted</span><div class="text-base mono meta"><%= change.submitted_at %></div></div><% } %>
    <% if (change.approved_at) { %><div><span class="label">Approved</span><div class="text-base mono meta"><%= change.approved_at %></div></div><% } %>
    <% if (change.implemented_at) { %><div><span class="label">Implemented</span><div class="text-base mono meta"><%= change.implemented_at %></div></div><% } %>
    <% if (change.closed_at) { %><div><span class="label">Closed</span><div class="text-base mono meta"><%= change.closed_at %></div></div><% } %>
  </div>

  <form method="POST" action="/workspaces/<%= ws.id %>/changes/<%= change.id %>" class="panel-pad grid-2">
    <div class="col-full"><label class="label">Title</label><input class="input" name="title" value="<%= change.title %>" required <%= !editable ? 'readonly' : '' %>></div>
    <div><label class="label">Change type</label>
      <select class="select" name="change_type" <%= !editable ? 'disabled' : '' %>>
        <% ['normal','standard','emergency'].forEach(t => { %>
          <option value="<%= t %>" <%= change.change_type === t ? 'selected' : '' %>><%= t %></option>
        <% }) %>
      </select>
      <% if (!editable) { %><input type="hidden" name="change_type" value="<%= change.change_type %>"><% } %>
    </div>
    <div><label class="label">Category</label>
      <select class="select" name="category" <%= !editable ? 'disabled' : '' %>>
        <%- include('partials/register_category_options', { options: categories, selected: change.category || 'other' }) %>
      </select>
      <% if (!editable) { %><input type="hidden" name="category" value="<%= change.category %>"><% } %>
    </div>
    <div><label class="label">Risk level</label>
      <select class="select" name="risk_level" <%= !editable ? 'disabled' : '' %>>
        <% ['low','medium','high','critical'].forEach(r => { %>
          <option value="<%= r %>" <%= change.risk_level === r ? 'selected' : '' %>><%= r %></option>
        <% }) %>
      </select>
      <% if (!editable) { %><input type="hidden" name="risk_level" value="<%= change.risk_level %>"><% } %>
    </div>
    <div><label class="label">Requester</label><input class="input" name="requester_name" value="<%= change.requester_name || '' %>" <%= !editable ? 'readonly' : '' %>></div>
    <div class="col-full"><label class="label">Description</label><textarea class="textarea" name="description" rows="3" <%= !editable ? 'readonly' : '' %>><%= change.description || '' %></textarea></div>

    <div class="col-full" style="border-top:1px solid var(--border);padding-top:12px;">
      <div class="text-xs text-tertiary" style="font-weight:500;text-transform:uppercase;letter-spacing:0.04em;">Risk &amp; impact assessment</div>
    </div>
    <div class="col-full"><label class="label">Risk assessment</label><textarea class="textarea" name="risk_assessment" rows="2" <%= !editable ? 'readonly' : '' %>><%= change.risk_assessment || '' %></textarea></div>
    <div class="col-full"><label class="label">Impact assessment</label><textarea class="textarea" name="impact_assessment" rows="2" <%= !editable ? 'readonly' : '' %>><%= change.impact_assessment || '' %></textarea></div>
    <div class="col-full"><label class="label">Rollback plan</label><textarea class="textarea" name="rollback_plan" rows="2" <%= !editable ? 'readonly' : '' %>><%= change.rollback_plan || '' %></textarea></div>

    <% if (isApproved || isImplemented || isClosed) { %>
      <div class="col-full" style="border-top:1px solid var(--border);padding-top:12px;">
        <div class="text-xs text-tertiary" style="font-weight:500;text-transform:uppercase;letter-spacing:0.04em;">Implementation</div>
      </div>
      <div class="col-full"><label class="label">Implementation notes</label><textarea class="textarea" name="implementation_notes" rows="3" <%= isClosed ? 'readonly' : '' %>><%= change.implementation_notes || '' %></textarea></div>
      <div class="col-full"><label class="label">Test results</label><textarea class="textarea" name="test_results" rows="2" <%= isClosed ? 'readonly' : '' %>><%= change.test_results || '' %></textarea></div>
    <% } %>

    <div class="col-full row" style="gap:8px;">
      <% if (editable || isApproved || isImplemented) { %>
        <button class="btn btn-primary">Save</button>
      <% } %>
      <% if (isDraft) { %>
        <button formaction="/workspaces/<%= ws.id %>/changes/<%= change.id %>/submit" class="btn btn-secondary" onclick="return confirm('Submit this change for approval?')">Submit for approval</button>
        <% if (isEmergency) { %>
          <button formaction="/workspaces/<%= ws.id %>/changes/<%= change.id %>/implement" class="btn btn-danger" onclick="return confirm('Implement this emergency change without approval?')">Emergency implement</button>
        <% } %>
      <% } %>
      <% if (editable) { %>
        <form method="POST" action="/workspaces/<%= ws.id %>/changes/<%= change.id %>/delete" onsubmit="return appConfirmForm(event, 'Delete this change request?')" style="display:inline">
          <button class="btn btn-danger">Delete</button>
        </form>
      <% } %>
    </div>
  </form>
</div>

<div class="panel" style="margin-top:14px">
  <div class="panel-head"><h2>Approvals</h2><span class="meta">Change advisory board / designated approvers</span></div>
  <% if (approvals.length > 0) { %>
    <table class="t">
      <thead><tr>
        <th>Approver</th><th style="width:100px">Decision</th><th>Reason</th><th style="width:160px">Date</th>
      </tr></thead>
      <tbody>
        <% approvals.forEach(a => { %>
          <tr>
            <td style="font-weight:500;"><%= a.approver_name %></td>
            <td><span class="tag <%= a.decision === 'approved' ? 'tag-ok' : a.decision === 'rejected' ? 'tag-danger' : 'tag-neutral' %>"><%= a.decision || 'pending' %></span></td>
            <td class="text-secondary"><%= a.reason || '-' %></td>
            <td class="mono meta"><%= a.decided_at || '-' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <div class="panel-pad"><span class="text-secondary text-base">No approvals recorded yet.</span></div>
  <% } %>

  <% if (isSubmitted || (isEmergency && isImplemented)) { %>
    <div class="panel-pad" style="border-top:1px solid var(--border);">
      <div style="display:flex;gap:12px;align-items:end;">
        <div style="flex:1;">
          <label class="label"><%= isEmergency && isImplemented ? 'Retrospective approval reason' : 'Approval reason' %> (optional)</label>
          <input class="input" form="approveForm" name="reason" placeholder="Reason for decision...">
        </div>
        <form id="approveForm" method="POST" action="/workspaces/<%= ws.id %>/changes/<%= change.id %>/approve" style="display:inline;">
          <button class="btn btn-primary" onclick="return confirm('Approve this change?')">Approve</button>
        </form>
        <% if (isSubmitted) { %>
          <form method="POST" action="/workspaces/<%= ws.id %>/changes/<%= change.id %>/reject" style="display:inline;">
            <input type="hidden" name="reason" id="rejectReason">
            <button class="btn btn-danger" onclick="var r=prompt('Reason for rejection?');if(!r)return false;document.getElementById('rejectReason').value=r;return confirm('Reject this change?')">Reject</button>
          </form>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

<% if (isApproved) { %>
<div class="panel" style="margin-top:14px">
  <div class="panel-head"><h2>Mark as implemented</h2><span class="meta">Record implementation details and mark complete</span></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/changes/<%= change.id %>/implement" class="panel-pad grid-2">
    <div class="col-full"><label class="label">Implementation notes</label><textarea class="textarea" name="implementation_notes" rows="3" placeholder="What was done, any deviations from plan..."><%= change.implementation_notes || '' %></textarea></div>
    <div class="col-full"><label class="label">Test results</label><textarea class="textarea" name="test_results" rows="2" placeholder="Results of post-change testing..."><%= change.test_results || '' %></textarea></div>
    <div class="col-full"><button class="btn btn-primary" onclick="return confirm('Mark this change as implemented?')">Mark as implemented</button></div>
  </form>
</div>
<% } %>

<% if (isImplemented) { %>
<div class="panel" style="margin-top:14px;border:2px solid rgba(202,138,4,0.3);">
  <div class="panel-head" style="background:rgba(202,138,4,0.06);"><h2>Post-implementation review (PIR)</h2><span class="meta">Required to close this change</span></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/changes/<%= change.id %>/close" class="panel-pad grid-2">
    <div class="col-full"><label class="label">Post-implementation review</label><textarea class="textarea" name="post_implementation_review" rows="4" required placeholder="Was the change successful? Any unexpected issues? Lessons learned?"><%= change.post_implementation_review || '' %></textarea></div>
    <div><label class="label">Was the change successful?</label>
      <select class="select" name="success" required>
        <option value="">-- select --</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
    </div>
    <div><label class="label">PIR date</label><input class="input" type="date" name="pir_date" value="<%= new Date().toISOString().split('T')[0] %>"></div>
    <div class="col-full">
      <% if (needsRetroApproval) { %>
        <div class="text-secondary text-base" style="margin-bottom:8px;color:#b91c1c;">Cannot close: retrospective approval is required for emergency changes. Use the approval section above first.</div>
        <button class="btn btn-secondary" disabled>Close with PIR (approval required)</button>
      <% } else { %>
        <button class="btn btn-primary" onclick="return confirm('Close this change with the PIR?')">Close with PIR</button>
      <% } %>
    </div>
  </form>
</div>
<% } %>

<% if (isClosed && change.post_implementation_review) { %>
<div class="panel" style="margin-top:14px">
  <div class="panel-head"><h2>Post-implementation review</h2><span class="meta">Completed <%= change.pir_date || '' %></span></div>
  <div class="panel-pad grid-2">
    <div class="col-full"><span class="label">Review</span><div class="text-base" style="white-space:pre-wrap;"><%= change.post_implementation_review %></div></div>
    <div><span class="label">Successful</span><div class="text-base"><span class="tag <%= change.success ? 'tag-ok' : 'tag-danger' %>"><%= change.success ? 'Yes' : 'No' %></span></div></div>
    <div><span class="label">PIR date</span><div class="text-base mono meta"><%= change.pir_date || '-' %></div></div>
  </div>
</div>
<% } %>

<%- include('partials/footer') %>
