<%- include('partials/header',{title:item.client_title || item.title,user,ws,active:'client-portal',portalView}) %>
<% const state = value => ({draft:'In preparation',submitted:'Under review',workspace_verified:'Ready for approval',accepted:'Approved',changes_requested:'Changes requested',rejected:'Not approved',superseded:'Replaced'}[value] || value); %>
<a class="link-muted" href="/workspaces/<%= ws.id %>/client-portal?view=actions">← Back to my actions</a>
<div class="page-head"><div><div class="eyebrow">Deliverable</div><h1><%= item.client_title || item.title %></h1><p class="page-subtitle"><%= item.client_description || 'Review the agreed requirements and provide supporting information.' %></p></div><span class="tag tag-neutral"><%= state(item.status) %></span></div>
<% if(decisionError){ %><div class="panel panel-pad" role="alert" style="margin-bottom:16px"><strong>Your response has not been recorded.</strong><p><%= decisionError %></p></div><% } %>
<section class="panel panel-pad" style="margin-bottom:16px"><h2>What completion requires</h2><p style="white-space:pre-wrap"><%= item.acceptance_criteria || item.client_description || 'Confirm the agreed outcome with your engagement team.' %></p><div class="grid-3"><div><span class="label">Owner</span><p><%= owner?.name || 'Needs assignment' %></p></div><div><span class="label">Approver</span><p><%= approver?.name || 'Needs assignment' %></p></div><div><span class="label">Due</span><p><%= item.due_date || 'To be agreed' %></p></div></div><% if (item.decision_note) { %><p><strong>Latest review:</strong> <%= item.decision_note %></p><% } %></section>
<section class="panel" style="margin-bottom:16px"><div class="panel-head"><h2>All supporting files</h2><span class="tag tag-neutral"><%= evidence.length %></span></div><% if (!evidence.length) { %><div class="panel-pad meta"><%= item.requires_evidence?'Add supporting evidence before submitting.':'No files have been shared.' %></div><% } %><% evidence.forEach(file=>{ %><article class="panel-pad" style="border-top:1px solid var(--border)"><a href="/workspaces/<%= ws.id %>/client-portal/deliverables/<%= item.id %>/evidence/<%= file.id %>/download"><strong><%= file.filename %></strong></a><p class="meta"><%= file.uploader || 'Engagement team' %> · <%= file.uploaded_at %></p><% if(file.description){ %><p><%= file.description %></p><% } %></article><% }) %>
<% if(policy.canRespond && !['accepted','superseded','rejected'].includes(item.status)){ %><form class="panel-pad" method="POST" enctype="multipart/form-data" action="/workspaces/<%= ws.id %>/client-portal/deliverables/<%= item.id %>/evidence"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="label" for="delivery-file">Supporting file · maximum 50 MB</label><input class="input" id="delivery-file" type="file" name="file" required><button class="btn btn-secondary" style="margin-top:8px">Add evidence</button></form><% } %></section>
<% if(policy.commands.length || decisionError){ %><section class="panel panel-pad" style="margin-bottom:16px"><h2><%= policy.commands.includes('accept')?'Review and decide':'Send for review' %></h2><p class="meta"><%= policy.commands.includes('accept')?'Review all supporting files and the completion criteria before recording your decision.':'Upload all supporting files, then submit this deliverable to the approver.' %></p><form method="POST" action="/workspaces/<%= ws.id %>/client-portal/deliverables/<%= item.id %>/<%= policy.commands.includes('accept')?'accept':'submit' %>" data-form-draft="deliverable-decision" data-draft-record="<%= item.id %>" data-draft-version="<%= item.row_version %>" <%- decisionError?'data-draft-recovery="true"':'' %>><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="row_version" value="<%= item.row_version %>"><label class="label" for="decision-note">Response or decision note</label><textarea class="textarea" id="decision-note" name="note" rows="3" maxlength="8000"><%= decisionNote %></textarea><div class="row" style="gap:8px;margin-top:12px"><% if(policy.commands.includes('accept')){ %><button class="btn btn-primary">Approve deliverable</button><button class="btn btn-secondary" formaction="/workspaces/<%= ws.id %>/client-portal/deliverables/<%= item.id %>/changes">Request changes</button><% }else if(policy.commands.includes('submit')){ %><button class="btn btn-primary" <%= item.requires_evidence && !evidence.length?'disabled':'' %>>Submit for review</button><% } %></div></form></section><% } %>
<section class="panel" id="discussion" style="margin-bottom:16px"><div class="panel-head"><h2>Discussion</h2></div><% comments.forEach(comment=>{ %><article class="panel-pad" style="border-bottom:1px solid var(--border)"><strong><%= comment.user_name %></strong><span class="meta"> · <%= comment.created_at %></span><p style="white-space:pre-wrap"><%= comment.body %></p></article><% }) %><form class="panel-pad" method="POST" action="/workspaces/<%= ws.id %>/client-portal/deliverables/<%= item.id %>/comments" data-form-draft="deliverable-comment" <%- decisionError?'data-draft-recovery="true"':'' %> data-draft-record="<%= item.id %>" data-draft-version="<%= item.row_version %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="label" for="delivery-comment">Message to the engagement team</label><textarea class="textarea" id="delivery-comment" name="body" rows="3" maxlength="8000" required><%= commentBody %></textarea><button class="btn btn-secondary" style="margin-top:8px">Post comment</button></form></section>
<section class="panel"><div class="panel-head"><h2>Delivery history</h2></div><% if(!events.length){ %><p class="panel-pad meta">Updates will appear here as this deliverable progresses.</p><% } %><% events.forEach(event=>{ %><div class="panel-pad" style="border-bottom:1px solid var(--border)"><strong><%= event.actor_name || 'Engagement team' %></strong> · <%= String(event.action).replaceAll('_',' ') %><% if(event.to_status){ %> · <%= state(event.to_status) %><% } %><p class="meta"><%= event.created_at %></p></div><% }) %></section>
<%- include('partials/footer') %>
