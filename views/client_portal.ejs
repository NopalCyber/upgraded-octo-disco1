<%- include('partials/header', { title, user, ws, active, clientPreview, clientPreviewUser, portalView }) %>

<%
  const label = s => String(s || '').replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
  const clientStatus = s => ({
    draft: 'In preparation', workspace_verified: 'Ready for approval', submitted: 'Under review',
    changes_requested: 'Changes requested', accepted: 'Approved', rejected: 'Not approved',
    superseded: 'Replaced', open: 'Open', in_progress: 'In progress', cancelled: 'Closed'
  }[String(s || '').toLowerCase()] || label(s));
  const clientDeliverableTitle = deliverable => deliverable?.client_title || 'Deliverable details being confirmed';
  const clientRequirement = deliverable => deliverable?.client_description || 'Provide this item for review and approval.';
  const frameworkLabel = code => ({ iso27001: 'ISO 27001' }[code] || label(code));
  const formatDate = value => {
    if (!value) return '-';
    const parsed = new Date(`${String(value).slice(0, 10)}T12:00:00`);
    return Number.isNaN(parsed.getTime()) ? String(value) : new Intl.DateTimeFormat(ws.locale || 'en-GB', {
      day: 'numeric', month: 'short', year: 'numeric'
    }).format(parsed);
  };
  const today = new Date().toISOString().slice(0, 10);
  const clientMode = user.user_type === 'client' || clientPreview;
  const portalActorId = clientPreviewUser?.id || user.id;
  const viewPath = (view, extra = '') => `/workspaces/${ws.id}/client-portal?view=${view}${clientPreview ? '&preview=client' : ''}${extra}`;
  const portalPath = viewPath('home');
  const activeRequestsPath = viewPath('actions', '&work_status=action_required');
  const submittedRequestsPath = viewPath('actions', '&work_status=waiting');
  let frameworks = Array.isArray(ws.frameworks) ? ws.frameworks : [];
  if (!Array.isArray(ws.frameworks)) { try { frameworks = JSON.parse(ws.frameworks || '[]'); } catch (_) { frameworks = []; } }
  const frameworkMeta = {
    iso27001: { code: 'ISO 27001', name: 'Information security management', tone: 'iso' }
  };
  const requestValues = requestForm?.values || {};
  const requestErrors = requestForm?.errors || {};
  const firstRequestError = Object.keys(requestErrors)[0] || '';
  const clientRole = clientPreviewUser?.role || ws.my_role || 'contributor';
  const homeCandidates = work.items.filter(item=>item.actionState==='action_required' || item.actionState==='blocked' && clientRole==='isms_manager');
  const homePriority = item => clientRole==='client_owner'
    ? (item.allowedCommands.some(command=>['approve','accept','client_decide'].includes(command))?0:item.overdue?1:2)
    : clientRole==='isms_manager' ? (!item.ownerId?0:item.actionState==='blocked'?1:item.overdue?2:3) : 0;
  const homeNext = [...homeCandidates].sort((a,b)=>homePriority(a)-homePriority(b))[0] || null;

  const requestSelected = (field, value, fallback = '') => String(requestValues[field] ?? fallback) === String(value);
%>

<div class="page-head cp-page-head">
  <div>
    <div class="eyebrow"><%= clientMode ? 'Client engagement' : 'Shared workspace' %></div>
    <h1><%= clientMode ? 'Your engagement' : 'Client collaboration' %></h1>
    <div class="page-subtitle"><%= clientMode ? 'See what your team needs to provide, review or approve.' : `Requests, evidence and decisions shared with ${ws.brand_display_name || ws.client_name}.` %></div>
    <% if (clientMode && frameworks.length) { %><div class="cp-framework-chips"><% frameworks.forEach(code => { const item = frameworkMeta[code]; if (item) { %><span><%= item.code %></span><% } }) %></div><% } %>
  </div>
  <% if (!clientMode) { %><span class="tag tag-neutral">Consultant view</span><% } %>
</div>

<% if (clientPreview) { %>
<div class="cp-preview-banner" role="status">
  <div><strong>Client view preview</strong><span>This is the client-facing experience. Preview mode is read-only and does not impersonate a client account.</span></div>
  <a class="btn btn-secondary btn-xs" href="/workspaces/<%= ws.id %>/engagement-plan">Exit preview</a>
</div>
<% } %>

<% if (clientMode && portalView === 'home') { %>
<section class="cp-client-home" aria-labelledby="client-home-title">
  <section class="panel panel-pad" id="client-next-action" aria-labelledby="client-home-title" style="margin-bottom:16px">
    <div class="eyebrow"><%= clientRole==='client_owner'?'Your next decision or action':clientRole==='isms_manager'?'Your next team priority':'Your next action' %></div>
    <% if(homeNext){ %>
      <h2 id="client-home-title" style="margin:8px 0"><%= homeNext.title %></h2>
      <p class="meta">Responsible: <strong><%= homeNext.ownerName || 'Client coordinator to assign' %></strong> · <%= homeNext.dueDate?'Due '+formatDate(homeNext.dueDate):'No due date agreed' %><%= homeNext.overdue?' · Overdue':'' %></p>
      <% if(homeNext.blockedReason){ %><p><%= homeNext.blockedReason %></p><% } %>
      <div class="row" style="gap:10px;flex-wrap:wrap;margin-top:14px"><a class="btn btn-primary" href="<%= clientPreview?viewPath('actions'):homeNext.href %>"><%= clientPreview?'Preview actions':homeNext.actionLabel %></a><a class="btn btn-secondary" href="<%= viewPath('actions') %>">All <%= work.counts.actionRequired %> actions</a></div>
    <% }else{ %>
      <h2 id="client-home-title" style="margin:8px 0"><%= work.counts.waiting?'Your work is waiting for the next review':'You are up to date' %></h2>
      <p class="meta"><%= work.counts.waiting?`${work.counts.waiting} item${work.counts.waiting===1?' is':'s are'} with the next responsible person.`:'New requests and decisions will appear here when shared with you.' %></p>
      <a class="btn btn-secondary" href="<%= viewPath('actions',work.counts.waiting?'&work_status=waiting':'&work_status=all') %>"><%= work.counts.waiting?'View waiting work':'View completed work' %></a>
    <% } %>
  </section>
  <div class="cp-home-week">
    <section class="panel"><h2>Next for your team</h2><% const nextItems=homeCandidates.filter(item=>item.id!==homeNext?.id).slice(0,3); if(!nextItems.length){ %><p class="meta">No other action is waiting for your team.</p><% } else { %><ul><% nextItems.forEach(item=>{ %><li><a href="<%= clientPreview?viewPath('actions'):item.href %>"><span><%= item.title %></span><small><%= item.dueDate?'Due '+formatDate(item.dueDate):item.actionLabel %></small></a></li><% }) %></ul><% } %><a href="<%= activeRequestsPath %>">View actions →</a></section>
    <section class="panel"><h2>Waiting on others</h2><p><strong><%= work.counts.waiting %></strong> <%= work.counts.waiting===1?'item is':'items are' %> waiting for review or a decision.</p><% work.items.filter(item=>item.actionState==='waiting').slice(0,2).forEach(item=>{ %><p class="meta"><%= item.title %> · <%= item.ownerName || item.waitingOn || 'Engagement team' %></p><% }) %><a href="<%= submittedRequestsPath %>">See waiting items →</a></section>
  </div>
  <div class="panel panel-pad" style="margin-top:16px"><strong><%= clientStatusSummary.label %></strong><p class="meta"><%= clientStatusSummary.message %></p><a href="<%= viewPath('progress') %>">View engagement progress →</a></div>

  <div class="cp-home-decisions">
    <a class="panel cp-home-decision <%= clientStatusSummary.actionCount ? 'has-attention' : '' %>" href="<%= viewPath('actions') %>"><span>For your team</span><strong><%= clientStatusSummary.actionCount %></strong><p><%= clientStatusSummary.actionCount === 1 ? 'item needs' : 'items need' %> action</p><b>Open →</b></a>
    <div class="panel cp-home-decision"><span>Waiting on others</span><strong><%= metrics.awaitingReview %></strong><p><%= metrics.awaitingReview === 1 ? 'item is' : 'items are' %> awaiting the next step</p></div>
    <% if (clientStatusSummary.blockerCount) { %><a class="panel cp-home-decision has-risk" href="<%= viewPath('progress') %>"><span>Needs attention</span><strong><%= clientStatusSummary.blockerCount %></strong><p>blockers or overdue items</p><b>Review →</b></a><% } else { %><div class="panel cp-home-decision"><span>Blocked work</span><strong><%= work.counts.blocked || 0 %></strong><p><%= work.counts.blocked?'items need a prerequisite to be resolved':'no blockers have been flagged' %></p></div><% } %>
  </div>

  <div class="cp-home-section-head"><div><h2>Your programmes</h2><p>Each programme reports its own assessment position. These percentages are not overall engagement completion.</p></div></div>
  <div class="cp-programme-grid cp-programme-grid-client">
    <% clientProgrammes.forEach(programme => { %>
      <a class="cp-programme-card cp-programme-link" href="<%= viewPath('progress') %>#programme-<%= programme.key %>" aria-label="View <%= programme.short %> programme details">
        <div class="cp-programme-heading"><span><%= programme.short %></span><em class="status status-neutral"><%= programme.status %></em></div>
        <h3><%= programme.descriptor %></h3>
        <div class="cp-programme-measure"><strong><%= programme.completionPct %>%</strong><span>assessment coverage</span></div>
        <div class="cp-progress-track" role="progressbar" aria-label="<%= programme.short %> assessment coverage" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= programme.completionPct %>"><span class="<%= programme.completionPct === 0 ? 'is-zero' : '' %>" style="width:<%= programme.completionPct %>%"></span></div>
        <dl><div><dt>Current position</dt><dd><%= programme.currentLabel %></dd></div><div><dt>Open items</dt><dd><%= programme.openItems %></dd></div></dl>
        <span class="cp-programme-card-action">View programme <b aria-hidden="true">→</b></span>
      </a>
    <% }) %>
  </div>


</section>
<% } %>

<% if (!clientMode && !metrics.allZero) { %>
<div class="grid-4 cp-kpis" style="margin-bottom:16px;">
  <a class="panel kpi cp-kpi-link" href="<%= activeRequestsPath %>" aria-label="Open <%= metrics.activeRequests %> active requests"><span class="cp-kpi-arrow" aria-hidden="true">→</span><div class="kpi-label">Open requests</div><div class="kpi-num"><%= metrics.activeRequests %></div><div class="kpi-meta">Requests awaiting completion</div></a>
  <a class="panel kpi cp-kpi-link" href="<%= portalPath %>#engagement" aria-label="Open <%= metrics.deliverablesToProvide %> deliverables to provide"><span class="cp-kpi-arrow" aria-hidden="true">→</span><div class="kpi-label">Deliverables to provide</div><div class="kpi-num"><%= metrics.deliverablesToProvide %></div><div class="kpi-meta">Evidence or information required</div></a>
  <a class="panel kpi cp-kpi-link <%= metrics.overdue ? 'kpi-bad' : '' %>" href="<%= metrics.overdueRequests ? activeRequestsPath : `${portalPath}#engagement` %>" aria-label="Open <%= metrics.overdue %> overdue items"><span class="cp-kpi-arrow" aria-hidden="true">→</span><div class="kpi-label">Overdue items</div><div class="kpi-num"><%= metrics.overdue %></div><div class="kpi-meta">Requests and deliverables past due</div></a>
  <a class="panel kpi cp-kpi-link <%= metrics.awaitingReview ? 'kpi-warn' : '' %>" href="<%= metrics.awaitingReviewRequests ? submittedRequestsPath : `${portalPath}#engagement` %>" aria-label="Open <%= metrics.awaitingReview %> items awaiting review"><span class="cp-kpi-arrow" aria-hidden="true">→</span><div class="kpi-label">Awaiting review</div><div class="kpi-num"><%= metrics.awaitingReview %></div><div class="kpi-meta">Submitted to the engagement team</div></a>
</div>
<% } %>

<div class="cp-portal-view" <%= portalView === 'progress' || !clientMode ? '' : 'hidden' %>>
<%- include('partials/client_gap_assessment', { gapAssessment, ws, clientPreview, formatDate, label }) %>


<section class="cp-section" id="engagement-progress">
  <% if (!clientMode || frameworks.includes('iso27001')) { %>
  <div class="cp-section-heading"><div><span>Engagement</span><h2>Engagement progress</h2><p>Progress updates when agreed work is reviewed and approved.</p></div><div class="cp-section-stat"><strong><%= deliverySummary.progressPct %>%</strong><span><%= deliverySummary.accepted %> of <%= deliverySummary.total %> approved</span></div></div>
  <div class="panel cp-engagement-card">
    <div class="cp-engagement-progress"><div><span>Current phase</span><strong><%= deliverySummary.currentPhase %></strong></div><div class="cp-progress-track" role="progressbar" aria-label="Engagement progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= deliverySummary.progressPct %>" aria-valuetext="<%= deliverySummary.progressPct %>% complete"><span class="<%= deliverySummary.progressPct === 0 ? 'is-zero' : '' %>" style="width:<%= deliverySummary.progressPct %>%"></span></div></div>
    <div class="cp-engagement-facts">
      <div><span>Next deliverable</span><strong><%= clientMode && !frameworks.includes('iso27001') ? (work.nextAction?.title || 'No action waiting for your team') : deliverySummary.nextTitle || 'No outstanding deliverable' %></strong><small><%= deliverySummary.nextDue ? `Due ${formatDate(deliverySummary.nextDue)}` : 'No date set' %></small></div>
      <div><span>Target completion</span><strong><%= deliverySummary.targetDate ? formatDate(deliverySummary.targetDate) : 'To be agreed' %></strong><small>Agreed with your engagement team</small></div>
    </div>
  </div>

  <% } %>
  <% if (clientProgrammes.length) { %><div class="cp-programme-grid">
    <% clientProgrammes.forEach(programme => { %>
      <article class="cp-programme-card cp-programme-detail" id="programme-<%= programme.key %>">
        <div class="cp-programme-heading"><span><%= programme.short %></span><em class="status status-neutral"><%= programme.status %></em></div>
        <h3><%= programme.descriptor %></h3>
        <dl class="cp-programme-detail-facts">
          <div><dt>Assessment coverage</dt><dd><%= programme.completionPct %>%</dd><small><%= programme.assessmentDetail %></small></div>
          <div><dt>Current position</dt><dd><%= programme.currentLabel %></dd><small><%= programme.currentDetail %></small></div>
          <div><dt>Open items</dt><dd><%= programme.openItems %></dd><small><%= programme.unsupportedImplemented ? `${programme.unsupportedImplemented} claimed Implemented without linked evidence` : 'Requirements needing assessment, evidence or remediation' %></small></div>
        </dl>
      </article>
    <% }) %>
  </div><% } %>

</section>
</div>

<div class="cp-portal-view" <%= portalView === 'actions' || !clientMode ? '' : 'hidden' %>>
<% if(clientMode){ %><%- include('partials/client_action_list',{ws,user,work,workScope,workFilter,workQuery,clientPreview,canManage,viewPath,formatDate,label}) %><% } %>
<% if(!clientMode){ %>
<% if (clientMode) { %><div class="cp-action-summary"><a class="panel" href="<%= activeRequestsPath %>"><span>Open requests</span><strong><%= metrics.activeRequests %></strong><small>Information or evidence requested</small></a><a class="panel" href="#engagement"><span>Deliverables to provide</span><strong><%= metrics.deliverablesToProvide %></strong><small>Agreed outputs assigned to your team</small></a><a class="panel <%= metrics.overdue ? 'has-risk' : '' %>" href="#engagement"><span>Overdue items</span><strong><%= metrics.overdue %></strong><small>Past the agreed due date</small></a><a class="panel" href="#approvals"><span>Awaiting review</span><strong><%= metrics.awaitingReview %></strong><small>With the engagement team</small></a></div><% } %>
<section class="cp-section" id="engagement">
  <div class="cp-section-heading"><div><span>Agreed work</span><h2>Deliverables and approvals</h2><p>Provide supporting information, submit completed work and track formal sign-off.</p></div></div>

  <details class="panel cp-delivery-disclosure" <%= !clientMode && deliveryWork.some(d => !['accepted','superseded'].includes(d.status)) ? 'open' : '' %>>
    <summary class="panel-head"><div><h2>Your deliverables</h2><div class="meta">Review what’s required, provide supporting evidence and track formal sign-off.</div></div><span class="cp-summary-meta"><span class="tag tag-neutral"><%= deliveryWork.length %></span><span class="cp-chevron">⌄</span></span></summary>
    <% if (!deliveryPlan || !deliveryWork.length) { %><div class="panel-pad meta">No deliverables have been shared with you yet.</div><% } else { %>
      <div style="overflow-x:auto;"><table class="t cp-deliverables-table"><thead><tr><th scope="col">Deliverable</th><th scope="col">Framework / requirements</th><th scope="col">Assigned to / approved by</th><th scope="col">Due</th><th scope="col">Evidence</th><th scope="col">Status</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead><tbody>
      <% deliveryWork.forEach(d => { const files = deliveryEvidence.filter(e=>e.deliverable_id===d.id); const notes = deliveryComments.filter(c=>String(c.parent_id)===String(d.id)); const overdue = d.due_date && d.due_date < today && !['accepted','superseded'].includes(d.status); %>
        <tr><td data-label="Deliverable"><strong><%= clientDeliverableTitle(d) %></strong><div class="meta"><%= clientRequirement(d) %></div><% notes.slice(-1).forEach(c=>{ %><div class="meta" style="margin-top:4px;"><strong><%= c.user_name %>:</strong> <%= c.body %></div><% }) %></td>
        <td data-label="Programme"><strong><%= frameworkLabel(d.framework_code) %></strong><div class="meta"><%= d.requirement_refs ? `Requirements ${d.requirement_refs}` : 'No specific requirement' %></div></td>
        <td data-label="Owner"><%= d.owner_name || 'Unassigned' %><div class="meta">Approver: <%= d.approver_name || 'Unassigned' %></div></td>
        <td data-label="Due" class="cp-date-cell <%= overdue?'text-danger':'' %>"><%= formatDate(d.due_date) %><% if(overdue){ %><div class="meta text-danger">Overdue</div><% } %></td>
        <td data-label="Evidence"><strong><%= files.length %></strong><% files.slice(0,2).forEach(e=>{ %><div><a class="text-xs" href="/workspaces/<%= ws.id %>/client-portal/deliverables/<%= d.id %>/evidence/<%= e.id %>/download"><%= e.filename %></a></div><% }) %></td>
        <td data-label="Status"><span class="status status-<%= d.status==='accepted'?'good':d.status==='changes_requested'||d.status==='rejected'?'bad':d.status==='submitted'?'warn':'neutral' %>"><%= clientStatus(d.effective_status || d.status) %></span></td>
        <td data-label="Actions"><a class="btn btn-secondary btn-xs" href="/workspaces/<%= ws.id %>/client-portal/deliverables/<%= d.id %>">Review deliverable</a></td></tr>
      <% }) %></tbody></table></div>
    <% } %>
  </details>
</section>
<section class="cp-section" id="requests">
  <div class="cp-section-heading"><div><span>Requests</span><h2>Information and evidence requests</h2><p>Each request states what is needed, when it is due and what counts as complete.</p></div></div>
  <% if (canCreate && !clientMode) { %><details class="panel cp-create-request" id="new-request" <%= requests.length === 0 || requestForm?.hasErrors ? 'open' : '' %>><summary class="panel-head"><div><h2>Create a client request</h2><div class="meta">Assign a precise outcome, due date and related record.</div></div><span class="btn btn-primary btn-xs">+ New request</span></summary>
    <form method="POST" action="/workspaces/<%= ws.id %>/client-portal/requests" class="panel-pad" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (requestForm?.hasErrors) { %><div role="alert" tabindex="-1" style="margin-bottom:14px;padding:11px 13px;border:1px solid #dc2626;border-radius:6px;color:#991b1b;background:#fef2f2;"><strong>Check the highlighted fields.</strong><ul style="margin:6px 0 0;padding-left:18px;"><% Object.values(requestErrors).forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %>
      <div class="cp-request-form-grid">
        <div><label class="label" for="request-type">Type</label><select id="request-type" class="select <%= requestErrors.request_type ? 'field-invalid' : '' %>" name="request_type" required aria-invalid="<%= requestErrors.request_type ? 'true' : 'false' %>" <%- requestErrors.request_type ? 'aria-describedby="request-type-error"' : '' %> <%= firstRequestError === 'request_type' ? 'autofocus' : '' %>><option value="evidence" <%= requestSelected('request_type','evidence','evidence') ? 'selected' : '' %>>Evidence</option><option value="policy" <%= requestSelected('request_type','policy') ? 'selected' : '' %>>Policy review</option><option value="control" <%= requestSelected('request_type','control') ? 'selected' : '' %>>Control response</option><option value="action" <%= requestSelected('request_type','action') ? 'selected' : '' %>>Action</option></select><% if (requestErrors.request_type) { %><span id="request-type-error" class="field-error-message"><%= requestErrors.request_type %></span><% } %></div>
        <div><label class="label" for="request-priority">Priority</label><select id="request-priority" class="select <%= requestErrors.priority ? 'field-invalid' : '' %>" name="priority" aria-invalid="<%= requestErrors.priority ? 'true' : 'false' %>" <%- requestErrors.priority ? 'aria-describedby="request-priority-error"' : '' %> <%= firstRequestError === 'priority' ? 'autofocus' : '' %>><option value="normal" <%= requestSelected('priority','normal','normal') ? 'selected' : '' %>>Normal</option><option value="high" <%= requestSelected('priority','high') ? 'selected' : '' %>>High</option><option value="urgent" <%= requestSelected('priority','urgent') ? 'selected' : '' %>>Urgent</option><option value="low" <%= requestSelected('priority','low') ? 'selected' : '' %>>Low</option></select><% if (requestErrors.priority) { %><span id="request-priority-error" class="field-error-message"><%= requestErrors.priority %></span><% } %></div>
        <div><label class="label" for="request-assignee">Assignee</label><select id="request-assignee" class="select <%= requestErrors.assignee_id ? 'field-invalid' : '' %>" name="assignee_id" aria-invalid="<%= requestErrors.assignee_id ? 'true' : 'false' %>" <%- requestErrors.assignee_id ? 'aria-describedby="request-assignee-error"' : '' %> <%= firstRequestError === 'assignee_id' ? 'autofocus' : '' %>><option value="">Unassigned</option><% members.forEach(m => { %><option value="<%= m.id %>" <%= requestSelected('assignee_id',m.id) ? 'selected' : '' %>><%= m.name %></option><% }) %></select><% if (requestErrors.assignee_id) { %><span id="request-assignee-error" class="field-error-message"><%= requestErrors.assignee_id %></span><% } %></div>
        <div><label class="label" for="request-due-date">Due date</label><input id="request-due-date" class="input <%= requestErrors.due_date ? 'field-invalid' : '' %>" type="date" name="due_date" value="<%= requestValues.due_date || '' %>" aria-invalid="<%= requestErrors.due_date ? 'true' : 'false' %>" <%- requestErrors.due_date ? 'aria-describedby="request-due-date-error"' : '' %> <%= firstRequestError === 'due_date' ? 'autofocus' : '' %>><% if (requestErrors.due_date) { %><span id="request-due-date-error" class="field-error-message"><%= requestErrors.due_date %></span><% } %></div>
      </div>
      <div class="cp-request-form-grid cp-request-form-grid-2">
        <div><label class="label" for="request-control">Related control or clause</label><select id="request-control" class="select <%= requestErrors.control_id ? 'field-invalid' : '' %>" name="control_id" aria-invalid="<%= requestErrors.control_id ? 'true' : 'false' %>" <%- requestErrors.control_id ? 'aria-describedby="request-control-error"' : '' %> <%= firstRequestError === 'control_id' ? 'autofocus' : '' %>><option value="">None</option><% controls.forEach(c => { %><option value="<%= c.id %>" <%= requestSelected('control_id',c.id) ? 'selected' : '' %>><%= c.id.replace('annex-','').replace('clause-','').toUpperCase() %> · <%= c.title %></option><% }) %></select><% if (requestErrors.control_id) { %><span id="request-control-error" class="field-error-message"><%= requestErrors.control_id %></span><% } %></div>
        <div><label class="label" for="request-document">Related policy</label><select id="request-document" class="select <%= requestErrors.document_id ? 'field-invalid' : '' %>" name="document_id" aria-invalid="<%= requestErrors.document_id ? 'true' : 'false' %>" <%- requestErrors.document_id ? 'aria-describedby="request-document-error"' : '' %> <%= firstRequestError === 'document_id' ? 'autofocus' : '' %>><option value="">None</option><% documents.forEach(d => { %><option value="<%= d.id %>" <%= requestSelected('document_id',d.id) ? 'selected' : '' %>><%= d.name %> · <%= label(d.status) %></option><% }) %></select><% if (requestErrors.document_id) { %><span id="request-document-error" class="field-error-message"><%= requestErrors.document_id %></span><% } %></div>
      </div>
      <div><label class="label" for="request-title">Request title</label><input id="request-title" class="input <%= requestErrors.title ? 'field-invalid' : '' %>" name="title" maxlength="180" required value="<%= requestValues.title || '' %>" aria-invalid="<%= requestErrors.title ? 'true' : 'false' %>" <%- requestErrors.title ? 'aria-describedby="request-title-error"' : '' %> <%= firstRequestError === 'title' ? 'autofocus' : '' %>><% if (requestErrors.title) { %><span id="request-title-error" class="field-error-message"><%= requestErrors.title %></span><% } %></div>
      <div><label class="label" for="request-description">Acceptance criteria and context</label><textarea id="request-description" class="textarea <%= requestErrors.description ? 'field-invalid' : '' %>" name="description" rows="4" maxlength="12000" aria-invalid="<%= requestErrors.description ? 'true' : 'false' %>" <%- requestErrors.description ? 'aria-describedby="request-description-error"' : '' %> <%= firstRequestError === 'description' ? 'autofocus' : '' %>><%= requestValues.description || '' %></textarea><% if (requestErrors.description) { %><span id="request-description-error" class="field-error-message"><%= requestErrors.description %></span><% } %></div>
      <div class="cp-form-submit"><button class="btn btn-primary">Create request</button></div>
    </form>
  </details><% } %>
  <div class="panel">
    <div class="panel-head"><div><h2>Your requests</h2><div class="meta">Requests shared with your team appear here.</div></div><form method="GET" action="/workspaces/<%= ws.id %>/client-portal" class="cp-filter-form"><input type="hidden" name="view" value="actions"><% if (clientPreview) { %><input type="hidden" name="preview" value="client"><% } %><label for="request-status">Show</label><select id="request-status" class="select text-sm" name="status"><% [['active','Active'],['open','Open'],['in_progress','In progress'],['submitted','Under review'],['changes_requested','Changes requested'],['closed','Closed']].forEach(o => { %><option value="<%= o[0] %>" <%= status === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select><button class="btn btn-secondary btn-xs">Apply</button></form></div>
    <% if (!requests.length) { %><div class="panel-pad"><div class="empty-title">No matching requests</div><div class="empty-sub">No requests match this view.</div></div><% } else { %><div style="overflow-x:auto;"><table class="t"><thead><tr><th scope="col">Request</th><th scope="col">Assigned to</th><th scope="col">Due</th><th scope="col">Status</th><th scope="col">Updates</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead><tbody><% requests.forEach(r => { const overdue = r.due_date && r.due_date < today && !['accepted','cancelled'].includes(r.status); %><tr><td><% if (clientPreview) { %><strong><%= r.title %></strong><% } else { %><a href="/workspaces/<%= ws.id %>/client-portal/requests/<%= r.id %>" class="cp-request-link"><%= r.title %></a><% } %><div class="meta"><%= label(r.request_type) %> · <%= label(r.priority) %><% if (r.document_name) { %> · <%= r.document_name %><% } %></div></td><td><%= r.assignee_name || 'Unassigned' %><div class="meta">Requested by <%= r.creator_name %></div></td><td class="cp-date-cell <%= overdue ? 'text-danger' : '' %>"><%= formatDate(r.due_date) %><% if (overdue) { %><div class="meta text-danger">Overdue</div><% } %></td><td><span class="status status-<%= r.status === 'accepted' ? 'good' : r.status === 'changes_requested' ? 'bad' : r.status === 'submitted' ? 'warn' : 'neutral' %>"><%= clientStatus(r.status) %></span></td><td class="meta"><%= r.evidence_count %> file<%= r.evidence_count === 1 ? '' : 's' %> · <%= r.comment_count %> comment<%= r.comment_count === 1 ? '' : 's' %></td><td><% if (clientPreview) { %><span class="tag tag-neutral">Preview only</span><% } else { %><a class="btn btn-secondary btn-xs" href="/workspaces/<%= ws.id %>/client-portal/requests/<%= r.id %>">Open</a><% } %></td></tr><% }) %></tbody></table></div><% } %>
  </div>
</section>

<section class="cp-section" id="approvals">
  <div class="cp-section-heading"><div><span>Approvals</span><h2>Reviews and approvals</h2><p>Review the policies and documents that need your approval.</p></div><div class="cp-section-stat"><strong><%= pendingApprovals.length %></strong><span>awaiting action</span></div></div>
  <div class="panel"><div class="panel-head"><div><h2>Policies awaiting approval</h2><div class="meta">Policies and documents waiting for your approval.</div></div><span class="tag tag-neutral"><%= pendingApprovals.length %></span></div><% if (!pendingApprovals.length) { %><div class="panel-pad meta">No policy approvals are assigned to you.</div><% } else { pendingApprovals.forEach(a => { %><a class="cp-simple-row" href="/workspaces/<%= ws.id %>/client-portal/policies/<%= a.document_id %>"><div><strong><%= a.name %></strong><small>Version <%= a.version %></small></div><span>Review →</span></a><% }) } %></div>
</section>
<% } %>
</div>

<div class="cp-portal-view" <%= portalView === 'home' || !clientMode ? '' : 'hidden' %>>
<section class="cp-section" id="team-help">
  <div class="cp-section-heading"><div><span>Team & help</span><h2>Your engagement contacts</h2><p>Contact the engagement team or see who from your organisation can use this portal.</p></div></div>
  <div class="cp-team-grid">
    <div class="panel cp-lead-card"><span>Engagement contact</span><div class="cp-avatar"><%= (consultantContact?.display_name || 'E').slice(0,1).toUpperCase() %></div><h3><%= consultantContact?.display_name || 'Engagement team' %></h3><p>Your primary contact for requests, supporting evidence, deadlines and approvals.</p><% if (consultantContact?.display_email) { %><a class="btn btn-primary" href="mailto:<%= consultantContact.display_email %>">Email <%= consultantContact.display_name %></a><% } %></div>
    <div class="panel"><div class="panel-head"><div><h2>Client participants</h2><div class="meta">People with access to this engagement.</div></div><span class="tag tag-neutral"><%= members.length %></span></div><% if (!members.length) { %><div class="panel-pad meta">No client participants are listed.</div><% } else { %><div class="cp-member-list"><% members.forEach(member => { %><div><span class="cp-member-avatar"><%= member.name.slice(0,1).toUpperCase() %></span><p><strong><%= member.name %></strong><small><%= member.email %></small></p></div><% }) %></div><% } %></div>
  </div>
</section>

<section class="panel cp-activity-panel"><div class="panel-head"><div><h2>Recent updates</h2><div class="meta">Latest updates to your requests.</div></div></div><% if (!recentEvents.length) { %><div class="panel-pad meta">Updates appear here as requests are created, discussed, submitted and approved.</div><% } else { recentEvents.forEach(e => { %><div class="cp-activity-row"><div><strong><%= e.actor_name %></strong> · <%= label(e.event_type) %></div><span><%= e.request_title %> · <%= formatDate(e.created_at) %></span></div><% }) } %></section>
</div>

<%- include('partials/footer') %>
