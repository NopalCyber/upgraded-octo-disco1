<%- include('partials/header', { title, user, ws, active, portalView:'actions' }) %>
<%
  const label = s => String(s || '').replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
%>
<a class="link-muted text-base" href="/workspaces/<%= ws.id %>/client-portal?view=actions">← Back to my actions</a>
<div class="page-head" style="margin-top:10px;"><div><div class="eyebrow">Policy review</div><h1><%= doc.name %></h1><div class="page-subtitle">Version <%= currentVersion ? currentVersion.version : doc.version %> · <%= label(doc.status) %><% if (doc.approved_at) { %> · Approved <%= doc.approved_at %><% } %></div></div><span class="status status-<%= doc.status === 'approved' || doc.status === 'published' ? 'good' : doc.status === 'in_review' ? 'warn' : 'neutral' %>"><%= label(doc.status) %></span></div>

<% if(decisionError){ %><div class="panel panel-pad" role="alert" style="margin-bottom:14px"><strong>Your decision has not been recorded.</strong><p><%= decisionError %></p></div><% } %>
<% if(decisionError && !isMyTurn && decisionReason){ %><div class="panel panel-pad"><label class="label" for="retained-policy-note">Your retained decision note</label><textarea class="textarea" id="retained-policy-note" readonly rows="4"><%= decisionReason %></textarea></div><% } %>
<% if (myApproval) { %><div class="panel" style="margin-bottom:14px;background:var(--bg-subtle);"><div class="panel-head"><div><h2><%= isMyTurn ? 'Your decision is required' : 'This policy will be available when the previous approval is complete' %></h2><div class="meta">You are approval step <%= myApproval.sequence %><%= myApproval.role_label ? ' · ' + myApproval.role_label : '' %></div></div></div><% if (isMyTurn) { %><form method="POST" action="/workspaces/<%= ws.id %>/documents/<%= doc.id %>/decide" class="panel-pad" data-form-draft="policy-decision" data-draft-record="<%= doc.id %>" data-draft-version="<%= doc.current_version_id %>" data-draft-context="<%= doc.current_version_id %>" <%- decisionError?'data-draft-recovery="true"':'' %>><input type="hidden" name="expected_version_id" value="<%= doc.current_version_id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="label" for="policy-decision-note">Decision note · required when requesting changes</label><textarea class="textarea" id="policy-decision-note" name="reason" rows="3" maxlength="4000" required placeholder="Explain what must change if you request changes"><%= decisionReason %></textarea><div style="display:flex;justify-content:flex-end;gap:8px;margin-top:8px;"><button class="btn btn-secondary" name="decision" value="reject">Request changes</button><button class="btn btn-primary" name="decision" value="approve" formnovalidate>Approve and sign</button></div></form><% } %></div><% } %>

<div class="grid-2" style="align-items:start;">
  <div class="panel"><div class="panel-head"><h2>Policy for review</h2><span class="meta">Review copy</span></div><article class="panel-pad doc-content" style="line-height:1.65;"><%- doc.content || '<p>No content recorded.</p>' %></article></div>
  <div>
    <div class="panel" style="margin-bottom:14px;"><div class="panel-head"><h2>Approval progress</h2></div><% if (!approvers.length) { %><div class="panel-pad meta">No approvers have been added yet.</div><% } else { approvers.forEach(a => { %><div style="padding:10px 14px;border-bottom:1px solid var(--border);"><div><strong><%= a.sequence %>. <%= a.person_name %></strong></div><div class="meta"><%= a.role_label || 'Approver' %> · <%= a.decision ? label(a.decision) : 'Pending' %></div></div><% }) } %></div>
    <div class="panel" id="discussion"><div class="panel-head"><h2>Policy discussion</h2><span class="tag tag-neutral"><%= comments.length %></span></div><% if (!comments.length) { %><div class="panel-pad meta">No comments yet.</div><% } else { comments.forEach(c => { %><div style="padding:10px 14px;border-bottom:1px solid var(--border);"><div style="display:flex;justify-content:space-between;"><strong class="text-sm"><%= c.user_name %></strong><span class="meta"><%= c.created_at %></span></div><div style="white-space:pre-wrap;line-height:1.55;margin-top:4px;"><%= c.body %></div></div><% }) } %><form method="POST" action="/workspaces/<%= ws.id %>/client-portal/policies/<%= doc.id %>/comments" class="panel-pad" style="border-top:1px solid var(--border);"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="label" for="policy-comment">Message to the engagement team</label><textarea class="textarea" id="policy-comment" name="body" rows="3" maxlength="8000" required placeholder="Ask a question or record review feedback."></textarea><div style="text-align:right;margin-top:8px;"><button class="btn btn-primary btn-xs">Post comment</button></div></form></div>
  </div>
</div>
<%- include('partials/footer') %>
