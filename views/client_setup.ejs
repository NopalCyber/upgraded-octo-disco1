<%- include('partials/header', { title: 'Client setup', user, ws, active: 'setup' }) %>

<style>
  @media (max-width: 600px) {
    .client-setup-head-actions {
      align-items: stretch;
      flex-direction: column;
      width: 100%;
    }
    .client-setup-head-actions .btn { width: 100%; justify-content: center; }
    .client-setup-module-options { grid-template-columns: 1fr !important; }
    .client-setup-enable-row {
      align-items: stretch !important;
      flex-direction: column;
    }
    .client-setup-enable-row .btn { width: 100%; justify-content: center; }
  }
</style>

<div class="page-head">
  <div>
    <h1 class="page-title">Client setup</h1>
    <div class="page-subtitle">
      <% if (setup.done) { %>
        Every programme and module on this engagement is scoped.
      <% } else { %>
        <%= setup.outstanding %> of <%= setup.total %> step<%= setup.total === 1 ? '' : 's' %> still to complete. Each programme is scoped on its own terms, in any order.
      <% } %>
    </div>
  </div>
  <div class="row client-setup-head-actions">
    <a class="btn btn-secondary" href="/workspaces/<%= ws.id %>?skipSetupRedirect=1">Open the client overview</a>
    <% if (setup.nextStep) { %>
      <a class="btn btn-primary" href="<%= setup.nextStep.href %>">Start with <%= setup.nextStep.programme %></a>
    <% } %>
  </div>
</div>

<% if (typeof isoContract !== 'undefined' && isoContract) { %>
  <section class="panel panel-pad" id="iso-contract-settings" style="margin-bottom:18px;">
    <h2>Contracted <%= isoContract.label %> outcome</h2>
    <p class="meta">The contracted endpoint governs the shared engagement plan. Expanding a gap assessment to certification support preserves the completed assessment and is a one-way change.</p>
    <% if (typeof canUpdateWorkspace !== 'undefined' && canUpdateWorkspace) { %>
      <form method="POST" action="/workspaces/<%= ws.id %>/frameworks" id="iso-contract-form">
        <% (Array.isArray(ws.frameworks) ? ws.frameworks : []).forEach(code => { %><input type="hidden" name="frameworks" value="<%= code %>"><% }) %>
        <% if (isoContract.outcome === 'gap_assessment_only') { %>
          <label class="label" for="setup-iso-outcome">Contracted outcome</label>
          <select class="select" id="setup-iso-outcome" name="engagement_outcome">
            <% isoContract.options.forEach(option => { %><option value="<%= option.value %>" <%= isoContract.outcome === option.value ? 'selected' : '' %>><%= option.label %></option><% }) %>
          </select>
          <label id="setup-iso-upgrade-confirmation" hidden style="margin:12px 0;"><input type="checkbox" name="confirm_outcome_upgrade" value="1"> I confirm the one-way change to full certification support.</label>
        <% } else { %>
          <input type="hidden" name="engagement_outcome" value="certification_support">
          <p><strong>Full certification support</strong> · implementation, documentation, internal audit, management review, Stage 1 and Stage 2 support.</p>
        <% } %>
        <div id="setup-iso-target" <%= isoContract.outcome === 'gap_assessment_only' ? 'hidden' : '' %> style="margin:12px 0;max-width:320px;">
          <label class="label" for="setup-iso-target-date">Target certification date</label>
          <input class="input" id="setup-iso-target-date" type="date" name="target_cert_date" value="<%= ws.target_cert_date || '' %>" <%= isoContract.outcome === 'gap_assessment_only' ? 'disabled' : '' %>>
        </div>
        <button class="btn btn-secondary" type="submit">Save contracted outcome</button>
        <a class="btn" href="/workspaces/<%= ws.id %>/engagement-plan">Open engagement plan</a>
      </form>
      <% if (isoContract.outcome === 'gap_assessment_only') { %>
      <script>
        (function () {
          const outcome = document.getElementById('setup-iso-outcome');
          const confirmation = document.getElementById('setup-iso-upgrade-confirmation');
          const check = confirmation.querySelector('input');
          const target = document.getElementById('setup-iso-target');
          const date = document.getElementById('setup-iso-target-date');
          const refresh = () => {
            const full = outcome.value === 'certification_support';
            confirmation.hidden = !full;
            check.required = full;
            target.hidden = !full;
            date.disabled = !full;
            if (!full) { check.checked = false; date.value = ''; }
          };
          outcome.addEventListener('change', refresh);
          refresh();
        })();
      </script>
      <% } %>
    <% } else { %>
      <p><strong><%= isoContract.options.find(option => option.value === isoContract.outcome).label %></strong></p>
    <% } %>
  </section>
<% } %>

<% if (!setup.total) { %>
  <div class="panel empty-state">
    <div class="empty-title">No programme assigned yet</div>
    <div class="empty-sub">This client has no assessment programme or operational module enabled. Assign one in client setup to begin.</div>
    <a class="btn btn-primary" href="/workspaces/<%= ws.id %>#programme-enable-form">Assign services</a>
  </div>
<% } else { %>

  <section class="panel panel-pad" style="margin-bottom:18px;">
    <div class="setup-progress-head">
      <b><%= setup.complete %>/<%= setup.total %></b>
      <span><%= setup.done ? 'Setup complete' : 'scoping steps complete' %></span>
    </div>
    <div class="setup-bar" role="img" aria-label="<%= setup.pct %>% of setup complete">
      <span style="width:<%= setup.pct %>%"></span>
    </div>
  </section>

  <section class="panel" style="margin-bottom:18px;">
    <div class="panel-head">
      <h2>Scoping steps</h2>
      <span class="meta">Programmes first, then operational modules</span>
    </div>
    <% setup.steps.forEach(step => {
         const isNext = setup.nextStep && setup.nextStep.key === step.key;
         const label = step.status === 'complete' ? 'Done'
           : step.status === 'in_progress' ? 'In progress' : 'Not started'; %>
      <div class="setup-step setup-step-<%= step.status %><%= isNext ? ' is-next' : '' %>">
        <div class="setup-step-mark" aria-hidden="true"></div>
        <div class="setup-step-body">
          <div class="setup-step-title">
            <strong><%= step.programme %></strong>
            <span class="meta text-xs"><%= step.kind === 'module' ? 'Module' : 'Programme' %></span>
            <% if (isNext && !setup.done) { %><span class="tag tag-accent text-xxs">Start here</span><% } %>
          </div>
          <div class="setup-step-label"><%= step.label %></div>
          <div class="meta text-sm"><%= step.detail %></div>
          <% if (step.note) { %><div class="meta text-xs" style="margin-top:3px;font-style:italic;"><%= step.note %></div><% } %>
        </div>
        <div class="setup-step-state">
          <span class="status s-<%= step.status === 'complete' ? 'implemented' : step.status === 'in_progress' ? 'partial' : 'not-assessed' %>"><%= label %></span>
          <a class="btn <%= isNext && !setup.done ? 'btn-primary' : 'btn-secondary' %> btn-xs" href="<%= step.href %>">
            <%= step.status === 'complete' ? 'Review' : step.status === 'in_progress' ? 'Continue' : 'Start' %>
          </a>
        </div>
      </div>
    <% }) %>
  </section>

  <% if (canEnableTprm && !hasTprm) { %>
    <section class="panel" style="margin-bottom:18px;">
      <div class="panel-head">
        <h2>Add third-party risk</h2>
        <span class="meta">Independent of the assessment programmes</span>
      </div>
      <div class="panel-pad">
        <form method="POST" action="/workspaces/<%= ws.id %>/modules/tprm">
          <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
          <div class="client-setup-module-options" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px;">
            <% [['assessment_only', 'One-off assessment', 'Assess selected third parties and issue recommendations.'],
                ['managed_lifecycle', 'Managed lifecycle', 'Run the provider lifecycle on the client\'s behalf.']].forEach(option => { %>
              <label class="panel-pad" style="display:flex;align-items:flex-start;gap:9px;cursor:pointer;border:1px solid var(--border);border-radius:7px;">
                <input type="radio" name="service_model" value="<%= option[0] %>" required style="margin-top:3px;">
                <span class="text-sm"><strong style="display:block;"><%= option[1] %></strong><span class="meta" style="display:block;line-height:1.4;"><%= option[2] %></span></span>
              </label>
            <% }) %>
          </div>
          <div class="row client-setup-enable-row" style="margin-top:14px;align-items:center;">
            <button class="btn btn-primary" type="submit">Enable third-party risk</button>
            <span class="meta text-xs">The contracted service model decides what the module permits.</span>
          </div>
        </form>
      </div>
    </section>
  <% } %>

<% } %>

<%- include('partials/footer') %>
