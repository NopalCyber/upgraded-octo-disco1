<%- include('partials/header',{title:'Updates',user,ws,active,portalView}) %>
<div class="page-head"><div><div class="eyebrow">Your engagement</div><h1>Updates</h1><p class="page-subtitle">Messages, decisions and handoffs shared with you.</p></div><a class="btn btn-secondary" href="/workspaces/<%= ws.id %>/client-portal?view=actions">Open my actions</a></div>
<section class="panel"><div class="panel-head"><div class="row" style="gap:8px"><a class="btn <%= unreadOnly?'btn-primary':'btn-secondary' %> btn-xs" href="?filter=unread">Unread</a><a class="btn <%= unreadOnly?'btn-secondary':'btn-primary' %> btn-xs" href="?filter=all">All updates</a></div><form method="POST" action="/workspaces/<%= ws.id %>/client-portal/updates/read-all"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-secondary btn-xs">Mark all read</button></form></div>
<% if (!updates.length) { %><div class="panel-pad"><h2><%= unreadOnly?'You are caught up':'No updates yet' %></h2><p class="meta">New messages and decisions appear here. Your work remains available in My actions.</p></div><% } %>
<% updates.forEach(update => { %><article class="panel-pad" style="border-bottom:1px solid var(--border)"><div class="row" style="justify-content:space-between;gap:12px"><h2 style="font-size:15px"><a href="<%= update.link %>"><%= update.title %></a></h2><time class="meta"><%= update.created_at %></time></div><% if (update.body) { %><p style="white-space:pre-wrap"><%= update.body %></p><% } %><div class="row" style="gap:8px"><a class="btn btn-primary btn-xs" href="<%= update.link %>">Open item</a><% if (!update.actor_read_at) { %><form method="POST" action="/workspaces/<%= ws.id %>/client-portal/updates/<%= update.id %>/read"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-secondary btn-xs">Mark read</button></form><% } %><form method="POST" action="/workspaces/<%= ws.id %>/client-portal/updates/<%= update.id %>/dismiss"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-xs">Dismiss update</button></form></div></article><% }) %></section>
<%- include('partials/footer') %>
