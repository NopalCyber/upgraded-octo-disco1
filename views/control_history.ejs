<%- include('partials/header', { title: 'Assessment history', user, ws, active: 'controls' }) %>

<%
  const refCode = item.id.replace('annex-','').replace('clause-','').toUpperCase();
  const cleanTitle = item.title.replace(/^A\.[0-9.]+ /,'').replace(/^[0-9.]+ /,'');
%>

<div class="page-head">
  <div>
    <h1 class="page-title"><%= refCode %> - assessment history</h1>
    <div class="page-subtitle"><%= cleanTitle %> · <%= rows.length %> snapshot<%= rows.length === 1 ? '' : 's' %> · append-only audit trail</div>
  </div>
  <div class="row">
    <a href="/workspaces/<%= ws.id %>/controls/assess/<%= item.id %>" class="btn btn-secondary btn-xs">→ Open control</a>
  </div>
</div>

<% if (rows.length === 0) { %>
  <div class="panel"><div class="panel-pad meta">No history yet - every save in the wizard records a snapshot here.</div></div>
<% } else { %>
  <div class="panel" style="overflow:hidden;">
    <table class="t">
      <thead><tr>
        <th style="width:160px;">When</th>
        <th style="width:120px;">By</th>
        <th style="width:140px;">Status</th>
        <th style="width:90px;">Maturity</th>
        <th style="width:90px;">Scope</th>
        <th style="width:120px;">Applicability</th>
        <th>Notes</th>
      </tr></thead>
      <tbody>
        <% rows.forEach(r => { %>
          <tr>
            <td class="mono meta text-sm"><%= r.snapshot_at %></td>
            <td class="meta text-base"><%= r.changed_by_name || '-' %></td>
            <td><span class="status s-<%= (r.status || '').replace(/\s+/g,'_') %> text-xs"><%= r.status || '-' %></span></td>
            <td class="num meta"><%= r.maturity != null ? r.maturity : '-' %></td>
            <td class="num meta"><%= r.scope_pct != null ? r.scope_pct + '%' : '-' %></td>
            <td class="meta text-base"><%= r.applicability || '-' %></td>
            <td class="text-base" style="line-height:1.4;max-width:520px;"><%= (r.notes || '').slice(0, 240) %><%= (r.notes && r.notes.length > 240) ? '…' : '' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('partials/footer') %>
