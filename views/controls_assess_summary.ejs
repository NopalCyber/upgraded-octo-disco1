<%- include('partials/header', { title: 'Control assessment', user, ws, active: 'gap-assessment-summary' }) %>

<%
  const statusRows = [
    { key: 'Implemented', label: 'Claimed implemented', meaning: 'Recorded as operating; evidence is tested separately.' },
    { key: 'Partially Implemented', label: 'Partially implemented', meaning: 'Coverage or consistency gaps remain.' },
    { key: 'Work In Progress', label: 'Work in progress', meaning: 'Implementation has started but is not complete.' },
    { key: 'Not Implemented', label: 'Not implemented', meaning: 'The requirement or control is absent.' },
    { key: 'Not Applicable', label: 'Not applicable', meaning: 'Requires a defensible SoA exclusion basis.' },
    { key: 'Not Assessed', label: 'Not assessed', meaning: 'No assessment conclusion has been recorded.' }
  ];
  const statusGapCount = gaps.length;
  const proofGapCount = evidenceAsks.length;
  const obligationCount = statusGapCount + proofGapCount;
  const assessmentComplete = notAssessedCount === 0;
  const headline = !assessmentComplete
    ? 'Assessment incomplete'
    : statusGapCount > 0
      ? 'Remediation required'
      : proofGapCount > 0
        ? 'Assessment complete; evidence incomplete'
        : 'Assessment defensible';
  const headlineDetail = !assessmentComplete
    ? `${notAssessedCount} item${notAssessedCount === 1 ? '' : 's'} still need an assessment conclusion.`
    : statusGapCount > 0
      ? `${statusGapCount} implementation gap${statusGapCount === 1 ? '' : 's'} require owned remediation.`
      : proofGapCount > 0
        ? `${proofGapCount} implementation claim${proofGapCount === 1 ? '' : 's'} cannot yet be substantiated with retained evidence.`
        : 'Every assessed implementation claim has retained evidence on file.';
  const cleanRef = id => id.replace('annex-','').replace('clause-','').toUpperCase();
  const cleanTitle = title => title.replace(/^A\.[0-9.]+ /,'').replace(/^[0-9.]+ /,'');
%>

<style>
  .cas{max-width:1160px;margin:0 auto;color:var(--text)}
  .cas-hero{background:var(--ink);color:#fff;border-radius:12px;padding:28px 30px;margin-bottom:14px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:28px;align-items:end}
  .cas-eyebrow{font-size:10px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;color:rgba(255,255,255,.58);margin-bottom:10px}
  .cas-hero h1{font-family:var(--font-display);font-size:34px;line-height:1.05;letter-spacing:-.025em;margin:0 0 9px;color:#fff}
  .cas-hero p{font-size:13px;line-height:1.55;color:rgba(255,255,255,.7);margin:0;max-width:720px}
