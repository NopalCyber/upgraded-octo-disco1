<%- include('partials/header', { title: 'Clients', user, ws: null }) %>

<style>
  #newWs { max-height: min(90dvh, 860px); overflow-y: auto; overscroll-behavior: contain; }
  #newWs > form { min-width: 0; }
  .dashboard-dialog-grid > *,
  .dashboard-dialog-options > * { min-width: 0; }
  @media (max-width: 760px) {
    .dashboard-onboarding-nudge {
      grid-template-columns: 42px minmax(0, 1fr) !important;
      padding: 14px !important;
    }
    .dashboard-onboarding-nudge > .btn {
      grid-column: 1 / -1;
      justify-content: center;
    }
    #newWs {
      position: fixed;
      inset: auto 0 0;
      width: 100% !important;
      max-height: 96dvh;
    }
    #newWs > form { display: flex; flex-direction: column; }
    .dashboard-dialog-header { padding: 15px 14px 10px !important; }
    .dashboard-dialog-header > button {
      min-width: 44px;
      min-height: 44px;
      margin: -8px -8px -8px 4px;
    }
    .dashboard-dialog-grid {
      grid-template-columns: 1fr !important;
      padding: 14px !important;
    }
    .dashboard-dialog-options { grid-template-columns: 1fr !important; }
    .dashboard-dialog-footer {
      position: sticky;
      bottom: 0;
      padding: 10px 14px !important;
    }
    .dashboard-dialog-footer .btn { flex: 1; justify-content: center; }
    #deleteClientModal { padding: 12px; }
    #deleteClientModal > div { max-width: 100% !important; }
    #deleteClientModal form > div:last-child .btn { flex: 1; justify-content: center; }
    .dashboard-delete-client { min-width: 44px; }
    .dash-table-wrap { overflow: visible; }
    #clientTable,
    #clientTable > tbody { display: block; width: 100%; }
    #clientTable > thead { display: none; }
    #clientTable tr.dash-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0 12px;
      padding: 14px;
      border-bottom: 1px solid var(--border);
    }
    #clientTable tr.dash-row:last-of-type { border-bottom: 0; }
    #clientTable tr.dash-row > td {
      display: block;
      min-width: 0;
      padding: 0;
      border: 0;
    }
    #clientTable tr.dash-row > td:first-child {
      grid-column: 1;
      min-width: 0;
      padding-bottom: 10px;
    }
    #clientTable tr.dash-row > td[data-label] {
      grid-column: 1 / -1;
      padding: 9px 0;
      border-top: 1px dashed var(--border);
    }
    #clientTable tr.dash-row > td[data-label]::before {
      display: block;
      margin-bottom: 4px;
      color: var(--text-tertiary);
      content: attr(data-label);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: .05em;
      text-transform: uppercase;
    }
    #clientTable tr.dash-row > .dashboard-row-actions {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
    }
    #clientTable tr:not(.dash-row) { display: block; }
    #clientTable tr:not(.dash-row) > td { display: block; min-width: 0; }
  }
</style>

<div class="page-head">
  <div>
    <h1 class="page-title"><%= user.user_type === 'firm' ? 'Portfolio' : 'My clients' %></h1>
  </div>
  <% if (user.user_type === 'firm' && rbac.rolePermissions(user.firm_role).includes('workspace.create')) { %>
    <button onclick="document.getElementById('newWs').showModal()" class="btn btn-primary">+ New client</button>
  <% } %>
</div>

<% if (workspaces.length > 0) { %>
<div class="dash-line">
  <span><strong><%= totals.total %></strong> active client<%= totals.total === 1 ? '' : 's' %></span>
  <% if (totals.needsAttention > 0) { %>
    <span><a class="link-muted" href="#clients" data-dash-filter="attention"><strong class="text-danger"><%= totals.needsAttention %></strong> need attention</a></span>
  <% } %>
  <% if (totals.watch > 0) { %>
    <span><strong class="text-warn"><%= totals.watch %></strong> to watch</span>
  <% } %>
  <% if (typeof thisWeek !== 'undefined' && thisWeek.overdue.length) { %>
    <span><a class="link-muted" href="#work"><strong class="text-danger"><%= thisWeek.overdue.length %></strong> overdue item<%= thisWeek.overdue.length === 1 ? '' : 's' %></a></span>
  <% } %>
  <% if (totals.gapOnly > 0) { %>
    <span><strong><%= totals.gapOnly %></strong> gap-assessment-only</span>
  <% } %>
  <% if (totals.nearCert > 0) { %>
    <span><strong class="text-warn"><%= totals.nearCert %></strong> within 90 days of certification</span>
  <% } %>
</div>
<% } %>

<% if (typeof onboarding !== 'undefined' && onboarding && onboarding.done < onboarding.total) { %>
  <div class="panel dashboard-onboarding-nudge" style="margin-bottom:24px;background:var(--bg-subtle);display:grid;grid-template-columns:42px 1fr auto;gap:14px;align-items:center;padding:16px 20px;">
    <div style="width:42px;height:42px;border-radius:10px;background:var(--accent);display:flex;align-items:center;justify-content:center;color:var(--accent-contrast);flex-shrink:0;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <div style="min-width:0;">
      <div class="text-xs" style="font-weight: 500;text-transform:uppercase;letter-spacing:0.05em;color:var(--accent-deep);margin-bottom:2px;">
        Setup <%= onboarding.done %> / <%= onboarding.total %><% if (onboarding.skipped) { %> · resumed after skip<% } %>
      </div>
      <div class="text-xl text-ink" style="font-weight: 500;letter-spacing:-0.005em;margin-bottom:4px;">
        <% if (onboarding.nextStep) { %>Next: <%= onboarding.nextStep.title %><% } else { %>Setup almost complete<% } %>
      </div>
      <div style="height:5px;background:var(--bg-muted);border-radius:3px;overflow:hidden;max-width:380px;">
        <div style="height:100%;background:var(--accent);width:<%= onboarding.pct %>%;transition:width 0.2s;"></div>
      </div>
    </div>
    <a href="/onboarding" class="btn btn-primary">Resume setup →</a>
  </div>
<% } %>

<% if (typeof thisWeek !== 'undefined' && thisWeek.totalActionable > 0) { %>
  <section class="panel" id="work" style="margin-bottom:20px;">
    <div class="panel-head">
      <h2>Work due across clients</h2>
      <span class="meta">
        <% if (thisWeek.overdue.length) { %><strong class="text-danger"><%= thisWeek.overdue.length %></strong> overdue<% } %>
        <% if (thisWeek.overdue.length && thisWeek.dueThisWeek.length) { %> · <% } %>
        <% if (thisWeek.dueThisWeek.length) { %><strong class="text-warn"><%= thisWeek.dueThisWeek.length %></strong> due this week<% } %>
      </span>
    </div>

    <%
      const KIND_LABEL = { task: 'Task', nc: 'Nonconformity', audit: 'Audit', mrm: 'Management review' };
      function renderGroups(groups, tone) { %>
      <% groups.forEach(group => { %>
        <div class="dash-work">
          <div class="dash-work-head">
            <span class="dash-work-when <%= tone %>"><%= group.earliest %><%= group.latest !== group.earliest ? ` to ${group.latest}` : '' %></span>
            <span class="dash-work-title"><%= group.title %></span>
            <span class="meta text-xs"><%= KIND_LABEL[group.kind] || group.kind %><%= group.clients.length > 1 ? ` · ${group.clients.length} clients` : '' %></span>
            <% if (group.clients.length === 1) { %>
              <a class="dash-work-one" href="<%= group.clients[0].href %>"><%= group.clients[0].client %><%= group.clients[0].count > 1 ? ` ×${group.clients[0].count}` : '' %></a>
            <% } %>
          </div>
          <% if (group.clients.length > 1) { %>
            <div class="dash-work-clients">
              <% group.clients.forEach(entry => { %>
                <a href="<%= entry.href %>"><%= entry.client %><%= entry.count > 1 ? ` ×${entry.count}` : '' %></a>
              <% }) %>
            </div>
          <% } %>
        </div>
      <% }) %>
    <% } %>

    <% if (thisWeek.overdueGroups && thisWeek.overdueGroups.length) { %>
      <div class="dash-work-group">
        <div class="sec-label text-danger" style="margin:0;">Overdue</div>
        <% renderGroups(thisWeek.overdueGroups, 'is-overdue') %>
      </div>
    <% } %>
    <% if (thisWeek.dueThisWeekGroups && thisWeek.dueThisWeekGroups.length) { %>
      <div class="dash-work-group">
        <div class="sec-label text-warn" style="margin:0;">Due this week</div>
        <% renderGroups(thisWeek.dueThisWeekGroups, 'is-soon') %>
      </div>
    <% } %>
  </section>
<% } %>

<% if (user.user_type === 'firm' && rbac.rolePermissions(user.firm_role).includes('workspace.create')) { %>
<dialog id="newWs" style="border:1px solid var(--border);border-radius:10px;padding:0;width:min(640px, 92vw);background:var(--bg);color:var(--text);box-shadow:var(--shadow-xl);">
  <form method="POST" action="/workspaces">
    <header class="dashboard-dialog-header" style="padding:20px 24px 12px;border-bottom:1px solid var(--border);display:flex;align-items:baseline;justify-content:space-between;">
      <div>
        <h2 style="margin:0;font-size:20px;font-weight: 500;letter-spacing:-0.01em;">New client</h2>
        <div class="meta text-sm" style="margin-top:2px;">Just the basics here: scope, stakeholders, and the rest of the 25 scoping questions come on the next page.</div>
      </div>
      <button type="button" onclick="document.getElementById('newWs').close()" aria-label="Close" style="background:transparent;border:0;color:var(--text-tertiary);cursor:pointer;padding:4px;font-size:18px;line-height:1;">×</button>
    </header>
    <div class="grid-2 dashboard-dialog-grid" style="padding:18px 24px;display:grid;grid-template-columns:1fr 1fr;gap:14px;">
      <div><label class="label">Client name <span class="meta">required</span></label><input class="input" name="client_name" required autofocus placeholder="e.g. Northwind Financial Services"></div>
      <div><label class="label">Industry</label><input class="input" name="industry" placeholder="SaaS, Fintech, Healthcare…"></div>
      <div class="col-full" id="dashboard-certification-target-field" hidden><label class="label">Target certification date</label><input class="input" id="dashboard-target-cert-date" name="target_cert_date" type="date" disabled style="max-width:240px;"><div class="meta text-xs" id="dashboard-target-cert-help" style="margin-top:4px;">Choose the service path first.</div></div>
      <fieldset id="dashboard-iso27001-outcome-fieldset" class="col-full" hidden style="border:1px solid var(--border);border-radius:7px;padding:11px;margin:0;">
        <legend class="label" style="padding:0 4px;">Contracted ISO 27001 outcome <span class="meta">required</span></legend>
        <div class="dashboard-dialog-options" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;">
          <% outcomeOptions.forEach(option => { %>
            <label style="display:flex;align-items:flex-start;gap:7px;padding:9px;border:1px solid var(--border);border-radius:6px;cursor:pointer;">
              <input type="radio" name="engagement_outcome" value="<%= option.value %>" style="margin-top:3px;">
              <span class="text-sm"><strong style="display:block;"><%= option.label %></strong><span class="meta" style="display:block;line-height:1.35;"><%= option.description %></span></span>
            </label>
          <% }) %>
        </div>
      </fieldset>
      <div class="col-full">
        <div class="label">Assessment programmes <span class="meta">optional · choose any combination</span></div>
        <div class="dashboard-dialog-options" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:8px;margin-top:7px;">
          <% frameworkList.forEach(fw => { %>
            <label style="display:flex;align-items:flex-start;gap:8px;padding:10px;border:1px solid var(--border);border-radius:7px;cursor:pointer;background:var(--bg);"><input id="dashboard-<%= fw.code %>-programme" type="checkbox" name="frameworks" value="<%= fw.code %>" style="margin-top:2px;"><span class="text-sm"><strong style="display:block;"><%= fw.pickerLabel %></strong><span class="meta"><%= fw.pickerNote %></span></span></label>
          <% }) %>
        </div>
        <div class="meta text-xs" style="margin-top:7px;">You can create the client now and assign programmes later.</div>
      </div>
      <div class="col-full" style="padding-top:4px;border-top:1px solid var(--border);">
        <div class="label">Operational modules <span class="meta">optional · independent of frameworks</span></div>
        <label style="display:flex;align-items:flex-start;gap:9px;padding:11px;border:1px solid var(--border);border-radius:7px;cursor:pointer;background:var(--bg);margin-top:7px;">
          <input id="dashboard-tprm-module" type="checkbox" name="tprm_enabled" value="1" style="margin-top:3px;">
          <span class="text-sm"><strong style="display:block;">Third-party risk</strong><span class="meta" style="display:block;line-height:1.4;">Provider intake, due diligence, consultancy recommendations, client decisions, monitoring, renewal and offboarding.</span></span>
        </label>
        <fieldset id="dashboard-tprm-service-fieldset" hidden style="border:1px solid var(--border);border-radius:7px;padding:11px;margin:10px 0 0;">
          <legend class="label" style="padding:0 4px;">TPRM service model <span class="meta">required</span></legend>
          <div class="dashboard-dialog-options" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;">
            <label style="display:flex;align-items:flex-start;gap:7px;padding:9px;border:1px solid var(--border);border-radius:6px;cursor:pointer;"><input type="radio" name="tprm_service_model" value="assessment_only" style="margin-top:3px;"><span class="text-sm"><strong style="display:block;">One-off assessment</strong><span class="meta">Assess selected third parties and issue recommendations.</span></span></label>
            <label style="display:flex;align-items:flex-start;gap:7px;padding:9px;border:1px solid var(--border);border-radius:6px;cursor:pointer;"><input type="radio" name="tprm_service_model" value="managed_lifecycle" style="margin-top:3px;"><span class="text-sm"><strong style="display:block;">Managed lifecycle</strong><span class="meta">Operate onboarding through monitoring and offboarding.</span></span></label>
          </div>
        </fieldset>
      </div>
    </div>
    <footer class="dashboard-dialog-footer" style="padding:14px 24px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px;background:var(--bg-subtle);">
      <button type="button" onclick="document.getElementById('newWs').close()" class="btn btn-ghost">Cancel</button>
      <button type="submit" class="btn btn-primary">Create client</button>
    </footer>
  </form>
</dialog>
<script>
(function () {
  const dlg = document.getElementById('newWs');
  if (!dlg) return;
  const target = document.getElementById('dashboard-target-cert-date');
  const targetField = document.getElementById('dashboard-certification-target-field');
  const targetHelp = document.getElementById('dashboard-target-cert-help');
  const isoProgramme = document.getElementById('dashboard-iso27001-programme');
  const outcomeFieldset = document.getElementById('dashboard-iso27001-outcome-fieldset');
  const outcomeChoices = dlg.querySelectorAll('input[name="engagement_outcome"]');
  const tprmModule = document.getElementById('dashboard-tprm-module');
  const tprmServiceFieldset = document.getElementById('dashboard-tprm-service-fieldset');
  const tprmServiceChoices = dlg.querySelectorAll('input[name="tprm_service_model"]');
  function refreshCertificationTarget() {
    const selected = dlg.querySelector('input[name="engagement_outcome"]:checked');
    const certifiable = !!(isoProgramme && isoProgramme.checked);
    const gapOnly = certifiable && selected && selected.value === 'gap_assessment_only';
    const fullSupport = certifiable && selected && selected.value === 'certification_support';
    outcomeFieldset.hidden = !certifiable;
    targetField.hidden = !certifiable;
    outcomeChoices.forEach(choice => { choice.required = certifiable; });
    target.disabled = !fullSupport;
    targetField.style.opacity = fullSupport ? '1' : '.55';
    targetHelp.textContent = gapOnly
      ? 'Not applicable to a gap-assessment-only contract.'
      : fullSupport ? 'Optional target for Full certification support.' : 'Choose the service path first.';
    if (!fullSupport) target.value = '';
  }
  outcomeChoices.forEach(choice => choice.addEventListener('change', refreshCertificationTarget));
  isoProgramme.addEventListener('change', refreshCertificationTarget);
  function refreshTprmService() {
    const enabled = !!tprmModule.checked;
    tprmServiceFieldset.hidden = !enabled;
    tprmServiceChoices.forEach(choice => { choice.required = enabled; });
  }
  tprmModule.addEventListener('change', refreshTprmService);
  refreshCertificationTarget();
  refreshTprmService();
  dlg.addEventListener('click', e => {
    const r = dlg.getBoundingClientRect();
    const outside = e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
    if (outside) dlg.close();
  });
})();
</script>
<% } %>

<%
  function reasonLink(reason, wsId) {
    if (/NC/i.test(reason)) return `/workspaces/${wsId}/nonconformities`;
    if (/cert target/i.test(reason)) return `/workspaces/${wsId}/cert-cycle`;
    if (/objective/i.test(reason)) return `/workspaces/${wsId}/objectives`;
    if (/stale controls/i.test(reason)) return `/workspaces/${wsId}/notifications?filter=unread`;
    if (/gap-assessment blocker/i.test(reason)) return `/workspaces/${wsId}/gap-assessment/fieldwork`;
    if (/truth conflict|readiness gap/i.test(reason)) return `/workspaces/${wsId}/data-quality`;
    if (/pass/i.test(reason)) return `/workspaces/${wsId}/gap-assessment`;
    return `/workspaces/${wsId}`;
  }
%>
<section class="panel" id="clients" style="overflow:hidden">
  <div class="panel-head">
    <h2>Clients</h2>
    <% if (totals.needsAttention > 0 || totals.watch > 0) { %>
      <div class="dash-filter" role="group" aria-label="Filter clients">
        <button type="button" class="dash-filter-btn is-active" data-filter="all">All <span class="meta num"><%= totals.total %></span></button>
        <button type="button" class="dash-filter-btn" data-filter="attention">Needs attention <span class="meta num"><%= totals.needsAttention + totals.watch %></span></button>
      </div>
    <% } %>
  </div>
  <div class="dash-table-wrap">
  <table class="t" id="clientTable">
    <thead><tr>
      <th style="min-width:170px">Client</th>
      <th style="width:186px">Engagement</th>
      <th style="width:150px">Progress</th>
      <th style="width:116px">Next milestone</th>
      <th style="width:250px">Attention</th>
      <% if (user.user_type === 'firm') { %><th style="width:34px"></th><% } %>
    </tr></thead>
    <tbody>
      <% workspaces.forEach(w => { %>
        <%
          const serviceClass = w.service.tone === 'success' ? 'done' : w.service.tone === 'danger' ? 'blocked' : w.service.tone === 'warning' ? 'in_progress' : 'not_started';
          const att = w.attention || { severity: 'ok', reasons: [], primary: null, more: 0, rest: [] };
        %>
        <tr class="dash-row" data-attention="<%= att.severity %>" style="cursor:pointer" onclick="location='/workspaces/<%= w.id %>'">
          <td>
            <div class="dash-client">
              <span class="dash-dot dash-dot-<%= att.severity %>" title="<%= att.severity === 'high' ? 'Needs attention' : att.severity === 'medium' ? 'Watch' : 'No open signal' %>"></span>
              <span style="font-weight:500"><%= w.brand_display_name || w.client_name %></span>
              <% if (w.sector) { %><span class="meta text-xs"><%= w.sector %></span><% } %>
            </div>
            <% if (w.industry) { %><div class="meta text-xs" style="margin-left:16px;"><%= w.industry %></div><% } %>
          </td>
          <td data-label="Engagement">
            <span class="status s-<%= serviceClass %>"><%= w.service.path %></span>
            <div class="meta text-xs" style="margin-top:3px;"><%= w.service.detail %></div>
          </td>
          <td data-label="Progress">
            <div style="font-weight:500;font-size:12.5px;"><%= w.service.position %></div>
            <div class="dash-progress" title="<%= w.progress.assessed %> of <%= w.progress.total %> assessed">
              <span style="width:<%= w.progress.percent %>%"></span>
            </div>
            <div class="meta text-xs num"><%= w.service.metric %></div>
          </td>
          <td class="text-sm" data-label="Next milestone">
            <%= w.service.target %>
            <% if (w.service.targetDetail) { %><div class="meta text-xs num"><%= w.service.targetDetail %></div><% } %>
          </td>
          <td data-label="Attention" onclick="event.stopPropagation()" style="cursor:default;">
            <% if (att.primary) { %>
              <a class="dash-reason dash-reason-<%= att.severity %>" href="<%= reasonLink(att.primary, w.id) %>"><%= att.primary %></a>
              <% if (att.more) { %>
                <span class="meta text-xs" title="<%= att.rest.join(' · ') %>">+ <%= att.more %> more</span>
              <% } %>
            <% } else { %>
              <span class="meta">-</span>
            <% } %>
          </td>
          <% if (user.user_type === 'firm' && rbac.rolePermissions(user.firm_role).includes('workspace.delete')) { %>
          <td class="dashboard-row-actions" onclick="event.stopPropagation()" style="text-align:right;cursor:default;">
            <button type="button"
                    data-delete-client-id="<%= w.id %>"
                    data-delete-client-name="<%= w.client_name %>"
                    title="Delete this client"
                    aria-label="Delete <%= w.client_name %>"
                    class="btn btn-ghost btn-xs dashboard-delete-client"
                    style="color:var(--danger,#b91c1c);padding:4px 8px;">×</button>
          </td>
          <% } else if (user.user_type === 'firm') { %><td class="dashboard-row-actions"></td><% } %>
        </tr>
      <% }) %>
      <% if (workspaces.length === 0) { %>
        <tr><td colspan="6" style="padding:0;">
          <div class="empty-state">
            <div class="empty-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <div class="empty-title">No clients yet</div>
            <div class="empty-sub">Add your first client to get started. Each client gets its own scope, risks, controls, and audit trail.</div>
            <% if (user.user_type === 'firm' && rbac.rolePermissions(user.firm_role).includes('workspace.create')) { %>
              <button onclick="document.getElementById('newWs').showModal()" class="btn btn-primary">+ New client</button>
            <% } %>
          </div>
        </td></tr>
      <% } %>
      <tr id="clientTableEmpty" hidden><td colspan="6" class="t-empty">No client currently carries an open signal.</td></tr>
    </tbody>
  </table>
  </div>
</section>

<script>
  (function () {
    var buttons = document.querySelectorAll('.dash-filter-btn');
    var table = document.getElementById('clientTable');
    if (!buttons.length || !table) return;
    var empty = document.getElementById('clientTableEmpty');
    function apply(filter) {
      var shown = 0;
      table.querySelectorAll('tr.dash-row').forEach(function (row) {
        var keep = filter === 'all' || row.getAttribute('data-attention') !== 'ok';
        row.hidden = !keep;
        if (keep) shown++;
      });
      if (empty) empty.hidden = shown > 0;
      buttons.forEach(function (button) {
        button.classList.toggle('is-active', button.getAttribute('data-filter') === filter);
      });
    }
    buttons.forEach(function (button) {
      button.addEventListener('click', function () { apply(button.getAttribute('data-filter')); });
    });
    document.querySelectorAll('[data-dash-filter]').forEach(function (link) {
      link.addEventListener('click', function () { apply(link.getAttribute('data-dash-filter')); });
    });
  })();
</script>

<% if (user.user_type === 'firm' && rbac.isManager(user.firm_role)) { %>
  <div class="dash-line" style="margin-top:20px;">
    <span><strong><%= firmUsers.length %></strong> consultant<%= firmUsers.length === 1 ? '' : 's' %> on the firm</span>
    <span><a class="link" href="/admin/users">Manage users and access</a></span>
  </div>
<% } %>

<div id="deleteClientModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,0.55);z-index:1000;align-items:center;justify-content:center;">
  <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;width:440px;max-width:92vw;box-shadow:0 24px 48px rgba(0,0,0,0.25);overflow:hidden;">
    <div style="padding:16px 18px;border-bottom:1px solid var(--border);background:rgba(185,28,28,0.06);">
      <div class="text-xs" style="font-weight: 500;text-transform:uppercase;letter-spacing:0.05em;color:var(--danger,#b91c1c);">Delete client</div>
      <div id="dcmTitle" style="font-size:15px;font-weight: 500;margin-top:4px;"></div>
    </div>
    <form id="deleteClientForm" method="POST" action="">
      <div style="padding:18px;">
        <div class="meta text-md" style="line-height:1.5;margin-bottom:14px;">
          Permanently removes this client and everything inside it: controls, gap-assessment passes, risks, evidence files (DB and disk), audits, MRMs, NCs, incidents, suppliers, documents, registers. <strong>Cannot be undone.</strong>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:6px;">
          <label for="dcmInput" class="label text-base" style="margin:0;">Type <strong id="dcmExpected"></strong> to confirm</label>
          <button type="button" id="dcmCopyName" class="btn btn-ghost btn-xs" data-copy-target="#dcmExpected" aria-label="Copy client name" aria-live="polite" style="flex:none;">Copy name</button>
        </div>
        <input id="dcmInput" class="input" name="confirm_name" autocomplete="off" required>
        <div class="text-sm" id="dcmError" style="color:var(--danger,#b91c1c);margin-top:6px;display:none;">Name did not match.</div>
      </div>
      <div style="padding:12px 18px;border-top:1px solid var(--border);background:var(--bg-subtle);display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" id="dcmCancel" class="btn btn-ghost btn-xs">Cancel</button>
        <button type="submit" id="dcmConfirm" class="btn btn-xs" style="background:var(--danger,#b91c1c);color:#fff;border-color:var(--danger,#b91c1c);">Delete client</button>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    const modal = document.getElementById('deleteClientModal');
    const form = document.getElementById('deleteClientForm');
    const title = document.getElementById('dcmTitle');
    const expected = document.getElementById('dcmExpected');
    const input = document.getElementById('dcmInput');
    const copyName = document.getElementById('dcmCopyName');
    const error = document.getElementById('dcmError');
    let currentName = '';

    function open(wsId, clientName) {
      currentName = clientName;
      title.textContent = clientName;
      expected.textContent = clientName;
      input.value = '';
      copyName.textContent = 'Copy name';
      copyName.classList.remove('is-copied');
      error.style.display = 'none';
      form.action = '/workspaces/' + wsId + '/delete';
      modal.style.display = 'flex';
      setTimeout(() => input.focus(), 50);
    }
    function close() { modal.style.display = 'none'; }

    document.getElementById('dcmCancel').addEventListener('click', close);
    document.querySelectorAll('[data-delete-client-id][data-delete-client-name]').forEach((button) => {
      button.addEventListener('click', () => open(
        button.getAttribute('data-delete-client-id'),
        button.getAttribute('data-delete-client-name')
      ));
    });
    copyName.addEventListener('click', () => setTimeout(() => input.focus(), 0));
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal.style.display === 'flex') close(); });
    form.addEventListener('submit', (e) => {
      if (input.value.trim() !== currentName) {
        e.preventDefault();
        error.style.display = 'block';
        input.focus();
      }
    });
  })();
</script>

<%- include('partials/footer') %>
