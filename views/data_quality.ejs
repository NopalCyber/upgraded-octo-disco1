<%- include('partials/header', { title: 'Data quality & truth', user, ws, active: 'data-quality' }) %>

<style>
  .dq-page-head{align-items:flex-end;padding:4px 0 17px;border-bottom:1px solid var(--border)}
  .dq-page-head .page-title{font-size:26px;margin:0}.dq-page-head .page-subtitle{max-width:760px;line-height:1.55}.dq-verdict{text-align:right;min-width:230px}.dq-verdict span,.dq-verdict strong{display:block}.dq-verdict span{font-size:10.5px;color:var(--text-tertiary)}.dq-verdict strong{font-family:var(--font-display);font-size:22px;font-weight:600;margin:3px 0}
  .dq-stats{display:grid;grid-template-columns:1.25fr repeat(4,1fr);gap:0;border:1px solid var(--border);border-radius:8px;overflow:hidden;margin-bottom:18px}.dq-stat{padding:16px 18px;border:0;border-left:1px solid var(--border);background:var(--surface)}.dq-stat:first-child{border-left:0}.dq-stat b{font-family:var(--font-display);font-size:25px;display:block;line-height:1.1}.dq-stat span{font-size:10px;text-transform:uppercase;letter-spacing:.065em;color:var(--text-muted)}.dq-score{display:flex;align-items:center;gap:14px}.dq-score b{font-size:35px}.dq-score small{display:block;color:var(--text-muted);font-size:11px;margin-top:2px}
  .dq-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:16px}.dq-filters{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px}.dq-domains{display:flex;gap:6px;overflow:auto;padding-bottom:2px}.dq-filter{border:1px solid var(--border);border-radius:99px;padding:6px 10px;text-decoration:none;color:var(--text-secondary);font-size:11px;white-space:nowrap;background:var(--surface)}.dq-filter.active{background:var(--ink);border-color:var(--ink);color:#fff}
  .dq-issue{border:1px solid var(--border);border-radius:6px;background:var(--surface);margin-bottom:10px;overflow:hidden}.dq-issue-head{padding:15px 18px 14px;border-bottom:1px solid var(--border)}.dq-issue-meta{display:flex;justify-content:space-between;gap:18px;align-items:center;margin-bottom:9px}.dq-issue h2{font-size:15px;line-height:1.3;margin:0}.dq-domain{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:var(--text-muted)}.dq-severity{border:1px solid currentColor;border-radius:3px;padding:3px 6px;font-size:8px;font-weight:800;text-transform:uppercase;letter-spacing:.075em;background:transparent}.dq-severity.critical{color:#b42318}.dq-severity.high{color:#b54708}.dq-severity.medium{color:#946200}.dq-severity.low{color:#475467}.dq-finding-grid{font-size:12px;line-height:1.5}.dq-finding-row{display:grid;grid-template-columns:118px minmax(0,1fr);border-bottom:1px solid var(--border)}.dq-finding-row:last-child{border-bottom:0}.dq-finding-label{padding:11px 12px 11px 18px;background:var(--bg-subtle);font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.065em;color:var(--text-muted)}.dq-finding-value{padding:10px 18px;color:var(--text-secondary)}.dq-finding-value strong{color:var(--ink)}.dq-records{padding:13px 18px;border-top:1px solid var(--border)}.dq-records-head{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:9px}.dq-records-head span:first-child{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--text-muted)}.dq-records-head span:last-child{font-size:10px;color:var(--text-muted)}.dq-items{display:flex;gap:6px;flex-wrap:wrap;margin:0}.dq-item{font-size:10px;border:1px solid var(--border);border-radius:3px;padding:4px 7px;text-decoration:none;color:var(--text-secondary);background:var(--surface)}.dq-actions{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:11px 18px;border-top:1px solid var(--border);background:var(--bg-subtle)}.dq-count{font-size:10px;color:var(--text-muted)}
  .dq-aside{align-self:start;position:sticky;top:18px}.dq-aside .panel{margin-bottom:12px}.dq-gate{display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid var(--border);font-size:12px}.dq-gate:last-child{border-bottom:0}.dq-gate b{font-variant-numeric:tabular-nums}.dq-note{font-size:12px;line-height:1.55;color:var(--text-secondary);margin:0}.dq-empty{text-align:center;padding:46px 20px}.dq-empty h2{font-family:var(--font-display);margin:0 0 8px}
  @media(max-width:950px){.dq-layout{grid-template-columns:1fr}.dq-aside{position:static}.dq-stats{grid-template-columns:1fr 1fr}.dq-stat:first-child{grid-column:1/-1}.dq-verdict{text-align:left}.dq-filters{align-items:flex-start;flex-direction:column}.dq-finding-row{grid-template-columns:1fr}.dq-finding-label{padding-bottom:5px}.dq-finding-value{padding-top:4px}.dq-actions{align-items:flex-start;flex-direction:column}}

  @media (max-width: 760px) {
    .dq-main, .dq-aside { min-width: 0; }
    .dq-domains { max-width: 100%; min-width: 0; }
    .dq-issue-meta, .dq-gate { flex-direction: column; align-items: flex-start; gap: 6px; }

    .dq-verdict span,
    .dq-stat span,
    .dq-domain,
    .dq-severity,
    .dq-finding-label,
    .dq-records-head span:first-child,
    .dq-records-head span:last-child,
    .dq-item,
    .dq-count
    { font-size: 11px; }
  }
</style>

<div class="page-head dq-page-head">
  <div>
    <div class="eyebrow">Data integrity</div>
    <h1 class="page-title">Data quality &amp; truth</h1>
    <div class="page-subtitle">Review conflicts and incomplete records that can affect readiness, reporting, and audit conclusions. Each exception links to the record that requires correction.</div>
  </div>
  <div class="dq-verdict">
    <span>Current readiness position</span>
    <strong><%= truth.verdict.label %></strong>
    <span><%= truth.readiness.stage1GatePassed %>/<%= truth.readiness.stage1GateTotal %> Stage 1 gates · <%= truth.readiness.stage2GatePassed %>/<%= truth.readiness.stage2GateTotal %> Stage 2 gates</span>
  </div>
</div>

<div class="dq-stats">
  <div class="dq-stat dq-score"><b><%= truth.quality.score %></b><div><span>Decision data quality</span><small><%= truth.quality.label %> · severity-weighted, not a maturity score</small></div></div>
  <div class="dq-stat"><b style="color:#b42318"><%= truth.counts.critical %></b><span>Critical conflicts</span></div>
  <div class="dq-stat"><b style="color:#b54708"><%= truth.counts.high %></b><span>High-priority gaps</span></div>
  <div class="dq-stat"><b><%= truth.counts.medium %></b><span>Review items</span></div>
  <div class="dq-stat"><b><%= truth.issues.length %></b><span>Open quality rules</span></div>
</div>

<div class="dq-layout">
  <div class="dq-main">
    <div class="dq-filters">
      <div class="dq-domains">
        <a class="dq-filter <%= domain==='all'?'active':'' %>" href="?severity=<%= severity %>">All domains</a>
        <% truth.domains.forEach(d => { %><a class="dq-filter <%= domain===d.key?'active':'' %>" href="?domain=<%= d.key %>&severity=<%= severity %>"><%= d.label %> <strong><%= d.total %></strong></a><% }) %>
      </div>
      <select class="select" style="width:155px" onchange="location='?domain=<%= domain %>&severity='+this.value">
        <option value="all" <%= severity==='all'?'selected':'' %>>All severities</option>
        <% ['critical','high','medium','low'].forEach(s => { %><option value="<%= s %>" <%= severity===s?'selected':'' %>><%= s[0].toUpperCase()+s.slice(1) %></option><% }) %>
      </select>
    </div>

    <% if (!issues.length) { %>
      <div class="panel dq-empty"><h2>No issues in this view</h2><p class="meta">The selected domain and severity have no open data-quality exceptions.</p></div>
    <% } %>
    <% issues.forEach(issue => { %>
      <article class="dq-issue <%= issue.severity %>">
        <header class="dq-issue-head">
          <div class="dq-issue-meta"><div class="dq-domain"><%= issue.domain %> quality check</div><span class="dq-severity <%= issue.severity %>"><%= issue.severity %></span></div>
          <h2><%= issue.title %></h2>
        </header>
        <div class="dq-finding-grid">
          <div class="dq-finding-row"><div class="dq-finding-label">Observed condition</div><div class="dq-finding-value"><%= issue.detail %></div></div>
          <div class="dq-finding-row"><div class="dq-finding-label">Decision impact</div><div class="dq-finding-value"><%= issue.impact %></div></div>
        </div>
        <% if (issue.items && issue.items.length) { %><div class="dq-records"><div class="dq-records-head"><span>Affected records</span><span>Showing <%= issue.items.length %> of <%= issue.count %></span></div><div class="dq-items"><% issue.items.forEach(item => { %><a class="dq-item" href="<%= item.href %>"><%= item.label %></a><% }) %><% if (issue.count > issue.items.length) { %><span class="dq-item">+<%= issue.count - issue.items.length %> more</span><% } %></div></div><% } %>
        <footer class="dq-actions"><span class="dq-count"><%= issue.count %> affected record<%= issue.count===1?'':'s' %> · <code><%= issue.code %></code></span><a class="btn btn-secondary btn-xs" href="<%= issue.href %>"><%= issue.cta %> →</a></footer>
      </article>
    <% }) %>
  </div>

  <aside class="dq-aside">
    <div class="panel"><div class="panel-head"><h2>Readiness evidence</h2></div><div class="panel-pad">
      <div class="dq-gate"><span>Stage 1 hard gates</span><b><%= truth.readiness.stage1GatePassed %>/<%= truth.readiness.stage1GateTotal %></b></div>
      <div class="dq-gate"><span>Stage 1 maturity</span><b><%= truth.readiness.stage1 %>%</b></div>
      <div class="dq-gate"><span>Stage 2 hard gates</span><b><%= truth.readiness.stage2GatePassed %>/<%= truth.readiness.stage2GateTotal %></b></div>
      <div class="dq-gate"><span>Stage 2 maturity</span><b><%= truth.readiness.stage2 %>%</b></div>
    </div></div>
    <div class="panel"><div class="panel-head"><h2>How to read this</h2></div><div class="panel-pad"><p class="dq-note">Readiness is a gate verdict. Maturity measures implementation depth. Data quality measures whether the records supporting decisions and reports are complete, current, and mutually consistent. A high maturity percentage never overrides a failed hard gate.</p></div></div>
    <div class="panel"><div class="panel-head"><h2>Report behaviour</h2></div><div class="panel-pad"><p class="dq-note">Assurance reports remain frozen and traceable. Open source-data exceptions are carried as quality warnings so a polished report cannot silently overstate the underlying posture.</p><a class="btn btn-secondary btn-sm" style="margin-top:12px" href="/workspaces/<%= ws.id %>/assurance">Open assurance centre</a></div></div>
  </aside>
</div>

<%- include('partials/footer') %>
