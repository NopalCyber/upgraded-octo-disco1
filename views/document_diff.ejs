<%- include('partials/header', { title: doc.name + ' - diff', user, ws, active: 'documents' }) %>

<a href="/workspaces/<%= ws.id %>/documents/<%= doc.id %>/versions" class="link-muted text-base">← Versions</a>

<div class="page-head" style="margin-top:8px">
  <div>
    <h1 class="page-title">Compare versions</h1>
    <div class="page-subtitle"><%= doc.name %></div>
  </div>
  <form class="row-center" method="GET" action="/workspaces/<%= ws.id %>/documents/<%= doc.id %>/diff">
    <select name="a" class="select" style="width:auto"><% all.forEach(v => { %><option value="<%= v.id %>" <%= va && va.id === v.id ? 'selected' : '' %>>v<%= v.version %> · <%= v.status %></option><% }) %></select>
    <span class="meta">vs</span>
    <select name="b" class="select" style="width:auto"><% all.forEach(v => { %><option value="<%= v.id %>" <%= vb && vb.id === v.id ? 'selected' : '' %>>v<%= v.version %> · <%= v.status %></option><% }) %></select>
    <button class="btn btn-secondary btn-xs">Compare</button>
  </form>
</div>

<% if (!diff) { %>
  <div class="panel"><div class="panel-pad meta">Pick two versions above to compare.</div></div>
<% } else { %>
  <div class="panel">
    <div class="panel-head">
      <h2>v<%= va.version %> → v<%= vb.version %></h2>
      <span class="meta">
        <%= diff.filter(d => d.k === 'add').length %> additions ·
        <%= diff.filter(d => d.k === 'del').length %> deletions ·
        <%= diff.filter(d => d.k === 'eq').length %> unchanged
      </span>
    </div>
    <div class="text-md" style="font-family:ui-monospace,monospace;line-height:1.6;padding:8px 0;background:var(--bg);">
      <% diff.forEach(d => { %>
        <% if (d.k === 'eq') { %>
          <div class="text-secondary" style="padding:1px 16px;"><span class="text-tertiary" style="display:inline-block;width:14px;"> </span><%= escapeHtml(d.a) %></div>
        <% } else if (d.k === 'add') { %>
          <div class="text-success" style="padding:1px 16px;background:rgba(22,163,74,0.08);"><span style="display:inline-block;width:14px;font-weight: 500;">+</span><%= escapeHtml(d.b) %></div>
        <% } else { %>
          <div class="text-danger" style="padding:1px 16px;background:rgba(220,38,38,0.06);text-decoration:line-through;"><span style="display:inline-block;width:14px;font-weight: 500;">−</span><%= escapeHtml(d.a) %></div>
        <% } %>
      <% }) %>
    </div>
  </div>
<% } %>

<%- include('partials/footer') %>
