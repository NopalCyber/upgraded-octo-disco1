<!DOCTYPE html>
<html><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= doc.name %> - <%= ws.client_name %></title>
<style>
  body { font-family: Georgia, 'Times New Roman', serif; max-width: 8.5in; margin: 0.75in auto; line-height: 1.6; color: #222; }
  h1 { border-bottom: 2px solid #333; padding-bottom: 0.4rem; font-size: 1.8rem; }
  h2 { font-size: 1.3rem; margin-top: 1.5rem; }
  h3 { font-size: 1.1rem; margin-top: 1rem; }
  table { border-collapse: collapse; margin: 1rem 0; font-size: 0.9em; }
  th, td { border: 1px solid #888; padding: 0.4rem 0.7rem; text-align: left; }
  th { background: #f0f0f0; }
  ul, ol { margin: 0.5rem 0; padding-left: 1.5rem; }
  li { margin: 0.2rem 0; }
  hr { border: none; border-top: 1px solid #ccc; margin: 1.5rem 0; }
  code { background: #f4f4f4; padding: 0.1rem 0.3rem; border-radius: 3px; }
  .meta { color: #666; font-size: 0.85em; margin-bottom: 1.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid #ddd; }
  .print-toolbar { background: #1a1a1a; color: white; padding: 0.5rem 1rem; margin: -0.75in -0.75in 1rem; display: flex; justify-content: space-between; align-items: center; }
  .print-toolbar button { background: white; color: #1a1a1a; padding: 0.3rem 0.8rem; border: none; border-radius: 4px; cursor: pointer; font-weight: 500; }
  @media print { .print-toolbar { display: none; } body { margin: 0.5in; } }
</style>
</head><body>
<div class="print-toolbar">
  <span><%= ws.client_name %> · <%= doc.category %> · v<%= doc.version %></span>
  <button onclick="window.print()">Print / Save as PDF</button>
</div>
<div class="meta"><%= ws.client_name %> · v<%= doc.version %> · status: <%= doc.status %></div>
<div id="content"><%- doc.content %></div>
</body></html>
