<%- include('partials/header', { title: 'Documents - tree', user, ws, active: 'documents' }) %>

<a href="/workspaces/<%= ws.id %>/documents" class="link-muted text-base">← All documents</a>

<div class="page-head" style="margin-top:8px">
  <div><h1 class="page-title">Document hierarchy</h1>
    <div class="page-subtitle">Parent policies → child procedures → linked records. Set a parent on the document detail page.</div></div>
</div>

<%
  const byParent = {};
  docs.forEach(d => { (byParent[d.parent_doc_id || 'root'] = byParent[d.parent_doc_id || 'root'] || []).push(d); });
  function render(parentId, depth) {
    let html = '';
    const list = byParent[parentId] || [];
    list.forEach(d => {
      html += `<div style="padding:8px 16px;padding-left:${16 + depth * 24}px;border-bottom:1px solid var(--border);"><a href="/workspaces/${ws.id}/documents/${d.id}" class="link-muted" style="font-weight:500;">${d.name}</a> <span class="tag tag-neutral text-eyebrow">${d.doc_kind || d.category || '-'}</span> ${d.reference_code ? '<span class="meta mono text-xs">'+d.reference_code+'</span>' : ''} <span class="tag ${d.status === 'published' || d.status === 'approved' ? 'tag-success' : d.status === 'in_review' ? 'tag-warn' : 'tag-neutral'} text-eyebrow">${d.status}</span></div>`;
      html += render(d.id, depth + 1);
    });
    return html;
  }
%>

<div class="panel">
  <%- render('root', 0) %>
  <% if (docs.length === 0) { %><div class="empty-state"><div class="empty-sub">No documents yet.</div></div><% } %>
</div>

<%- include('partials/footer') %>
