<%- include('partials/header', { title: 'Library', user, ws: null, active: 'firm-library' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">Library</h1>
    <div class="page-subtitle">Your firm's hardened content. Curate once, clone into every new client. Saves a junior consultant from rebuilding the wheel each time.</div>
  </div>
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:14px;">
  <a href="/firm/library/risks" class="panel" style="display:block;padding:18px 20px;text-decoration:none;">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <span style="font-size:15px;font-weight: 500;">Risk library</span>
      <span class="tag tag-info text-xxs" style="margin-left:auto;"><%= counts.risks %> risks</span>
    </div>
    <div class="meta text-md" style="line-height:1.5;">
      Pre-vetted risk scenarios you've validated across past clients. Add your sector-specific entries; tweak descriptions; remove what doesn't fit your practice. Each client clones the library into its risk register with one click.
    </div>
    <div class="text-base" style="margin-top:14px;color:var(--accent);font-weight:500;">Manage risks →</div>
  </a>

  <a href="/firm/library/templates" class="panel" style="display:block;padding:18px 20px;text-decoration:none;">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      <span style="font-size:15px;font-weight: 500;">Policy templates</span>
      <span class="tag tag-info text-xxs" style="margin-left:auto;"><%= counts.templates %> template<%= counts.templates === 1 ? '' : 's' %></span>
    </div>
    <div class="meta text-md" style="line-height:1.5;">
      Documents your team wrote for one client, saved from the document page with the client's name taken out. They sit beside the standard templates in every client's template library.
    </div>
    <div class="text-base" style="margin-top:14px;color:var(--accent);font-weight:500;">Manage templates →</div>
  </a>

  <div class="panel" style="padding:18px 20px;opacity:0.6;">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--text-tertiary)" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
      <span style="font-size:15px;font-weight: 500;">Control narratives</span>
      <span class="tag tag-neutral text-xxs" style="margin-left:auto;">soon</span>
    </div>
    <div class="meta text-md" style="line-height:1.5;">
      Your firm's preferred wording for "what good looks like" per Annex A control. Replaces the shipped narratives during gap assessment.
    </div>
  </div>
</div>

<%- include('partials/footer') %>
