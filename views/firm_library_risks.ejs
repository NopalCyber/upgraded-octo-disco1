<%- include('partials/header', { title: 'Firm risk library', user, ws: null, active: 'firm-library' }) %>

<div class="page-head">
  <div>
    <a href="/firm/library" class="link-muted text-base">← Firm library</a>
    <h1 class="page-title" style="margin-top:6px;">Firm risk library <span class="meta text-xl" style="font-weight:400;">(<%= rows.length %>)</span></h1>
    <div class="page-subtitle">Curate the risks your firm uses on every client. Each entry can be cloned into a client risk register with the "Clone firm library" button on the risks page.</div>
  </div>
  <% if (canManage) { %><div style="display:flex;gap:8px;">
    <form method="POST" action="/firm/library/risks/reseed" style="display:inline;">
      <button class="btn btn-ghost btn-xs" title="Re-add any starter risks not already in the library" onclick="return appConfirmClick(event, 'Re-seed missing starter risks? Existing entries with the same title are kept untouched.');">Re-seed starter set</button>
    </form>
    <button onclick="document.getElementById('addRisk').classList.toggle('hidden')" class="btn btn-primary btn-xs">New risk</button>
  </div><% } else { %><div class="meta text-sm">Read-only · a Manager or Senior consultant curates this library.</div><% } %>
</div>

<form method="GET" action="/firm/library/risks" class="panel panel-pad" style="display:grid;grid-template-columns:1fr 200px 200px auto;gap:8px;align-items:end;margin-bottom:14px;">
  <div><label class="label">Search</label><input class="input" type="text" name="q" value="<%= search %>" placeholder="title, description, tag…"></div>
  <div><label class="label">Domain</label>
    <select class="select" name="domain">
      <option value="">All domains</option>
      <% domains.forEach(d => { %><option value="<%= d %>" <%= filterDomain === d ? 'selected' : '' %>><%= d %></option><% }) %>
    </select>
  </div>
  <div><label class="label">Sector</label>
    <select class="select" name="sector">
      <option value="">All sectors</option>
      <% sectors.forEach(s => { %><option value="<%= s %>" <%= filterSector === s ? 'selected' : '' %>><%= s %></option><% }) %>
    </select>
  </div>
  <div><button class="btn btn-secondary btn-xs">Filter</button></div>
</form>

<% if (canManage) { %><div id="addRisk" class="panel hidden" style="margin-bottom:14px;">
  <div class="panel-head"><h2 style="margin:0;">Add risk to firm library</h2></div>
  <form method="POST" action="/firm/library/risks" class="panel-pad" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
    <div class="col-full"><label class="label">Title *</label><input class="input" name="title" required></div>
    <div><label class="label">Domain</label><input class="input" name="domain" placeholder="Access & identity, Data protection..."></div>
    <div><label class="label">Sector (optional)</label>
      <select class="select" name="sector">
        <option value="">Any sector</option>
        <% ['SaaS','Fintech','Healthcare','Manufacturing','Public sector','MSP','Retail','Education'].forEach(s => { %><option value="<%= s %>"><%= s %></option><% }) %>
      </select>
    </div>
    <div class="col-full"><label class="label">Description</label><textarea class="textarea" name="description" rows="2"></textarea></div>
    <div><label class="label">Threat</label><textarea class="textarea" name="threat" rows="2"></textarea></div>
    <div><label class="label">Vulnerability</label><textarea class="textarea" name="vulnerability" rows="2"></textarea></div>
    <div><label class="label">Suggested likelihood (1–5)</label><input class="input" type="number" name="suggested_likelihood" min="1" max="5" value="3"></div>
    <div><label class="label">Suggested impact (1–5)</label><input class="input" type="number" name="suggested_impact" min="1" max="5" value="3"></div>
    <div class="col-full"><label class="label">Suggested treatment</label><textarea class="textarea" name="suggested_treatment" rows="2" placeholder="Mitigate via … / Transfer via … / Accept because …"></textarea></div>
    <div class="col-full"><label class="label">Suggested controls (Annex A ids, comma-separated)</label><input class="input" name="suggested_controls" placeholder="annex-a.5.16, annex-a.8.5"></div>
    <div class="col-full"><label class="label">Tags</label><input class="input" name="tags" placeholder="cloud, byod, fintech-only"></div>
    <div class="col-full"><button class="btn btn-primary">Save</button></div>
  </form>
</div><% } %>

<% if (rows.length === 0) { %>
  <div class="panel"><div class="t-empty">No risks match. Adjust the filters or add one.</div></div>
<% } else { %>
  <div class="panel">
    <table class="t">
      <thead><tr>
        <th style="width:160px;">Domain</th>
        <th>Title</th>
        <th style="width:90px;">Sector</th>
        <th style="width:60px;">L</th>
        <th style="width:60px;">I</th>
        <th style="width:80px;"></th>
      </tr></thead>
      <tbody>
        <% rows.forEach(r => { %>
          <tr>
            <td class="meta text-sm"><%= r.domain || '-' %></td>
            <td>
              <details>
                <summary class="text-lg" style="cursor:pointer;font-weight:500;"><%= r.title %></summary>
                <div class="text-md" style="margin-top:8px;padding:10px;background:var(--bg-subtle);border-radius:6px;line-height:1.5;">
                  <% if (r.description) { %><div style="margin-bottom:6px;"><strong>Description:</strong> <%= r.description %></div><% } %>
                  <% if (r.threat) { %><div style="margin-bottom:6px;"><strong>Threat:</strong> <%= r.threat %></div><% } %>
                  <% if (r.vulnerability) { %><div style="margin-bottom:6px;"><strong>Vulnerability:</strong> <%= r.vulnerability %></div><% } %>
                  <% if (r.suggested_treatment) { %><div style="margin-bottom:6px;"><strong>Suggested treatment:</strong> <%= r.suggested_treatment %></div><% } %>
                  <% if (r.suggested_controls) { %><div style="margin-bottom:6px;"><strong>Suggested controls:</strong> <%= r.suggested_controls %></div><% } %>
                  <% if (r.tags) { %><div><strong>Tags:</strong> <%= r.tags %></div><% } %>
                </div>
              </details>
            </td>
            <td><% if (r.sector) { %><span class="tag tag-info text-xxs"><%= r.sector %></span><% } else { %><span class="meta">-</span><% } %></td>
            <td class="num meta"><%= r.suggested_likelihood || '-' %></td>
            <td class="num meta"><%= r.suggested_impact || '-' %></td>
            <td>
              <% if (canManage) { %>
              <form method="POST" action="/firm/library/risks/<%= r.id %>/delete" style="display:inline;" onsubmit="return appConfirmForm(event, 'Delete this firm-library risk?');">
                <button class="btn btn-ghost btn-xs text-danger text-xs">Delete</button>
              </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('partials/footer') %>
