        <span><span style="display:inline-block;width:12px;height:10px;background:#b91c1c;border-radius:2px;vertical-align:middle;"></span> Not impl.</span>
        <span><span style="display:inline-block;width:12px;height:10px;background:#cbd5e1;border-radius:2px;vertical-align:middle;"></span> Excluded / N/A</span>
        <span><span style="display:inline-block;width:12px;height:10px;background:#e5e7eb;border-radius:2px;vertical-align:middle;"></span> Not assessed</span>
