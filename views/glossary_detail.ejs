<%- include('partials/header', { title: entry.term, user, ws, active: 'glossary' }) %>

<div class="page-head">
  <div>
    <div class="text-sm text-tertiary" style="margin-bottom:4px;">
      <a href="/glossary" class="link-muted">Glossary</a> &nbsp;›&nbsp; <%= categoryLabel %>
    </div>
    <h1 class="page-title"><%= entry.term %></h1>
    <% if (entry.aliases && entry.aliases.length) { %>
      <div style="margin-top:6px;display:flex;flex-wrap:wrap;gap:6px;align-items:center;">
        <span class="meta text-sm">Also known as:</span>
        <% entry.aliases.forEach(a => { %>
          <span class="tag tag-neutral text-xs" style="font-family:ui-monospace,monospace;"><%= a %></span>
        <% }) %>
      </div>
    <% } %>
  </div>
  <a href="/glossary" class="btn btn-secondary btn-xs">← All terms</a>
</div>

<div style="display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:16px;">
  <div style="display:flex;flex-direction:column;gap:14px;">

    <% if (entry.plain) { %>
      <div class="callout">
        <div class="callout-title">In plain English</div>
        <div><%= entry.plain %></div>
      </div>
    <% } %>

    <div class="panel">
      <div class="panel-head"><h3>Definition</h3></div>
      <div class="panel-pad" style="font-size:13.5px;line-height:1.55;">
        <%= entry.definition %>
      </div>
    </div>

    <% if (entry.example) { %>
      <div class="panel">
        <div class="panel-head"><h3>Example</h3></div>
        <div class="panel-pad" style="font-size:13.5px;line-height:1.55;background:var(--bg-subtle);">
          <%= entry.example %>
        </div>
      </div>
    <% } %>

    <% if (entry.notToConfuseWith && entry.notToConfuseWith.length) { %>
      <div class="panel">
        <div class="panel-head"><h3>Not to be confused with</h3></div>
        <div class="divide-row">
          <% entry.notToConfuseWith.forEach(c => { %>
            <div style="padding:14px 18px;">
              <div class="text-lg text-ink" style="font-weight: 500;margin-bottom:4px;"><%= c.term %></div>
              <div class="text-lg text-secondary" style="line-height:1.5;"><%= c.why %></div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>

  <aside style="display:flex;flex-direction:column;gap:14px;">

    <div class="panel">
      <div class="panel-pad" style="display:flex;flex-direction:column;gap:10px;">
        <div>
          <div class="sec-label">Category</div>
          <a href="/glossary?category=<%= entry.category %>" class="tag tag-info text-sm" style="text-decoration:none;"><%= categoryLabel %></a>
        </div>
        <% if (entry.clauseRef) { %>
          <div>
            <div class="sec-label">ISO 27001 reference</div>
            <div class="text-base" style="font-family:ui-monospace,monospace;background:var(--bg-muted);padding:4px 8px;border-radius:4px;display:inline-block;"><% if (typeof renderClauseRef === 'function') { %><%- renderClauseRef(entry.clauseRef) %><% } else { %><%= entry.clauseRef %><% } %></div>
          </div>
        <% } %>
      </div>
    </div>

    <% if (related && related.length) { %>
      <div class="panel">
        <div class="panel-head"><h3>Related terms</h3></div>
        <div class="divide-row">
          <% related.forEach(r => { %>
            <a href="/glossary/<%= r.slug %>" style="display:block;padding:10px 16px;text-decoration:none;">
              <div class="text-lg" style="font-weight:500;"><%= r.term %></div>
              <% if (r.plain) { %>
                <div class="text-sm text-tertiary" style="margin-top:2px;line-height:1.4;"><%= r.plain.length > 90 ? r.plain.slice(0, 90) + '…' : r.plain %></div>
              <% } %>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

  </aside>
</div>

<%- include('partials/footer') %>
