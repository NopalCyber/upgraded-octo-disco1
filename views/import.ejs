<%- include('partials/header', { title: 'Import ' + kind, user, ws, active: kind }) %>

<%
  const isAsset = kind === 'assets';
  const titleSingular = schema.singular;
  const titlePlural = schema.plural;
  const requiredFields = schema.fields.filter(f => f.required);
  const optionalFields = schema.fields.filter(f => !f.required);
%>

<style>
  .dropzone {
    display: block;
    border: 2px dashed var(--border-strong);
    border-radius: 12px;
    padding: 48px 24px;
    text-align: center;
    background: var(--bg);
    transition: all 0.15s ease;
    cursor: pointer;
  }
  .dropzone:hover { border-color: var(--accent); background: var(--accent-soft); }
  .dropzone.is-dragover { border-color: var(--accent); background: var(--accent-soft); transform: scale(1.005); }
  .csv-file-input {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
  .dropzone-icon { width: 48px; height: 48px; margin: 0 auto 12px; border-radius: 12px; background: var(--bg-muted); display: inline-flex; align-items: center; justify-content: center; color: var(--text-tertiary); }
  .dropzone:hover .dropzone-icon, .dropzone.is-dragover .dropzone-icon { background: var(--accent); color: #fff; }
  .dropzone-title { font-size: 15px; font-weight: 500; color: var(--ink); margin-bottom: 4px; letter-spacing: -0.01em; }
  .dropzone-sub { font-size: 13px; color: var(--text-secondary); }
  .dropzone-meta { font-size: 11.5px; color: var(--text-tertiary); margin-top: 14px; }
  .dropzone-filename { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; background: var(--bg-muted); border-radius: 999px; font-size: 12.5px; font-weight: 500; color: var(--text); margin-top: 12px; }

  .col-doc-row { display: grid; grid-template-columns: 180px 1fr 100px; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--border); align-items: start; }
  .col-doc-row:last-child { border-bottom: none; }
  .col-doc-name { font-size: 13px; font-weight: 500; color: var(--ink); display: flex; align-items: center; gap: 6px; }
  .col-doc-syn { font-size: 11.5px; color: var(--text-tertiary); font-family: ui-monospace, monospace; margin-top: 2px; }
  .col-doc-hint { font-size: 12px; color: var(--text-secondary); line-height: 1.5; }
  .col-doc-hint code { font-family: ui-monospace, monospace; font-size: 11.5px; padding: 1px 5px; background: var(--bg-muted); border-radius: 3px; color: var(--text); }
  .col-doc-type { font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-tertiary); text-align: right; padding-top: 2px; }

  .preview-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 16px; }
  .preview-tile { padding: 14px 16px; border-radius: 8px; background: var(--bg); border: 1px solid var(--border); }
  .preview-num { font-size: 26px; font-weight: 500; line-height: 1.1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .preview-tile.t-good .preview-num { color: #15803d; }
  .preview-tile.t-warn .preview-num { color: #b45309; }
  .preview-tile.t-bad .preview-num { color: #b91c1c; }
  .preview-label { font-size: 11.5px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-secondary); margin-top: 4px; }
  .preview-meta { font-size: 11px; color: var(--text-tertiary); margin-top: 4px; }

  .row-issue { display: flex; align-items: flex-start; gap: 6px; font-size: 11.5px; line-height: 1.5; }
  .row-issue-dot { width: 5px; height: 5px; border-radius: 50%; margin-top: 6px; flex-shrink: 0; }
  .row-issue.err { color: #b91c1c; }
  .row-issue.err .row-issue-dot { background: #dc2626; }
  .row-issue.warn { color: #b45309; }
  .row-issue.warn .row-issue-dot { background: #ca8a04; }
</style>

<div class="page-head">
  <div>
    <h1 class="page-title">Import <%= titlePlural %> from CSV</h1>
    <div class="page-subtitle">
      <% if (isAsset) { %>
        Bulk-load the asset register from a spreadsheet. We validate every row before anything is written - skipped rows are listed so you can fix and re-upload.
      <% } else { %>
        Bulk-load the risk register from a spreadsheet. Likelihood and impact are validated against your active methodology; asset names resolve to existing assets in this client.
      <% } %>
    </div>
  </div>
  <a href="<%= backUrl %>" class="btn btn-ghost btn-xs">← Back to <%= titlePlural %></a>
</div>

<% if (mode === 'upload') { %>

  <div class="panel" style="margin-bottom:16px;">
    <div class="panel-pad">
      <form method="POST" action="<%= previewUrl %>" enctype="multipart/form-data" id="csvForm">
        <label class="dropzone" id="dropzone" for="csvFile">
          <div class="dropzone-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          </div>
          <div class="dropzone-title">Drop your CSV here, or click to choose</div>
          <div class="dropzone-sub">Headers in the first row · UTF-8 · up to 5 MB</div>
          <div class="dropzone-meta">Tip: the template below has the exact column names we recognise.</div>
          <div id="filenameTag" class="dropzone-filename" style="display:none;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <span id="filenameText"></span>
          </div>
        </label>
        <input type="file" name="file" accept=".csv,text/csv" id="csvFile" class="csv-file-input">
        <noscript><div class="meta text-md" style="margin-top:8px;">JavaScript required for drag-and-drop. The picker still works above.</div></noscript>

        <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:18px;">
          <a href="<%= templateUrl %>" class="btn btn-secondary btn-xs">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download CSV template
          </a>
          <button type="submit" class="btn btn-primary" id="uploadBtn" disabled>Preview rows →</button>
        </div>
      </form>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head">
      <h2>Column reference</h2>
      <span class="meta text-xs"><%= requiredFields.length %> required · <%= optionalFields.length %> optional</span>
    </div>
    <div class="panel-pad">
      <div class="text-md text-secondary" style="margin-bottom:12px;">
        Header names are matched case-insensitively against the synonyms below. Unknown columns are ignored, not an error.
      </div>

      <% if (requiredFields.length) { %>
        <div class="text-eyebrow text-secondary" style="margin-bottom:6px;">Required</div>
        <% requiredFields.forEach(f => { %>
          <div class="col-doc-row">
            <div>
              <div class="col-doc-name"><%= f.label %> <span class="tag tag-danger" style="font-size:9.5px;">required</span></div>
              <div class="col-doc-syn">Also: <%= (f.synonyms || []).slice(0, 3).join(', ') %></div>
            </div>
            <div class="col-doc-hint">
              <%
                let hint = '';
                if (f.type === 'string') hint = 'Free text.';
                else if (f.type === 'enum') hint = 'Allowed values: ' + f.values.map(v => '<code>' + v + '</code>').join(', ');
                else if (f.type === 'intRange') hint = 'Whole number ' + (f.min !== undefined ? f.min : '') + (f.max !== undefined ? '–' + f.max : '') + '.';
                else if (f.type === 'methodologyScale') hint = 'Whole number in the active methodology scale.';
                else if (f.type === 'assetRef') hint = 'Asset name, must already exist in this client.';
              %>
              <%- hint %>
            </div>
            <div class="col-doc-type"><%= f.type === 'intRange' || f.type === 'methodologyScale' ? 'Number' : f.type === 'enum' ? 'Enum' : 'Text' %></div>
          </div>
        <% }) %>
      <% } %>

      <% if (optionalFields.length) { %>
        <div class="text-eyebrow text-secondary" style="margin-top:18px;margin-bottom:6px;">Optional</div>
        <% optionalFields.forEach(f => { %>
          <div class="col-doc-row">
            <div>
              <div class="col-doc-name"><%= f.label %></div>
              <div class="col-doc-syn">Also: <%= (f.synonyms || []).slice(0, 3).join(', ') %></div>
            </div>
            <div class="col-doc-hint">
              <%
                let hint = '';
                if (f.type === 'string') hint = 'Free text.';
                else if (f.type === 'enum') hint = 'Allowed values: ' + f.values.map(v => '<code>' + v + '</code>').join(', ');
                else if (f.type === 'intRange') hint = 'Whole number ' + (f.min !== undefined ? f.min : '') + (f.max !== undefined ? '–' + f.max : '') + (f.default !== undefined ? ' (defaults to ' + f.default + ')' : '') + '.';
                else if (f.type === 'methodologyScale' && typeof methodology !== 'undefined') {
                  const sc = methodology[f.scale + '_scale'];
                  hint = 'Whole number from <code>' + sc[0].value + '</code> to <code>' + sc[sc.length-1].value + '</code> (active methodology: ' + methodology.name + ').';
                } else if (f.type === 'methodologyScale') hint = 'Whole number in the active methodology scale.';
                else if (f.type === 'assetRef') hint = 'Asset name from this client - matched case-insensitively. Leave blank if not asset-linked. A name that does not match an existing asset is allowed; we surface a warning and create the risk unlinked.';
              %>
              <%- hint %>
            </div>
            <div class="col-doc-type"><%= f.type === 'intRange' || f.type === 'methodologyScale' ? 'Number' : f.type === 'enum' ? 'Enum' : 'Text' %></div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <script>
    (function() {
      const dz = document.getElementById('dropzone');
      const input = document.getElementById('csvFile');
      const btn = document.getElementById('uploadBtn');
      const tag = document.getElementById('filenameTag');
      const tagText = document.getElementById('filenameText');
      function setFile(file) {
        if (!file) return;
        const dt = new DataTransfer();
        dt.items.add(file);
        input.files = dt.files;
        tagText.textContent = file.name + ' · ' + (file.size < 1024 ? file.size + ' B' : (file.size/1024).toFixed(1) + ' KB');
        tag.style.display = 'inline-flex';
        btn.disabled = false;
      }
      input.addEventListener('change', () => { if (input.files[0]) setFile(input.files[0]); });
      ['dragenter','dragover'].forEach(ev => dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.add('is-dragover'); }));
      ['dragleave','drop'].forEach(ev => dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.remove('is-dragover'); }));
      dz.addEventListener('drop', e => { const f = e.dataTransfer && e.dataTransfer.files[0]; if (f) setFile(f); });
    })();
  </script>

<% } else if (mode === 'preview') { %>

  <%
    const total = result.summary.total;
    const valid = result.summary.valid;
    const invalid = result.summary.invalid;
    const warns = result.summary.withWarnings;
    const blockedByHeaders = result.headerErrors.length > 0;
  %>

  <div class="panel" style="margin-bottom:16px;">
    <div class="panel-pad" style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
      <div>
        <div class="text-eyebrow text-tertiary" style="margin-bottom:4px;">Preview</div>
        <div style="font-size:15px;font-weight: 500;color:var(--ink);">
          <%= filename %>
          <span class="meta text-md" style="margin-left:8px;font-weight:400;"><%= total %> row<%= total === 1 ? '' : 's' %> parsed</span>
        </div>
      </div>
      <div class="row">
        <a href="<%= importUrl %>" class="btn btn-ghost btn-xs">← Upload different file</a>
        <% if (!blockedByHeaders && valid > 0) { %>
          <form method="POST" action="<%= commitUrl %>" style="display:inline;" onsubmit="return appConfirmForm(event, 'Import <%= valid %> <%= valid === 1 ? titleSingular : titlePlural %><%= invalid ? ' and skip ' + invalid + ' invalid row' + (invalid === 1 ? '' : 's') : '' %>?');">
            <input type="hidden" name="csv" value="<%= csv %>">
            <button class="btn btn-primary">Import <%= valid %> <%= valid === 1 ? titleSingular : titlePlural %></button>
          </form>
        <% } %>
      </div>
    </div>
  </div>

  <% if (blockedByHeaders) { %>
    <div class="panel" style="margin-bottom:16px;background:rgba(220,38,38,0.04);">
      <div class="panel-pad">
        <div class="text-danger fw-bold" style="font-size:13.5px;margin-bottom:8px;">Fix the header row before importing</div>
        <% result.headerErrors.forEach(e => { %>
          <div class="row-issue err" style="margin-bottom:4px;"><span class="row-issue-dot"></span><span><%= e %></span></div>
        <% }) %>
        <div class="meta text-md" style="margin-top:10px;">Open the file in Excel or a text editor, fix the header row, and upload again. The CSV template above has the canonical names.</div>
      </div>
    </div>
  <% } %>

  <div class="preview-summary">
    <div class="preview-tile <%= valid > 0 ? 't-good' : 't-bad' %>">
      <div class="preview-num"><%= valid %></div>
      <div class="preview-label">Valid rows</div>
      <div class="preview-meta">Will be imported on commit</div>
    </div>
    <div class="preview-tile <%= invalid > 0 ? 't-bad' : '' %>">
      <div class="preview-num"><%= invalid %></div>
      <div class="preview-label">Need fixing</div>
      <div class="preview-meta"><%= invalid > 0 ? 'Skipped - see errors below' : 'No errors' %></div>
    </div>
    <div class="preview-tile <%= warns > 0 ? 't-warn' : '' %>">
      <div class="preview-num"><%= warns %></div>
      <div class="preview-label">With warnings</div>
      <div class="preview-meta"><%= warns > 0 ? 'Imported, but review the warnings' : 'No warnings' %></div>
    </div>
  </div>

  <% if (result.unknownHeaders && result.unknownHeaders.length) { %>
    <div class="panel" style="margin-bottom:16px;">
      <div class="panel-pad" style="display:flex;align-items:flex-start;gap:10px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#b45309" stroke-width="2" style="flex-shrink:0;margin-top:1px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <div>
          <div style="font-size:13px;font-weight: 500;color:var(--ink);margin-bottom:2px;">Unknown columns ignored</div>
          <div class="meta text-md">
            The following columns are not recognised and will be skipped: <strong><%= result.unknownHeaders.join(', ') %></strong>. Rename them to match the column reference if you want them imported.
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <% if (total === 0 && !blockedByHeaders) { %>
    <div class="panel">
      <div class="empty-state">
        <div class="empty-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/></svg>
        </div>
        <div class="empty-title">No data rows found</div>
        <div class="empty-sub">The file has a header row but no data rows underneath. Add at least one row and re-upload.</div>
        <a href="<%= importUrl %>" class="btn btn-secondary">Upload again</a>
      </div>
    </div>
  <% } else if (total > 0) { %>
    <div class="panel">
      <div class="panel-head">
        <h2>Row-by-row preview</h2>
        <span class="meta text-xs">Line numbers match the CSV file (header = line 1)</span>
      </div>
      <table class="t">
        <thead><tr>
          <th style="width:56px;">Line</th>
          <th style="width:88px;">Status</th>
          <% if (isAsset) { %>
            <th>Name</th>
            <th style="width:110px;">Type</th>
            <th style="width:130px;">Classification</th>
            <th style="width:120px;">Owner</th>
            <th style="width:72px;">CIA</th>
            <th>Issues</th>
          <% } else { %>
            <th>Title</th>
            <th style="width:130px;">Asset</th>
            <th style="width:88px;">L · I</th>
            <th style="width:100px;">Treatment</th>
            <th style="width:120px;">Owner</th>
            <th>Issues</th>
          <% } %>
        </tr></thead>
        <tbody>
          <% result.rows.forEach(r => {
               const p = r.parsed;
               const status = r.valid ? (r.warnings.length ? 'warn' : 'ok') : 'err';
          %>
            <tr>
              <td class="mono meta"><%= r.index %></td>
              <td>
                <% if (status === 'ok') { %>
                  <span class="status s-implemented">Valid</span>
                <% } else if (status === 'warn') { %>
                  <span class="status s-partial">Warning</span>
                <% } else { %>
                  <span class="status s-open">Skipped</span>
                <% } %>
              </td>
              <% if (isAsset) { %>
                <td style="font-weight:500;"><%= p.name || '-' %></td>
                <td class="text-secondary text-base" style="text-transform:capitalize;"><%= p.type || '-' %></td>
                <td><% if (p.classification) { %><span class="tag <%= p.classification === 'restricted' ? 'tag-danger' : p.classification === 'confidential' ? 'tag-warn' : p.classification === 'internal' ? 'tag-info' : 'tag-neutral' %>"><%= p.classification %></span><% } else { %><span class="meta">-</span><% } %></td>
                <td class="text-secondary text-base"><%= p.owner_name || '-' %></td>
                <td class="num meta"><%= p.cia_c != null ? p.cia_c : '·' %>·<%= p.cia_i != null ? p.cia_i : '·' %>·<%= p.cia_a != null ? p.cia_a : '·' %></td>
              <% } else { %>
                <td style="font-weight:500;"><%= p.title || '-' %></td>
                <td class="text-secondary text-base">
                  <% if (p.asset_label) { %><%= p.asset_label %><% } else if (p.asset == null && r.raw && Object.keys(r.raw).length) {
                       const rawAsset = Object.keys(r.raw).map(k => k.toLowerCase().includes('asset') ? r.raw[k] : null).filter(Boolean)[0];
                  %><span class="meta"><%= rawAsset || '-' %></span><% } else { %><span class="meta">-</span><% } %>
                </td>
                <td class="num meta"><%= p.likelihood != null ? p.likelihood : '·' %> · <%= p.impact != null ? p.impact : '·' %></td>
                <td class="text-secondary text-base" style="text-transform:capitalize;"><%= p.treatment || 'modify' %></td>
                <td class="text-secondary text-base"><%= p.owner_name || '-' %></td>
              <% } %>
              <td>
                <% if (r.errors.length === 0 && r.warnings.length === 0) { %>
                  <span class="meta text-md">No issues</span>
                <% } else { %>
                  <% r.errors.forEach(e => { %>
                    <div class="row-issue err"><span class="row-issue-dot"></span><span><%= e %></span></div>
                  <% }) %>
                  <% r.warnings.forEach(w => { %>
                    <div class="row-issue warn"><span class="row-issue-dot"></span><span><%= w %></span></div>
                  <% }) %>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

<% } %>

<%- include('partials/footer') %>
