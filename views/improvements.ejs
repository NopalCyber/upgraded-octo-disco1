<%- include('partials/header', { title: 'Continual improvement', user, ws, active: 'improvements' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">Continual improvement register</h1>
    <div class="page-subtitle">Improvement actions driven by data (audit findings, MRM outputs, monitoring trends, lessons learned). Distinct from corrective actions on NCs - these are the "we noticed something we should be doing better" items required by clause 10.1.</div>
  </div>
  <div class="row-center">
    <a href="/workspaces/<%= ws.id %>/nonconformities" class="btn btn-secondary btn-xs" title="Nonconformities + corrective action (clause 10.2) - the corrective half of clause 10.">← Nonconformities</a>
    <a href="?filter=open" class="btn <%= filter === 'open' ? 'btn-primary' : 'btn-secondary' %> btn-xs">Open</a>
    <a href="?filter=all" class="btn <%= filter === 'all' ? 'btn-primary' : 'btn-secondary' %> btn-xs">All</a>
  </div>
</div>

<div class="panel" style="margin-bottom:14px;">
  <div class="panel-head"><h2>Add improvement</h2></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/improvements" class="panel-pad" style="display:grid;grid-template-columns:2fr 130px 130px 130px 130px auto;gap:8px;align-items:end;">
    <div><label class="label">Title</label><input class="input" name="title" required placeholder="e.g., Move quarterly access reviews to monthly cadence"></div>
    <div>
      <label class="label">Source</label>
      <select class="select" name="source">
        <option value="">-</option>
        <option value="audit">Audit finding</option>
        <option value="mrm">MRM output</option>
        <option value="monitoring">Monitoring data</option>
        <option value="incident">Incident lesson</option>
        <option value="ad-hoc">Ad-hoc</option>
      </select>
    </div>
    <div><label class="label">Source ref</label><input class="input" name="source_ref" placeholder="e.g., A-2026-Q1"></div>
    <div><label class="label">Owner</label><input class="input" name="owner_name"></div>
    <div><label class="label">Due</label><input class="input" type="date" name="due_date"></div>
    <div><button class="btn btn-primary btn-xs">Add</button></div>
  </form>
</div>

<div class="panel">
  <div class="panel-head">
    <h2><%= items.length %> improvement<%= items.length === 1 ? '' : 's' %></h2>
  </div>
  <% if (items.length === 0) { %>
    <div class="panel-pad meta text-md">
      No improvements logged yet. ISO 27001 clause 10.1 requires the ISMS to be continually improved - track every "we should do this better" item here so the register tells the story.
    </div>
  <% } else { %>
    <table class="t">
      <thead><tr>
        <th>Title</th>
        <th style="width:120px;">Source</th>
        <th style="width:130px;">Owner</th>
        <th style="width:120px;">Due</th>
        <th style="width:130px;">Status</th>
        <th style="width:50px;"></th>
      </tr></thead>
      <tbody>
        <% items.forEach(i => {
             const today = new Date().toISOString().slice(0,10);
             const overdue = i.due_date && i.due_date < today && i.status !== 'done' && i.status !== 'cancelled';
             const statusColor = i.status === 'done' ? '#16a34a' : i.status === 'in_progress' ? '#a16207' : i.status === 'cancelled' ? 'var(--text-tertiary)' : '#0891b2';
        %>
          <form method="POST" action="/workspaces/<%= ws.id %>/improvements/<%= i.id %>" class="contents">
            <tr>
              <td><input type="text" name="title" value="<%= i.title %>" class="input text-md" style="width:100%;" required></td>
              <td>
                <select name="source" class="select text-base">
                  <% ['','audit','mrm','monitoring','incident','ad-hoc'].forEach(s => { %>
                    <option value="<%= s %>" <%= i.source === s ? 'selected' : '' %>><%= s || '-' %></option>
                  <% }) %>
                </select>
              </td>
              <td><input type="text" name="owner_name" value="<%= i.owner_name || '' %>" class="input text-base"></td>
              <td><input type="date" name="due_date" value="<%= i.due_date || '' %>" class="input" style="font-size:11.5px;<%= overdue ? 'border-color:#b91c1c;color:#b91c1c;' : '' %>"></td>
              <td>
                <select name="status" class="select" style="font-size:12px;color:<%= statusColor %>;font-weight: 500;">
                  <% ['open','in_progress','done','cancelled'].forEach(s => { %>
                    <option value="<%= s %>" <%= i.status === s ? 'selected' : '' %>><%= s.replace('_',' ') %></option>
                  <% }) %>
                </select>
              </td>
              <td><button class="btn btn-ghost btn-xs text-xs">Save</button></td>
            </tr>
            <% if (i.description || i.impact_notes || i.source_ref) { %>
              <tr><td colspan="6" class="meta text-sm" style="padding:0 14px 6px 14px;line-height:1.5;border-bottom:1px solid var(--border);">
                <% if (i.source_ref) { %><span class="mono text-eyebrow">@<%= i.source_ref %></span> · <% } %>
                <% if (i.description) { %><%= i.description %><% } %>
                <% if (i.impact_notes) { %> · <strong>Impact:</strong> <%= i.impact_notes %><% } %>
              </td></tr>
            <% } %>
          </form>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<% if (typeof pg !== 'undefined' && pg) { %><%- include('partials/pager', { pg, pagerHref }) %><% } %>

<%- include('partials/footer') %>
