<%- include('partials/header', { title: inc.title, user, ws, active: 'incidents' }) %>

<a href="/workspaces/<%= ws.id %>/incidents" class="link-muted text-base">← All incidents</a>

<div class="panel" style="margin-top:12px">
  <div class="panel-pad" style="border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:12px;">
    <div>
      <div class="mono meta">INC-<%= String(inc.id).padStart(3,'0') %></div>
      <h1 class="page-title" style="margin-top:2px;"><%= inc.title %></h1>
    </div>
    <div class="row-center">
      <% if (inc.nonconformity_id) { %>
        <a href="/workspaces/<%= ws.id %>/nonconformities/<%= inc.nonconformity_id %>" class="btn btn-secondary btn-xs">→ NC #<%= inc.nonconformity_id %></a>
      <% } else { %>
        <form method="POST" action="/workspaces/<%= ws.id %>/incidents/<%= inc.id %>/promote-nc">
          <button class="btn btn-secondary btn-xs">Promote to NC</button>
        </form>
      <% } %>
      <span class="tag <%= inc.severity === 'critical' || inc.severity === 'high' ? 'tag-danger' : inc.severity === 'medium' ? 'tag-warn' : 'tag-neutral' %>"><%= inc.severity %></span>
      <span class="status s-<%= inc.status === 'closed' ? 'done' : 'open' %>"><%= inc.status %></span>
    </div>
  </div>

  <form method="POST" action="/workspaces/<%= ws.id %>/incidents/<%= inc.id %>" class="panel-pad grid-2">
    <div class="col-full"><label class="label">Title</label><input class="input" name="title" value="<%= inc.title %>" required></div>
    <div><label class="label">Category</label>
      <select class="select" name="category">
        <%- include('partials/register_category_options', { options: categories, selected: inc.category || 'other' }) %>
      </select>
    </div>
    <div><label class="label">Severity</label>
      <select class="select" name="severity">
        <% ['critical','high','medium','low'].forEach(s => { %>
          <option value="<%= s %>" <%= inc.severity === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </div>
    <div><label class="label">Detected at</label><input class="input" type="datetime-local" name="detected_at" value="<%= inc.detected_at ? inc.detected_at.replace(' ','T').substring(0,16) : '' %>"></div>
    <div><label class="label">Reported by</label><input class="input" name="reported_by" value="<%= inc.reported_by || '' %>"></div>
    <div><label class="label">Status</label>
      <select class="select" name="status">
        <% ['open','contained','eradicated','recovered','closed'].forEach(s => { %>
          <option value="<%= s %>" <%= inc.status === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </div>
    <div><label class="label">Affected assets</label><input class="input" name="affected_assets" value="<%= inc.affected_assets || '' %>" placeholder="comma-separated"></div>
    <div class="col-full"><label class="label">Description</label><textarea class="textarea" name="description" rows="3"><%= inc.description || '' %></textarea></div>

    <div class="col-full" style="border-top:1px solid var(--border);padding-top:12px;">
      <div class="sec-label">Response timeline (A.5.26)</div>
    </div>
    <div class="col-full"><label class="label">Containment actions</label><textarea class="textarea" name="containment_actions" rows="2"><%= inc.containment_actions || '' %></textarea></div>
    <div class="col-full"><label class="label">Eradication actions</label><textarea class="textarea" name="eradication_actions" rows="2"><%= inc.eradication_actions || '' %></textarea></div>
    <div class="col-full"><label class="label">Recovery actions</label><textarea class="textarea" name="recovery_actions" rows="2"><%= inc.recovery_actions || '' %></textarea></div>
    <div class="col-full"><label class="label">External notification (regulators, customers, law enforcement)</label><textarea class="textarea" name="external_notification" rows="2"><%= inc.external_notification || '' %></textarea></div>
    <div class="col-full"><label class="label">Lessons learned (A.5.27)</label><textarea class="textarea" name="lessons_learned" rows="3"><%= inc.lessons_learned || '' %></textarea></div>

    <div class="col-full row">
      <button class="btn btn-primary">Save</button>
      <form method="POST" action="/workspaces/<%= ws.id %>/incidents/<%= inc.id %>/delete" onsubmit="return appConfirmForm(event, 'Delete?')" style="display:inline">
        <button class="btn btn-danger">Delete</button>
      </form>
    </div>
  </form>
</div>

<% if (inc.notification_required_by) {
  const remainingMs = new Date(inc.notification_required_by) - new Date();
  const remainingHrs = Math.floor(remainingMs / 3600000);
%>
<div class="callout" style="margin:14px 0;background:<%= remainingHrs < 0 ? 'rgba(220,38,38,0.08)' : remainingHrs < 12 ? 'rgba(202,138,4,0.08)' : 'var(--accent-soft)' %>;border-color:<%= remainingHrs < 0 ? '#dc2626' : remainingHrs < 12 ? '#ca8a04' : 'var(--accent)' %>;">
  <div class="callout-title" style="color:<%= remainingHrs < 0 ? '#b91c1c' : remainingHrs < 12 ? '#a16207' : 'var(--accent-deep)' %>;">
    Regulator notification clock - <%= remainingHrs < 0 ? 'OVERDUE' : remainingHrs + ' hours remaining' %>
  </div>
  Required by: <span class="mono"><%= inc.notification_required_by %></span>
  <% if (inc.notification_sent_at) { %><br>Notified at: <span class="mono"><%= inc.notification_sent_at %></span><% } else { %>
    <form method="POST" action="/workspaces/<%= ws.id %>/incidents/<%= inc.id %>/notify-sent" style="display:inline-block;margin-top:6px;"><button class="btn btn-primary btn-xs">Mark notification sent</button></form>
  <% } %>
</div>
<% } %>

<div class="panel" style="margin-top:14px">
  <div class="panel-head"><h2>Regulator clock</h2><span class="meta">GDPR Art. 33: 72hr · NIS2: 24hr early warning · sector-specific: varies</span></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/incidents/<%= inc.id %>/regulator-clock" class="panel-pad" style="display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:10px;align-items:end;">
    <div><label class="label">Detected at</label><input class="input" type="datetime-local" name="detected_at" value="<%= inc.detected_at ? inc.detected_at.replace(' ','T').substring(0,16) : '' %>"></div>
    <div><label class="label">Regulator</label><select class="select" name="regulator"><option>GDPR DPA</option><option>NIS2 CSIRT</option><option>Sector regulator</option><option>Other</option></select></div>
    <div><label class="label">Hours allowed</label><input class="input num" name="hours" type="number" min="1" value="72"></div>
    <div><button class="btn btn-primary btn-xs">Set clock</button></div>
  </form>
</div>

<div class="panel" style="margin-top:14px">
  <div class="panel-head"><h2>Runbook</h2></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/incidents/<%= inc.id %>/runbook" class="panel-pad" style="display:flex;gap:6px;align-items:end;">
    <div style="flex:1;"><label class="label">Attach a runbook</label>
      <select class="select" name="runbook_id">
        <option value="">- none -</option>
        <% runbooks.forEach(rb => { %><option value="<%= rb.id %>" <%= inc.runbook_id === rb.id ? 'selected' : '' %>><%= rb.name %> (<%= rb.category %>)</option><% }) %>
      </select>
    </div>
    <button class="btn btn-primary btn-xs">Attach</button>
  </form>
  <% if (runbook) { %>
    <div class="panel-pad" style="border-top:1px solid var(--border);">
      <div class="sec-label"><%= runbook.name %></div>
      <ol class="text-lg" style="padding-left:18px;line-height:1.6;">
        <% runbook.steps.forEach(s => { %>
          <li style="margin-bottom:8px;"><span class="tag tag-info text-eyebrow" style="text-transform:uppercase;"><%= s.phase %></span> <strong><%= s.title %></strong><div class="meta" style="margin-top:2px;"><%= s.desc %></div></li>
        <% }) %>
      </ol>
    </div>
  <% } %>
</div>

<div class="panel" style="margin-top:14px">
  <div class="panel-head"><h2>Timeline</h2><span class="meta"><%= events.length %> events</span></div>
  <% events.forEach(ev => { %>
    <div style="padding:8px 16px;border-bottom:1px solid var(--border);display:grid;grid-template-columns:130px 100px 1fr;gap:10px;align-items:start;">
      <div class="meta mono text-sm"><%= ev.event_at %></div>
      <div><span class="tag <%= ev.phase === 'detect' ? 'tag-info' : ev.phase === 'contain' ? 'tag-warn' : ev.phase === 'eradicate' ? 'tag-warn' : ev.phase === 'recover' ? 'tag-success' : 'tag-neutral' %> text-eyebrow" style="text-transform:uppercase;"><%= ev.phase %></span></div>
      <div class="text-lg"><%= ev.description %><% if (ev.actor) { %><div class="meta">by <%= ev.actor %></div><% } %></div>
    </div>
  <% }) %>
  <form method="POST" action="/workspaces/<%= ws.id %>/incidents/<%= inc.id %>/events" class="panel-pad" style="display:grid;grid-template-columns:120px 130px 1fr 130px auto;gap:6px;align-items:end;">
    <div><label class="label">Phase</label><select class="select" name="phase"><% ['detect','contain','eradicate','recover','communicate','lessons'].forEach(p => { %><option><%= p %></option><% }) %></select></div>
    <div><label class="label">When</label><input class="input" type="datetime-local" name="event_at" value=""></div>
    <div><label class="label">Description</label><input class="input" name="description" required></div>
    <div><label class="label">Actor</label><input class="input" name="actor" value="<%= user.name %>"></div>
    <div><button class="btn btn-primary btn-xs">Add</button></div>
  </form>
</div>

<div class="panel" style="margin-top:14px">
  <div class="panel-head"><h2>Post-incident review (A.5.27)</h2></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/incidents/<%= inc.id %>/pir" class="panel-pad">
    <textarea class="textarea" name="pir_summary" rows="4" placeholder="Root cause, control failures, action items, target dates."><%= inc.pir_summary || '' %></textarea>
    <button class="btn btn-primary btn-xs" style="margin-top:8px;"><%= inc.pir_completed ? 'Update' : 'Complete' %> PIR</button>
    <% if (inc.pir_completed) { %><span class="tag tag-success">PIR completed</span><% } %>
  </form>
</div>

<%- include('partials/footer') %>
