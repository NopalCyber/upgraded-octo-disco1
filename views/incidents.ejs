<%- include('partials/header', { title: 'Incidents', user, ws, active: 'incidents' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">Information security incidents</h1>
    <div class="page-subtitle">Per A.5.24–A.5.28: detection, classification, response, recovery, and lessons learned. Promote material incidents to nonconformities.</div>
  </div>
  <div class="row">
    <select onchange="window.location='?filter='+this.value" class="select" style="width:120px">
      <option value="open" <%= filter==='open'?'selected':'' %>>Open</option>
      <option value="all" <%= filter==='all'?'selected':'' %>>All</option>
    </select>
    <button onclick="document.getElementById('newInc').classList.toggle('hidden')" class="btn btn-primary">Log incident</button>
  </div>
</div>

<div id="newInc" class="hidden panel" style="margin-bottom:16px">
  <div class="panel-head"><h2>Log new incident</h2></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/incidents" class="panel-pad grid-2">
    <div class="col-full"><label class="label">Title</label><input class="input" name="title" required placeholder="e.g., Phishing campaign targeting finance team"></div>
    <div><label class="label">Category</label>
      <select class="select" name="category">
        <%- include('partials/register_category_options', { options: categories, selected: 'other' }) %>
      </select>
    </div>
    <div><label class="label">Severity</label>
      <select class="select" name="severity">
        <option value="critical">Critical</option><option value="high">High</option>
        <option value="medium" selected>Medium</option><option value="low">Low</option>
      </select>
    </div>
    <div><label class="label">Detected at</label><input class="input" type="datetime-local" name="detected_at"></div>
    <div><label class="label">Reported by</label><input class="input" name="reported_by"></div>
    <div class="col-full"><label class="label">Description</label><textarea class="textarea" name="description" rows="3" placeholder="What happened, what was observed, initial impact assessment…"></textarea></div>
    <div class="col-full"><button class="btn btn-primary">Log incident</button></div>
  </form>
</div>

<div class="panel" style="overflow:hidden">
  <table class="t">
    <thead><tr>
      <th style="width:80px">ID</th><th>Title</th><th style="width:140px">Category</th>
      <th style="width:100px">Severity</th><th style="width:160px">Detected</th><th style="width:130px">Status</th>
    </tr></thead>
    <tbody>
      <% incidents.forEach(n => { %>
        <tr>
          <td class="mono meta">INC-<%= String(n.id).padStart(3,'0') %></td>
          <td><a href="/workspaces/<%= ws.id %>/incidents/<%= n.id %>" class="link-muted" style="font-weight:500;"><%= n.title %></a></td>
          <td class="text-secondary text-base"><%= categoryLabel(n.category) %></td>
          <td><span class="tag <%= n.severity === 'critical' || n.severity === 'high' ? 'tag-danger' : n.severity === 'medium' ? 'tag-warn' : 'tag-neutral' %>"><%= n.severity %></span></td>
          <td class="num meta"><%= n.detected_at || '-' %></td>
          <td><span class="status s-<%= n.status === 'closed' ? 'done' : 'open' %>"><%= n.status %></span></td>
        </tr>
      <% }) %>
      <% if (incidents.length === 0) { %>
        <tr><td colspan="6" style="padding:0;">
          <div class="empty-state">
            <div class="empty-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
            <div class="empty-title">No incidents logged</div>
            <div class="empty-sub">A.5.24–A.5.28 require a consistent approach to incident management. Log events as they occur to build the audit trail.</div>
            <button onclick="document.getElementById('newInc').classList.toggle('hidden')" class="btn btn-primary">Log incident</button>
          </div>
        </td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<% if (typeof pg !== 'undefined' && pg) { %><%- include('partials/pager', { pg, pagerHref }) %><% } %>

<%- include('partials/footer') %>
