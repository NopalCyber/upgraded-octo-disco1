<%- include('partials/header', { title: 'Performance & objectives', user, ws, active: 'metrics-library' }) %>
<%
  const ragColor = r => r === 'green' ? '#15803d' : r === 'amber' ? '#b45309' : r === 'red' ? '#b91c1c' : '#52525b';
  const ragLabel = r => r === 'green' ? 'On target' : r === 'amber' ? 'Near target' : r === 'red' ? 'Off target' : 'No data';
  const fmt = v => v == null ? '-' : (Math.round(v * 100) / 100).toString();
  const unitSuffix = (v, u) => v == null ? '' : (u === '%' ? '%' : u === 'days' ? ' d' : '');
%>

<div class="page-head">
  <div>
    <div class="eyebrow">Performance &amp; objectives</div>
    <h1 class="page-title">Measures</h1>
    <div class="page-subtitle">Governed ISO 27004 measures, their latest readings and the objectives they drive.</div>
  </div>
  <a href="/workspaces/<%= ws.id %>/metrics/library" class="btn btn-secondary btn-xs">Browse library →</a>
</div>

<%- include('partials/metric_tabs', { ws, active: 'adopted' }) %>

<% if (total === 0) { %>
  <div class="panel" style="margin-bottom:14px;">
    <div class="panel-pad" style="text-align:center;padding:40px 16px;">
      <div style="font-size:14px;font-weight:500;margin-bottom:4px;">No measures adopted yet</div>
      <div class="meta" style="margin-bottom:14px;">Adopt measures from the ISO/IEC 27004 Annex B catalog to start a measurement programme.</div>
      <a href="/workspaces/<%= ws.id %>/metrics/library" class="btn btn-primary btn-xs">Browse the measure library →</a>
    </div>
  </div>
<% } else { %>
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px;">
    <div class="panel kpi"><div class="kpi-label text-eyebrow">Adopted measures</div><div class="kpi-num"><%= total %></div></div>
    <div class="panel kpi"><div class="kpi-label text-eyebrow">On target</div><div class="kpi-num" style="color:#15803d;"><%= ragCounts.green %></div></div>
    <div class="panel kpi"><div class="kpi-label text-eyebrow">Near / off target</div><div class="kpi-num" style="color:#b45309;"><%= ragCounts.amber %><span class="text-xl text-tertiary" style="font-weight:400;"> / </span><span style="color:#b91c1c;"><%= ragCounts.red %></span></div></div>
    <div class="panel kpi"><div class="kpi-label text-eyebrow">Awaiting data</div><div class="kpi-num" style="color:#52525b;"><%= ragCounts.none %></div></div>
  </div>

  <% if (upcomingMrms && upcomingMrms.length > 0) { %>
    <div class="panel" style="margin-bottom:14px;">
      <div class="panel-head"><h2>Feed into management review</h2><span class="meta">clause 9.3.2 c) · performance &amp; effectiveness</span></div>
      <div class="panel-pad">
        <div class="text-base" style="margin-bottom:10px;line-height:1.5;">Append these adopted measures, with their latest readings and targets, into a management review record, alongside auto-computed ISMS KPIs (control coverage, training, incidents, audits).</div>
        <div style="display:flex;gap:6px;flex-wrap:wrap;">
          <% upcomingMrms.forEach(mr => { %>
            <form method="POST" action="/workspaces/<%= ws.id %>/metrics/feed-to-mrm/<%= mr.id %>" style="display:inline;">
              <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
              <button class="btn btn-secondary btn-xs">Feed to MRM <%= mr.meeting_date || '(no date)' %> →</button>
            </form>
          <% }) %>
        </div>
      </div>
    </div>
  <% } %>

  <% categories.forEach(cat => { %>
    <div class="panel" style="margin-bottom:14px;">
      <div class="panel-head"><h2><%= cat %></h2><span class="meta"><%= byCategory[cat].length %></span></div>
      <table class="t">
        <thead>
          <tr>
            <th style="width:34%;">Measure</th>
            <th>Latest</th>
            <th>Target</th>
            <th>Status</th>
            <th>Frequency</th>
            <th>Objectives</th>
            <th>Readings</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% byCategory[cat].forEach(m => { %>
            <tr>
              <td>
                <a href="/workspaces/<%= ws.id %>/metrics/adopted/<%= m.id %>" class="link"><%= m.name %></a>
                <div class="meta text-xs"><%= m.ref %> · <%= m.unit %><%= m.direction === 'lower' ? ' · lower is better' : '' %></div>
              </td>
              <td style="font-weight:500;" class="num">
                <% if (m.latest_value == null) { %><span class="meta">-</span><% } else { %><%= fmt(m.latest_value) %><%= unitSuffix(m.latest_value, m.unit) %><div class="meta text-xs"><%= m.latest_at %></div><% } %>
              </td>
              <td class="num"><% if (m.target_value == null) { %><span class="meta">not set</span><% } else { %><%= fmt(m.target_value) + unitSuffix(m.target_value, m.unit) %><% } %></td>
              <td><span class="status" style="color:<%= ragColor(m.rag) %>;"><%= ragLabel(m.rag) %></span></td>
              <td class="meta text-base"><%= m.frequency || '-' %></td>
              <td class="num"><%= m.objective_count %></td>
              <td class="num"><%= m.reading_count %></td>
              <td style="white-space:nowrap;text-align:right;">
                <a href="/workspaces/<%= ws.id %>/metrics/adopted/<%= m.id %>" class="link-muted text-base">Open</a>
                <% if (m.objective_count) { %><span class="meta text-xs" style="margin-left:10px">In use</span><% } else { %><form method="POST" action="/workspaces/<%= ws.id %>/metrics/adopted/<%= m.id %>/delete" onsubmit="return confirm('Remove <%= m.name.replace(/'/g, "\\'") %> and its readings from this engagement?');" style="display:inline;margin-left:10px;">
                  <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
                  <button type="submit" class="text-base" title="Remove from engagement" style="background:none;border:none;padding:0;cursor:pointer;color:#b91c1c;font-family:inherit;">Remove</button>
                </form><% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% }) %>
<% } %>

<%- include('partials/footer') %>
