<%- include('partials/header', { title: 'Management review', user, ws, active: 'mrms' }) %>

<style>
  .pre932 {
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-subtle);
    margin-top: 6px;
  }
  .pre932-row {
    display: grid; grid-template-columns: 160px 1fr;
    gap: 14px; padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }
  .pre932-row:last-child { border-bottom: none; }
  .pre932-label {
    font-size: 11px; font-weight: 500;
    color: var(--text-secondary);
    letter-spacing: 0.04em; text-transform: uppercase;
  }
  .pre932-label .clause {
    display: block; font-size: 9.5px;
    color: var(--text-tertiary); font-weight: 500;
    letter-spacing: 0.06em; margin-top: 2px;
  }
  .pre932-value {
    font-size: 12px; line-height: 1.55; color: var(--text);
    white-space: pre-wrap; font-variant-numeric: tabular-nums;
    max-height: 5.5em; overflow: hidden;
    position: relative;
  }
  .pre932-value::after {
    display: none;
  }
  .mrm-register { overflow-x: auto; }
  .mrm-register table { min-width: 650px; }
  .mrm-register table.t tbody td { padding: 0; vertical-align: middle; }
  .mrm-record-link {
    display: flex; align-items: center; min-height: 46px;
    padding: 8px 14px; color: inherit; text-decoration: none;
  }
  .mrm-record-link:hover { color: inherit; text-decoration: none; }
  .mrm-record-link.attendees { color: var(--text-secondary); line-height: 1.45; }
  .mrm-record-link.action { justify-content: flex-end; font-weight: 500; white-space: nowrap; }
  .mrm-register tbody tr:focus-within { background: var(--bg-subtle); outline: 2px solid var(--border-strong); outline-offset: -2px; }

  @media (max-width: 760px) {
    .pre932-label .clause
    { font-size: 11px; }
  }
</style>

<div class="page-head">
  <div>
    <h1 class="page-title">Management review</h1>
  </div>
  <button onclick="document.getElementById('newMrm').classList.toggle('hidden')" class="btn btn-primary">Schedule MRM</button>
</div>

<div id="newMrm" class="hidden panel" style="margin-bottom:16px">
  <div class="panel-head"><h2>New review</h2><span class="meta text-xs">Clause 9.3.2 inputs auto-fill on submit · editable afterwards</span></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/mrms" class="panel-pad grid-2">
    <div><label class="label">Meeting date</label><input class="input" type="date" name="meeting_date"></div>
    <div><label class="label">Attendees</label><input class="input" name="attendees" placeholder="CEO, CISO, CTO"></div>

    <% if (typeof pack932Preview !== 'undefined' && pack932Preview) { %>
      <div class="col-full">
        <label class="label">Auto-filled from current client state</label>
        <div class="pre932">
          <% [
               { key: 'prior_actions_status',        clause: '9.3.2 a)', label: 'Prior actions' },
               { key: 'context_changes',             clause: '9.3.2 b)', label: 'Context changes' },
               { key: 'interested_party_changes',    clause: '9.3.2 c)', label: 'Interested-party changes' },
               { key: 'performance_review',          clause: '9.3.2 d)', label: 'Performance' },
               { key: 'feedback_interested_parties', clause: '9.3.2 e)', label: 'Interested-party feedback' },
               { key: 'risk_treatment_status',       clause: '9.3.2 f)', label: 'Risk treatment' },
               { key: 'improvement_opportunities',   clause: '9.3.2 g)', label: 'Improvements' }
             ].forEach(f => { %>
            <div class="pre932-row">
              <div class="pre932-label"><%= f.label %><span class="clause"><%= f.clause %></span></div>
              <div class="pre932-value"><%= (pack932Preview[f.key] || '').slice(0, 320) %></div>
            </div>
          <% }) %>
        </div>
        <div class="meta text-xs" style="margin-top:6px;">Refreshes on save. Edit any field on the MRM detail page after creation.</div>
      </div>
    <% } %>

    <div class="col-full"><button class="btn btn-primary">Create</button></div>
  </form>
</div>

<div class="panel mrm-register">
  <table class="t">
    <thead><tr><th style="width:140px">Date</th><th>Attendees</th><th style="width:130px">Status</th><th style="width:80px;text-align:right">Action</th></tr></thead>
    <tbody>
      <% mrms.forEach(m => { %>
        <tr>
          <td><a href="/workspaces/<%= ws.id %>/mrms/<%= m.id %>" class="mrm-record-link" style="font-weight:500;"><%= m.meeting_date || 'unscheduled' %></a></td>
          <td><a href="/workspaces/<%= ws.id %>/mrms/<%= m.id %>" class="mrm-record-link attendees"><%= m.attendees || '-' %></a></td>
          <td><a href="/workspaces/<%= ws.id %>/mrms/<%= m.id %>" class="mrm-record-link"><span class="status s-<%= m.status === 'complete' ? 'done' : 'todo' %>"><%= m.status %></span></a></td>
          <td><a href="/workspaces/<%= ws.id %>/mrms/<%= m.id %>" class="mrm-record-link action" aria-label="Open management review dated <%= m.meeting_date || 'unscheduled' %>">Open →</a></td>
        </tr>
      <% }) %>
      <% if (mrms.length === 0) { %>
        <tr><td colspan="4" style="padding:0;">
          <div class="empty-state">
            <div class="empty-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
            <div class="empty-title">Schedule the first management review</div>
            <div class="empty-sub">Clause 9.3 requires top management to review the management system at planned intervals. The review record auto-pulls live client state for required inputs.</div>
            <button onclick="document.getElementById('newMrm').classList.toggle('hidden')" class="btn btn-primary">Schedule MRM</button>
          </div>
        </td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
