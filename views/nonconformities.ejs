<%- include('partials/header', { title: 'Nonconformities', user, ws, active: 'nc' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">Nonconformities & corrective actions</h1>
    <div class="page-subtitle">Per Clause 10.2 - track NCs from audits, incidents, monitoring; root cause; corrective action; effectiveness check.</div>
  </div>
  <div class="row-center">
    <a href="/workspaces/<%= ws.id %>/improvements" class="btn btn-secondary btn-xs" title="Continual improvement register (clause 10.1) - the non-corrective half of clause 10.">Improvements →</a>
    <select onchange="window.location='?filter='+this.value" class="select" style="width:120px">
      <option value="open" <%= filter==='open'?'selected':'' %>>Open</option>
      <option value="all" <%= filter==='all'?'selected':'' %>>All</option>
    </select>
    <button onclick="document.getElementById('newNc').classList.toggle('hidden')" class="btn btn-primary">New NC</button>
  </div>
</div>

<div id="newNc" class="hidden panel" style="margin-bottom:16px">
  <div class="panel-head"><h2>New nonconformity</h2></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/nonconformities" class="panel-pad grid-2">
    <div class="col-full"><label class="label">Title</label><input class="input" name="title" required></div>
    <div class="col-full"><label class="label">Description</label><textarea class="textarea" name="description" rows="3"></textarea></div>
    <div><label class="label">Source</label>
      <select class="select" name="source">
        <option value="internal_audit">Internal audit</option><option value="external_audit">External audit</option>
        <option value="incident">Incident</option><option value="customer">Customer complaint</option>
        <option value="monitoring">Monitoring</option><option value="other" selected>Other</option>
      </select>
    </div>
    <div><label class="label">Severity</label>
      <select class="select" name="severity"><option value="major">Major</option><option value="minor" selected>Minor</option><option value="observation">Observation</option></select>
    </div>
    <div class="col-full"><label class="label">Related requirement</label>
      <%- include('partials/requirement_select', { groups: typeof requirementGroups !== 'undefined' ? requirementGroups : [], name: 'iso_item_id' }) %>
    </div>
    <div class="col-full"><button class="btn btn-primary">Create</button></div>
  </form>
</div>

<div class="panel" style="overflow:hidden">
  <table class="t">
    <thead><tr>
      <th style="width:60px">ID</th><th>Title</th><th style="width:120px">Source</th>
      <th style="width:100px">Severity</th><th style="width:110px">Due</th><th style="width:120px">Status</th>
    </tr></thead>
    <tbody>
      <% ncs.forEach(n => { %>
        <tr>
          <td class="mono meta">NC-<%= String(n.id).padStart(3,'0') %></td>
          <td>
            <a href="/workspaces/<%= ws.id %>/nonconformities/<%= n.id %>" class="link-muted" style="font-weight:500;"><%= n.title %></a>
            <% if (n.iso_title) { %><div class="meta" style="margin-top:2px;"><%= n.iso_title %></div><% } %>
          </td>
          <td class="text-secondary text-base"><%= n.source %></td>
          <td><span class="tag <%= n.severity === 'major' ? 'tag-danger' : n.severity === 'minor' ? 'tag-warn' : 'tag-neutral' %>"><%= n.severity %></span></td>
          <td class="num meta"><%= n.due_date || '-' %></td>
          <td><span class="status s-<%= n.status === 'verified' || n.status === 'closed' ? 'done' : n.status %>"><%= n.status %></span></td>
        </tr>
      <% }) %>
      <% if (ncs.length === 0) { %>
        <tr><td colspan="6" style="padding:0;">
          <div class="empty-state">
            <div class="empty-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></div>
            <div class="empty-title">No open nonconformities</div>
            <div class="empty-sub">Clause 10.2 requires tracking NCs through cause analysis, corrective action, and effectiveness verification. Findings from internal audits can be promoted directly to this register.</div>
            <button onclick="document.getElementById('newNc').classList.toggle('hidden')" class="btn btn-primary">New NC</button>
          </div>
        </td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<% if (typeof pg !== 'undefined' && pg) { %><%- include('partials/pager', { pg, pagerHref }) %><% } %>

<%- include('partials/footer') %>
