  <div style="margin-top:48px;padding-top:18px;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;">
    <div class="meta text-sm">
      Confidential: for audit and management review purposes only. All accesses to this portal are logged.
    </div>
    <% if (typeof share !== 'undefined' && share && share.access_count) { %>
      <div class="meta text-sm">
        This is access <strong><%= share.access_count %></strong> on this link<% if (share.last_accessed_at) { %> · last accessed <%= String(share.last_accessed_at).slice(0,19).replace('T',' ') %><% } %>.
      </div>
    <% } %>
  </div>
</div>
</body>
</html>
