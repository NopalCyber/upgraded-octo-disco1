<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= typeof title !== 'undefined' ? title : 'Auditor view' %> · <%= workspace.client_name %></title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>">
<link rel="stylesheet" href="/fonts/source-serif-4.css">
<link rel="stylesheet" href="/auditor.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>">
<link rel="stylesheet" href="/page-loader.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>">
<script src="/page-loader.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>" defer></script>
<% if (workspace.brand_primary_color) { %>
<style>
  :root {
    --accent: <%= workspace.brand_primary_color %>;
    --accent-soft: <%= workspace.brand_primary_color + '14' %>;
    --accent-deep: <%= workspace.brand_primary_color %>;
  }
</style>
<% } %>
</head>
<body>
<%- include('page_loader') %>

<%
  const tabs = [
    { key: 'overview',  href: '',                  label: 'Overview',         icon: '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>' },
    { key: 'soa',       href: '/soa',              label: 'SoA',              icon: '<polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>' },
    { key: 'risks',     href: '/risks',            label: 'Risks',            icon: '<path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>' },
    { key: 'evidence',  href: '/evidence',         label: 'Evidence',         icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>' },
    { key: 'documents', href: '/documents',        label: 'Policies',         icon: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>' },
    { key: 'audits',    href: '/audits',           label: 'Audits & NCs',     icon: '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>' },
    { key: 'pack',      href: '/audit-pack',       label: 'Full audit pack',  icon: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>', isPack: true }
  ];
%>

<div class="a-topbar">
  <div class="a-container">
    <div class="a-top-row">
      <a href="/auditor/<%= token %>" class="a-brand">
        <svg class="a-brand-mark" width="28" height="28" viewBox="0 0 22 22" aria-hidden="true" style="flex-shrink:0;">
          <circle cx="11" cy="11" r="9.5" fill="none" stroke="#1a1a1a" stroke-width="1.3"/>
          <circle cx="11" cy="11" r="6"   fill="none" stroke="#1a1a1a" stroke-width="1.3"/>
          <circle cx="11" cy="11" r="2.5" fill="#1a1a1a"/>
        </svg>
        <span>
          <div class="a-brand-name"><%= workspace.client_name %> · ISMS</div>
          <div class="a-brand-sub">ISO/IEC 27001:2022<% if (workspace.scope) { %> · <%= workspace.scope.slice(0, 80) %><%= workspace.scope.length > 80 ? '…' : '' %><% } %></div>
        </span>
      </a>
      <div class="a-spacer"></div>
      <% if (share && share.label) { %>
        <div class="a-share-meta"><strong><%= share.label %></strong>
        <% if (share.expires_at) { %> · expires <%= String(share.expires_at).slice(0,10) %><% } %>
        </div>
      <% } %>
      <span class="a-mode-badge">AUDITOR VIEW · READ-ONLY</span>
    </div>
  </div>
</div>

<div class="a-tabs">
  <div class="a-container">
    <div class="a-tabs-row">
      <% tabs.forEach(t => { %>
        <a href="/auditor/<%= token %><%= t.href %>" class="a-tab <%= (typeof active !== 'undefined' && active === t.key) ? 'active' : '' %>"<%= t.isPack ? ' download' : '' %>>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- t.icon %></svg>
          <%= t.label %>
        </a>
      <% }) %>
    </div>
  </div>
</div>

<div class="a-main">
