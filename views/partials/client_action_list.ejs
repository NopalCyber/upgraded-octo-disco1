<section class="panel" id="action-list" style="margin-bottom:20px">
  <div class="panel-head"><div><h2><%= workScope==='mine'?'My actions':'Team actions' %></h2><p class="meta">Requests, deliverables, approvals and information checks in one list.</p></div></div>
  <form class="panel-pad" method="GET" action="/workspaces/<%= ws.id %>/client-portal" style="display:flex;gap:10px;flex-wrap:wrap;align-items:end;border-bottom:1px solid var(--border)">
    <input type="hidden" name="view" value="actions"><% if(clientPreview){ %><input type="hidden" name="preview" value="client"><% } %>
    <% if(canManage || clientPreview){ %><div><label class="label" for="work-scope">Responsibility</label><select class="select" id="work-scope" name="work_scope"><option value="client" <%= workScope!=='mine'?'selected':'' %>>Client team</option><option value="mine" <%= workScope==='mine'?'selected':'' %>>Assigned to me</option></select></div><% } %>
    <div><label class="label" for="work-status">Show</label><select class="select" id="work-status" name="work_status"><% [['open','Active work'],['action_required','Needs action'],['blocked','Blocked'],['waiting','Waiting on others'],['complete','Completed'],['all','All work']].forEach(option=>{ %><option value="<%= option[0] %>" <%= workFilter===option[0]?'selected':'' %>><%= option[1] %></option><% }) %></select></div>
    <div style="flex:1;min-width:180px"><label class="label" for="work-search">Find work</label><input class="input" id="work-search" name="q" value="<%= workQuery %>" placeholder="Search by title or owner"></div><button class="btn btn-secondary">Apply filters</button>
  </form>
  <div class="panel-pad meta"><strong><%= work.counts.total %></strong> matching items · <%= work.counts.actionRequired %> need action · <%= work.counts.waiting %> waiting · <%= work.counts.blocked || 0 %> blocked · <%= work.counts.overdue %> overdue</div>
  <% if(!work.items.length){ %><div class="panel-pad"><h3>No matching work</h3><p class="meta">Try All work to find completed items, or clear your search. Your engagement team will share new work here.</p></div><% } %>
  <% work.items.forEach(item=>{ %><article class="panel-pad" id="work-<%= item.sourceType %>-<%= item.sourceId %>" style="border-top:1px solid var(--border);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap"><div style="flex:1;min-width:200px"><span class="meta"><%= item.programmeLabel %> · <%= String(item.sourceType).replaceAll('_',' ') %></span><h3 style="margin:5px 0"><a href="<%= clientPreview?viewPath('actions'):item.href %>"><%= item.title %></a></h3><p class="meta">Responsible: <strong><%= item.ownerName || (item.waitingOn ? item.waitingOn==='firm'?'Engagement team':label(item.waitingOn) : 'Client coordinator to assign') %></strong><%= item.dueDate?' · Due '+formatDate(item.dueDate):' · No due date agreed' %></p><% if(item.blockedReason){ %><p class="meta"><%= item.blockedReason %></p><% } %></div><div style="display:grid;gap:8px;align-content:center"><span class="status status-<%= item.overdue?'bad':['waiting','blocked'].includes(item.actionState)?'warn':item.actionState==='complete'?'good':'neutral' %>"><%= item.overdue?'Overdue · ':'' %><%= item.actionState==='blocked'?'Blocked':item.actionState==='waiting'?'Waiting on '+(item.waitingOn==='firm'?'engagement team':item.waitingOn || 'review'):item.actionState==='complete'?'Complete':'Needs action' %></span><a class="btn btn-secondary btn-xs" href="<%= clientPreview?viewPath('actions'):item.href %>"><%= clientPreview?'Preview only':item.actionState==='complete'?'View completed work':item.actionLabel %></a></div></article><% }) %>
  <% if(work.nextCursor){ %><div class="panel-pad"><a class="btn btn-secondary" href="<%= viewPath('actions',`&work_scope=${encodeURIComponent(workScope)}&work_status=${encodeURIComponent(workFilter)}&q=${encodeURIComponent(workQuery)}&cursor=${work.nextCursor}`) %>">Next page</a></div><% } %>
</section>
