<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
<meta name="view-transition" content="same-origin">
<title><%= typeof title !== 'undefined' ? title : 'Dashboard' %> · Compliance Sphere</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>">
<link rel="stylesheet" href="/app.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>">
<link rel="stylesheet" href="/page-loader.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>">
<script>
  try {
    const savedTheme = localStorage.getItem('isms-theme');
    if (savedTheme === 'dark' || (!savedTheme && matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.setAttribute('data-theme', 'dark');
    }
  } catch (_) {}
</script>
<script src="/page-loader.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>" defer></script>
<script src="/site-enhancements.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>" defer></script>
<script src="/form-drafts.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>" defer></script>
<script src="/client-response-upload.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>" defer></script>
<noscript><style>@media(max-width:900px){.app{display:block!important}.sidebar{position:static!important;transform:none!important;width:100%!important;max-height:none!important}.main{margin-left:0!important}.sidebar-mobile-close{display:none!important}}</style></noscript>
</head>
<body data-actor-id="<%= typeof user !== 'undefined' && user ? user.id : '' %>" data-authenticated="<%= typeof user !== 'undefined' && user ? 'true' : 'false' %>">
<a class="skip-link" href="#mainContent">Skip to content</a>
<%- include('page_loader') %>
<% if (typeof user !== 'undefined' && user) { %>
<%
  const shellClientMode = user.user_type === 'client' || (typeof clientPreview !== 'undefined' && clientPreview === true);
  const shellPreviewMode = user.user_type === 'firm' && shellClientMode;
  const shellDisplayUser = shellPreviewMode
    ? ((typeof clientPreviewUser !== 'undefined' && clientPreviewUser) || { name: 'Client preview', email: 'Read-only test mode' })
    : user;
  const shellPortalUrl = typeof ws !== 'undefined' && ws
    ? `/workspaces/${ws.id}/client-portal${shellPreviewMode ? '?preview=client' : ''}`
    : '/dashboard';
%>
<div class="app" id="app">
  <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebar(false)" aria-hidden="true"></div>
  <aside class="sidebar" id="sidebar" aria-label="Primary navigation">
    <div class="sidebar-section">
      <a class="sidebar-brand" href="<%= shellClientMode ? shellPortalUrl : '/dashboard' %>" aria-label="Compliance Sphere dashboard" style="display:flex;align-items:center;gap:8px;text-decoration:none;color:var(--text);line-height:1.1;">
        <svg width="20" height="20" viewBox="0 0 22 22" aria-hidden="true" style="flex-shrink:0;">
          <circle cx="11" cy="11" r="9.5" fill="none" stroke="currentColor" stroke-width="1.3"/>
          <circle cx="11" cy="11" r="6"   fill="none" stroke="currentColor" stroke-width="1.3"/>
          <circle cx="11" cy="11" r="2.5" fill="currentColor"/>
        </svg>
        <span class="sidebar-brand-name" style="font-size:14.5px;font-weight:500;color:inherit;letter-spacing:-0.2px;">Compliance Sphere</span>
      </a>
      <button type="button" class="sidebar-mobile-close" onclick="toggleSidebar(false)" aria-label="Close navigation menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <% if (user.user_type === 'firm' && !shellClientMode && typeof activeFirm !== 'undefined' && activeFirm) { %>
        <% const otherFirms = (typeof allFirms !== 'undefined' ? allFirms : []).filter(f => f.id !== activeFirm.id); %>
        <% if (otherFirms.length === 0) { %>
          <div class="tenant-current" style="margin-top:10px;display:flex;align-items:center;gap:6px;font-size:11px;color:var(--text-secondary);">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="opacity:0.7;flex-shrink:0;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= activeFirm.name %></span>
          </div>
        <% } else { %>
          <details class="tenant-switcher" style="margin-top:10px;">
            <summary style="list-style:none;cursor:pointer;display:flex;align-items:center;gap:6px;font-size:11px;color:var(--text);">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="opacity:0.7;flex-shrink:0;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
              <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:500;"><%= activeFirm.name %></span>
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="opacity:0.6;flex-shrink:0;"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div style="margin-top:6px;background:var(--bg);border:1px solid var(--border);border-radius:6px;max-height:260px;overflow-y:auto;">
              <% otherFirms.forEach(f => { %>
                <form method="POST" action="/tenants/<%= f.id %>/switch" style="margin:0;">
                  <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
                  <button type="submit" style="display:flex;width:100%;align-items:center;gap:8px;padding:8px 12px;background:transparent;border:0;text-align:left;color:var(--text);font-size:12px;cursor:pointer;border-bottom:1px solid var(--border);font-family:inherit;">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="opacity:0.5;flex-shrink:0;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                    <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= f.name %></span>
                    <span style="font-size:10px;color:var(--text-tertiary);flex-shrink:0;"><%= f.workspace_count %> client<%= f.workspace_count === 1 ? '' : 's' %></span>
                  </button>
                </form>
              <% }) %>
              <a href="/tenants" style="display:block;padding:8px 12px;font-size:11px;color:var(--text-secondary);text-decoration:none;border-top:1px solid var(--border);background:var(--bg-subtle);">Manage firms →</a>
            </div>
          </details>
        <% } %>
      <% } %>
    </div>

    <% if (typeof ws !== 'undefined' && ws) { %>
    <%
      const brandColor = (ws.brand_primary_color && /^#[0-9a-fA-F]{6}$/.test(ws.brand_primary_color)) ? ws.brand_primary_color : null;
      const externalClientUser = shellClientMode;
      const otherWorkspaces = externalClientUser
        ? []
        : (typeof firmWorkspaces !== 'undefined' ? firmWorkspaces : []).filter(w => w.id !== ws.id);
    %>
    <div class="sidebar-section ws-context" style="<%= brandColor ? 'padding-left:11px;' : '' %>">
      <% if (externalClientUser) { %>
        <div class="text-xs" style="color:var(--text-secondary);text-transform:uppercase;letter-spacing:.08em;">Client portal</div>
      <% } else { %>
        <a class="text-xs" href="/dashboard?legacy=1" style="color:var(--text-secondary);text-decoration:none;">← All clients</a>
      <% } %>
      <% if (externalClientUser) { %>
        <div class="client-portal-context-name"><%= ws.brand_display_name || ws.client_name %></div>
      <% } else { %>
      <details class="ws-switcher" style="margin-top:10px;">
        <summary style="list-style:none;cursor:pointer;display:flex;align-items:center;gap:6px;color:var(--text);">
          <span class="text-lg" style="font-weight: 500;letter-spacing:-0.005em;line-height:1.3;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= ws.brand_display_name || ws.client_name %></span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="opacity:0.6;flex-shrink:0;"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="ws-switcher-menu" style="margin-top:8px;background:var(--bg);border:1px solid var(--border);border-radius:6px;max-height:280px;overflow-y:auto;">
          <% if (otherWorkspaces.length === 0) { %>
            <div style="padding:10px 12px;font-size:12px;color:var(--text-tertiary);">No other clients yet.</div>
          <% } else { %>
            <% otherWorkspaces.forEach(w => {
                 const dot = (w.brand_primary_color && /^#[0-9a-fA-F]{6}$/.test(w.brand_primary_color)) ? w.brand_primary_color : 'rgba(26,26,26,0.2)';
            %>
              <a href="/workspaces/<%= w.id %>" style="display:flex;align-items:center;gap:8px;padding:8px 12px;text-decoration:none;color:var(--text);font-size:13px;border-bottom:1px solid var(--border);">
                <span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:<%= dot %>;flex-shrink:0;"></span>
                <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= w.brand_display_name || w.client_name %></span>
                <% if (w.sector) { %><span style="font-size:10px;color:var(--text-tertiary);flex-shrink:0;"><%= w.sector %></span><% } %>
              </a>
            <% }) %>
          <% } %>
          <a href="/dashboard" style="display:block;padding:8px 12px;font-size:12px;color:var(--text-secondary);text-decoration:none;border-top:1px solid var(--border);background:var(--bg-subtle);">All clients →</a>
        </div>
      </details>
      <% } %>
      <div class="text-xs" style="margin-top:3px;color:var(--text-tertiary);display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
        <% if (ws.sector) { %><span class="text-xxs" style="background:var(--nav-active);padding:1px 6px;border-radius:999px;font-weight:500;"><%= ws.sector %></span><% } %>
        <% if (ws.industry) { %><span><%= ws.industry %></span><% } else if (!externalClientUser) { %><span><%= ws.stage.replace(/_/g,' ') %></span><% } %>
      </div>
    </div>
    <% } %>

    <nav class="sidebar-nav">
      <% if (typeof ws !== 'undefined' && ws) { %>
        <% if (shellClientMode) { %>
          <%- include('client_portal_navigation', {
            ws,
            active: typeof active !== 'undefined' ? active : '',
            clientPreview: shellPreviewMode
          }) %>
        <% } else { %>
          <%- include('client_navigation', {
            user, ws, rbac,
            active: typeof active !== 'undefined' ? active : '',
            openReviewCount: typeof openReviewCount !== 'undefined' ? openReviewCount : 0
          }) %>
        <% } %>
      <% } else { %>
        <% const allWs = (typeof firmWorkspaces !== 'undefined' ? firmWorkspaces : []); %>
        <%
          const firmNavRole = typeof rbac.normalizeRole === 'function' ? rbac.normalizeRole(user.firm_role) : user.firm_role;
          const firmNavTrimmed = user.user_type === 'firm' && firmNavRole === 'consultant';
          const firmNavActive = typeof active !== 'undefined' ? active : '';
        %>
        <% if (allWs.length > 0) { %>
          <details class="ws-switcher" style="margin:0 14px 12px;">
            <summary style="list-style:none;cursor:pointer;display:flex;align-items:center;gap:8px;padding:9px 11px;background:var(--nav-hover);border-radius:6px;color:var(--text);font-size:13px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:0.7;flex-shrink:0;"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
              <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:500;">Jump to a client</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="opacity:0.6;flex-shrink:0;"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="ws-switcher-menu" style="margin-top:6px;background:var(--bg);border:1px solid var(--border);border-radius:6px;max-height:340px;overflow-y:auto;">
              <% allWs.forEach(w => {
                   const dot = (w.brand_primary_color && /^#[0-9a-fA-F]{6}$/.test(w.brand_primary_color)) ? w.brand_primary_color : 'var(--text-tertiary)';
                   const isLast = (typeof lastWs !== 'undefined' && lastWs && lastWs.id === w.id);
              %>
                <a href="/workspaces/<%= w.id %>" style="display:flex;align-items:center;gap:8px;padding:8px 12px;text-decoration:none;color:var(--text);font-size:13px;border-bottom:1px solid var(--border);<%= isLast ? 'background:var(--nav-hover);' : '' %>">
                  <span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:<%= dot %>;flex-shrink:0;"></span>
                  <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= w.brand_display_name || w.client_name %><% if (isLast) { %> <span style="font-size:10px;color:var(--text-tertiary);font-weight:400;">· last viewed</span><% } %></span>
                  <% if (w.sector) { %><span style="font-size:10px;color:var(--text-tertiary);flex-shrink:0;"><%= w.sector %></span><% } %>
                </a>
              <% }) %>
            </div>
          </details>
        <% } %>
        <a href="/dashboard" class="nav-item <%= (typeof active === 'undefined' || !['glossary','portfolio','firm-calendar','tprm-portfolio','playbooks','firm-library','admin-users','admin-email','admin-activity'].includes(active)) ? 'active' : '' %>">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          <span class="nav-item-text">Clients</span>
        </a>
        <% if (!firmNavTrimmed) { %>
        <a href="/tprm" class="nav-item <%= (typeof active !== 'undefined' && active === 'tprm-portfolio') ? 'active' : '' %>">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3 4 6v6c0 5 3.4 8.2 8 9 4.6-.8 8-4 8-9V6l-8-3Z"/><path d="M8 12h8M12 8v8"/></svg>
          <span class="nav-item-text">Third-party risk</span>
        </a>
        <% } %>
        <% if (user && user.user_type === 'firm' && rbac.rolePermissions(user.firm_role).includes('firm.cross_view')) { %>
          <a href="/portfolio" class="nav-item <%= (typeof active !== 'undefined' && active === 'portfolio') ? 'active' : '' %>">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            <span class="nav-item-text">Portfolio</span>
          </a>
          <a href="/calendar" class="nav-item <%= (typeof active !== 'undefined' && active === 'firm-calendar') ? 'active' : '' %>">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span class="nav-item-text">Calendar</span>
          </a>
        <% } %>
        <% if (firmNavTrimmed) { %>
          <%
            const firmMore = [
              { label: 'Playbooks', url: '/playbooks', selected: firmNavActive === 'playbooks' },
              { label: 'Library', url: '/firm/library', selected: firmNavActive === 'firm-library' },
              { label: 'Glossary', url: '/glossary', selected: firmNavActive === 'glossary' }
            ];
            const firmMoreOpen = firmMore.some(link => link.selected);
          %>
          <details class="nav-domain <%= firmMoreOpen ? 'is-active' : '' %>" <%= firmMoreOpen ? 'open' : '' %>>
            <summary class="nav-domain-summary" aria-label="More tools" title="More tools"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/></svg><span class="nav-domain-text">More tools</span><svg class="nav-domain-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg></summary>
            <div class="nav-domain-items">
              <% firmMore.forEach(link => { %>
                <a class="nav-subitem <%= link.selected ? 'active' : '' %>" href="<%= link.url %>" <%- link.selected ? 'aria-current="page"' : '' %>><%= link.label %></a>
              <% }) %>
            </div>
          </details>
        <% } else { %>
        <div class="nav-group-label">Reference</div>
        <a href="/playbooks" class="nav-item <%= (typeof active !== 'undefined' && active === 'playbooks') ? 'active' : '' %>">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          <span class="nav-item-text">Playbooks</span>
        </a>
        <a href="/firm/library" class="nav-item <%= (typeof active !== 'undefined' && active === 'firm-library') ? 'active' : '' %>">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          <span class="nav-item-text">Library</span>
        </a>
        <a href="/glossary" class="nav-item <%= (typeof active !== 'undefined' && active === 'glossary') ? 'active' : '' %>">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          <span class="nav-item-text">Glossary</span>
        </a>
        <% } %>
        <% if (user && rbac.isManager(user.firm_role)) { %>
          <div class="nav-group-label">Admin</div>
          <a href="/admin/users" class="nav-item <%= (typeof active !== 'undefined' && active === 'admin-users') ? 'active' : '' %>">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span class="nav-item-text">Users &amp; access</span>
          </a>
          <a href="/admin/email" class="nav-item <%= (typeof active !== 'undefined' && active === 'admin-email') ? 'active' : '' %>">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <span class="nav-item-text">Email</span>
          </a>
          <a href="/admin/activity" class="nav-item <%= (typeof active !== 'undefined' && active === 'admin-activity') ? 'active' : '' %>">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            <span class="nav-item-text">Activity</span>
          </a>
        <% } %>
      <% } %>
    </nav>

    <div class="sidebar-foot">
      <div class="avatar text-xs" title="<%= shellDisplayUser.name %>" style="width:28px;height:28px;border:1px solid var(--border-strong);border-radius:50%;background:var(--bg-muted);display:flex;align-items:center;justify-content:center;color:var(--text);font-weight:600;flex-shrink:0;"><%= shellDisplayUser.name.charAt(0).toUpperCase() %></div>
      <div style="min-width:0;flex:1;">
        <div class="text-lg" style="font-weight:500;line-height:1.2;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= shellDisplayUser.name %></div>
        <div class="text-eyebrow" style="color:var(--text-tertiary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= shellPreviewMode ? 'Read-only client preview' : shellDisplayUser.email %></div>
      </div>
      <button class="sidebar-foot-action" data-theme-toggle title="Toggle theme" aria-label="Switch to dark mode" aria-pressed="false">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <% if (shellPreviewMode) { %>
      <a class="sidebar-foot-action" href="/workspaces/<%= ws.id %>/engagement-plan" title="Exit client preview" aria-label="Exit client preview">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
      </a>
      <% } else { %><form class="sidebar-foot-action" method="POST" action="/logout" style="margin:0;display:flex;">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <button type="submit" title="Sign out" aria-label="Sign out">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </button>
      </form><% } %>
    </div>
  </aside>

  <main class="main" id="mainContent" tabindex="-1">
    <div class="main-inner">
      <div class="topbar">
        <button type="button" class="icon-btn menu-toggle" id="mobileMenuButton" onclick="toggleSidebar(true)" title="Menu" aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <button type="button" class="icon-btn sidebar-collapse-toggle" id="sidebarCollapseButton" onclick="toggleSidebarCollapse()" title="Collapse sidebar" aria-label="Collapse sidebar" aria-pressed="false">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="11 17 6 12 11 7"/><polyline points="18 17 13 12 18 7"/></svg>
        </button>
        <button type="button" class="palette-trigger" onclick="openPalette()" aria-label="Search this <%= shellClientMode ? 'engagement' : 'application' %>" aria-haspopup="dialog" aria-controls="cpBackdrop" aria-expanded="false">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <span><%= shellClientMode ? 'Search this engagement…' : 'Search or jump to…' %></span>
          <span class="kbd" id="kbdHint">⌘K</span>
        </button>
        <% if (user.user_type === 'firm' && !shellClientMode && typeof allFirms !== 'undefined' && allFirms && allFirms.length > 1) { %>
          <div class="topbar-tenant-switcher" style="position:relative;" id="tenantSwitcher">
            <button type="button" class="palette-trigger text-base" onclick="document.getElementById('tenantMenu').style.display = (document.getElementById('tenantMenu').style.display === 'block' ? 'none' : 'block')" style="gap:6px;padding:5px 10px;" title="Switch tenant">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              <span style="font-weight:500;"><%= activeFirm ? activeFirm.name : 'No tenant' %></span>
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div id="tenantMenu" style="display:none;position:absolute;top:calc(100% + 4px);left:0;background:var(--bg);border:1px solid var(--border);border-radius:6px;box-shadow:var(--shadow-lg);min-width:240px;z-index:50;overflow:hidden;">
              <div class="text-xxs text-secondary" style="padding:6px 10px;text-transform:uppercase;letter-spacing:0.05em;border-bottom:1px solid var(--border);background:var(--bg-subtle);">Firms (<%= allFirms.length %>)</div>
              <% allFirms.forEach(f => {
                   const isActive = activeFirm && activeFirm.id === f.id;
              %>
                <% if (isActive) { %>
                  <div class="text-lg" style="padding:8px 12px;display:flex;justify-content:space-between;align-items:center;background:rgba(8,145,178,0.06);">
                    <span style="font-weight:500;"><%= f.name %></span>
                    <span class="meta text-eyebrow">active</span>
                  </div>
                <% } else { %>
                  <form method="POST" action="/tenants/<%= f.id %>/switch" style="margin:0;">
                    <button class="text-lg" type="submit" style="width:100%;text-align:left;background:none;border:none;padding:8px 12px;cursor:pointer;" onmouseover="this.style.background='var(--bg-subtle)'" onmouseout="this.style.background='none'"><%= f.name %></button>
                  </form>
                <% } %>
              <% }) %>
              <a class="text-base" href="/tenants" style="display:block;padding:8px 12px;border-top:1px solid var(--border);text-decoration:none;color:var(--accent);background:var(--bg-subtle);">Manage firms →</a>
            </div>
          </div>
          <script>
            (function(){
              document.addEventListener('click', function(e){
                const sw = document.getElementById('tenantSwitcher');
                const m = document.getElementById('tenantMenu');
                if (sw && m && !sw.contains(e.target)) m.style.display = 'none';
              });
            })();
          </script>
        <% } %>
        <div class="topbar-spacer"></div>
        <% if (user.user_type === 'firm' && !shellClientMode && typeof entitySelectorWs !== 'undefined' && entitySelectorWs) { %>
          <a href="/workspaces/<%= entitySelectorWs.id %>/inbox" class="icon-btn" title="Inbox" aria-label="Inbox" style="position:relative;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            <% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %>
              <span style="position:absolute;top:-5px;right:-5px;background:#dc2626;color:white;font-size:9.5px;font-weight: 500;border-radius:9px;min-width:16px;height:16px;display:flex;align-items:center;justify-content:center;padding:0 3px;border:2px solid var(--bg-deep, var(--bg));"><%= unreadNotifications > 99 ? '99+' : unreadNotifications %></span>
            <% } %>
          </a>
        <% } %>
        <button type="button" class="icon-btn" onclick="openHelp()" title="<%= shellClientMode ? 'Portal help' : 'Keyboard shortcuts (?)' %>" aria-label="Help" aria-haspopup="dialog" aria-controls="helpBackdrop" aria-expanded="false">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </button>
      </div>
<% } else { %>
<div class="app" style="background:var(--bg-deep)">
  <main class="main" id="mainContent" tabindex="-1">
    <div class="main-inner" style="max-width:420px;">
<% } %>
