<% const reqGroups = locals.groups || []; %>
<select class="<%= locals.cls || 'select' %>" name="<%= locals.name || 'iso_item_id' %>"<% if (locals.style) { %> style="<%= locals.style %>"<% } %>>
  <option value=""><%= locals.blank || '- none -' %></option>
  <% reqGroups.forEach(g => { %>
    <% if (reqGroups.length > 1) { %><optgroup label="<%= g.label %>"><% } %>
    <% g.items.forEach(it => { %><option value="<%= it.id %>" <%= locals.selected === it.id ? 'selected' : '' %>><%= locals.short ? it.code : it.title %></option><% }) %>
    <% if (reqGroups.length > 1) { %></optgroup><% } %>
  <% }) %>
</select>
