<%
  const _tab = (typeof tab !== 'undefined' && tab) ? tab : 'current';
  const _tabs = [
    { id: 'current',   label: 'Current',   href: `/workspaces/${ws.id}/soa` },
    { id: 'snapshots', label: 'Snapshots', href: `/workspaces/${ws.id}/soa/snapshots` },
    { id: 'diff',      label: 'Diff',      href: `/workspaces/${ws.id}/soa/snapshots/diff` },
  ];
%>
<div class="subtabs">
  <% _tabs.forEach(t => { %>
    <a href="<%= t.href %>" class="subtab <%= t.id === _tab ? 'is-active' : '' %>"><%= t.label %></a>
  <% }) %>
</div>
