<%- include('partials/header', { title: playbook.title, user, ws: null, active: 'playbooks' }) %>

<style>
  @media print {
    .sidebar, .topbar, .no-print, .page-subtitle { display: none !important; }
    .main-inner { padding: 0 !important; max-width: none !important; }
    .panel { box-shadow: none !important; border: 1px solid #ccc !important; page-break-inside: avoid; }
    body { font-size: 11px; }
  }
</style>

<div class="page-head">
  <div>
    <a href="/playbooks" class="link-muted no-print text-base">← All playbooks</a>
    <h1 class="page-title" style="margin-top:6px;"><%= playbook.title %></h1>
    <div class="page-subtitle"><%= playbook.blurb %></div>
  </div>
  <button onclick="window.print()" class="btn btn-secondary btn-xs no-print">Print</button>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:20px;">
  <div class="panel">
    <div class="panel-head"><h2 class="text-xl" style="margin:0;">Who to invite</h2></div>
    <ul class="text-lg" style="margin:0;padding:14px 18px 16px 36px;line-height:1.6;">
      <% playbook.whoToInvite.forEach(p => { %><li><%= p %></li><% }) %>
    </ul>
  </div>
  <div class="panel">
    <div class="panel-head"><h2 class="text-xl" style="margin:0;">Pre-work</h2></div>
    <ul class="text-lg" style="margin:0;padding:14px 18px 16px 36px;line-height:1.6;">
      <% playbook.prework.forEach(p => { %><li><%= p %></li><% }) %>
    </ul>
  </div>
</div>

<div class="panel" style="margin-bottom:20px;">
  <div class="panel-head"><h2 style="margin:0;">The script</h2></div>
  <% playbook.segments.forEach((seg, idx) => { %>
    <div style="padding:18px 20px;<%= idx > 0 ? 'border-top:1px solid var(--border);' : '' %>">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px;">
        <span class="tag tag-accent text-eyebrow"><%= seg.time %></span>
        <h3 class="text-xl" style="margin:0;"><%= seg.title %></h3>
      </div>
      <ul style="margin:0;padding:0 0 0 22px;font-size:13.5px;line-height:1.55;">
        <% seg.script.forEach(line => { %><li style="margin-bottom:6px;"><%= line %></li><% }) %>
      </ul>
      <% if (seg.decisions && seg.decisions.length) { %>
        <div style="margin-top:12px;padding:10px 14px;background:var(--accent-soft);border-radius:4px;">
          <div class="text-xs" style="font-weight: 500;text-transform:uppercase;letter-spacing:0.05em;color:var(--accent-deep);margin-bottom:6px;">Decisions to leave with</div>
          <ul class="text-md" style="margin:0;padding-left:18px;line-height:1.5;">
            <% seg.decisions.forEach(d => { %><li><%= d %></li><% }) %>
          </ul>
        </div>
      <% } %>
    </div>
  <% }) %>
</div>

<div style="display:grid;grid-template-columns:<%= playbook.watchOuts ? '1fr 1fr' : '1fr' %>;gap:14px;">
  <div class="panel">
    <div class="panel-head"><h2 class="text-xl" style="margin:0;">Artefacts produced</h2></div>
    <ul class="text-lg" style="margin:0;padding:14px 18px 16px 36px;line-height:1.6;">
      <% playbook.artefactsProduced.forEach(a => { %><li><%= a %></li><% }) %>
    </ul>
  </div>
  <% if (playbook.watchOuts) { %>
    <div class="panel" style="">
      <div class="panel-head"><h2 class="text-xl" style="margin:0;color:#b45309;">Watch-outs</h2></div>
      <ul class="text-lg" style="margin:0;padding:14px 18px 16px 36px;line-height:1.6;">
        <% playbook.watchOuts.forEach(w => { %><li><%= w %></li><% }) %>
      </ul>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
