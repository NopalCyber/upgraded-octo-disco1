<%- include('partials/header', { title: risk.title, user, ws, active: 'risks' }) %>

<style>
  .risk-delta-grid > *,
  .risk-action-create > *,
  .risk-accept-form > * { min-width: 0; }
  @media (max-width: 600px) {
    .risk-position-strip > :last-child {
      margin-left: 0 !important;
      width: 100%;
    }
    .risk-delta-grid { grid-template-columns: 1fr !important; }
    .risk-delta-arrow { transform: rotate(90deg); text-align: center; }
    .risk-linked-row { align-items: flex-start !important; flex-direction: column; }
    .risk-linked-row form,
    .risk-linked-row .btn { width: 100%; }
    .risk-linked-row .btn { justify-content: center; }
    .risk-link-form { align-items: stretch; flex-direction: column; }
    .risk-link-form .btn { width: 100%; justify-content: center; }
    .risk-action-create,
    .risk-accept-form { grid-template-columns: 1fr !important; }
    .risk-action-create .btn { width: 100%; justify-content: center; }
    .risk-accept-attestation {
      align-items: stretch !important;
      flex-direction: column;
    }
    .risk-accept-attestation .btn {
      margin-left: 0 !important;
      width: 100%;
      justify-content: center;
    }
    .risk-accept-actions { align-items: stretch; flex-direction: column; }
    .risk-accept-actions form,
    .risk-accept-actions .btn { width: 100%; }
    .risk-accept-actions .btn { justify-content: center; }
  }
</style>

<a href="/workspaces/<%= ws.id %>/risks" class="link-muted text-base">← All risks</a>

<%
  const lScale = methodology.likelihood_scale;
  const iScale = methodology.impact_scale;
  const bands = methodology.thresholds;
  const ihColor = inherentBand && bands[inherentBand] ? bands[inherentBand].color : '#71717a';
  const resColor = residualBand && bands[residualBand] ? bands[residualBand].color : '#71717a';
%>

<div class="panel" style="margin-top:12px;margin-bottom:16px">
  <div class="panel-pad" style="border-bottom:1px solid var(--border)">
    <div class="mono meta" style="margin-bottom:4px;">R-<%= String(risk.id).padStart(3,'0') %><% if (risk.entity_name) { %> · entity: <%= risk.entity_name %><% } %></div>
    <h1 class="page-title"><%= risk.title %></h1>
    <div class="risk-position-strip" style="display:flex;gap:14px;margin-top:8px;flex-wrap:wrap;">
      <div>
        <span class="meta">Inherent</span>
        <span class="tag" style="background:<%= ihColor %>1a;color:<%= ihColor %>;border-color:<%= ihColor %>40;text-transform:uppercase;letter-spacing:0.04em;margin-left:4px;"><%= inherentBand %></span>
        <span class="meta">L<%= risk.likelihood %> · I<%= risk.impact %></span>
      </div>
      <% if (residualBand) { %>
        <div>
          <span class="meta">Residual</span>
          <span class="tag" style="background:<%= resColor %>1a;color:<%= resColor %>;border-color:<%= resColor %>40;text-transform:uppercase;letter-spacing:0.04em;margin-left:4px;"><%= residualBand %></span>
          <span class="meta">L<%= risk.residual_likelihood %> · I<%= risk.residual_impact %></span>
        </div>
      <% } %>
      <div style="margin-left:auto;"><a href="/workspaces/<%= ws.id %>/risk-methodology" class="link-muted text-base" style="color:var(--accent);">Methodology: <%= methodology.name %></a></div>
    </div>
  </div>
  <form method="POST" action="/workspaces/<%= ws.id %>/risks/<%= risk.id %>" class="panel-pad grid-2">
    <div class="col-full"><label class="label">Title</label><input class="input" name="title" value="<%= risk.title %>" required></div>
    <div class="col-full"><label class="label">Description</label><textarea class="textarea" name="description" rows="2"><%= risk.description || '' %></textarea></div>
    <div><label class="label">Asset</label>
      <select class="select" name="asset_id">
        <option value="">- none -</option>
        <% assets.forEach(a => { %><option value="<%= a.id %>" <%= risk.asset_id == a.id ? 'selected' : '' %>><%= a.name %></option><% }) %>
      </select>
    </div>
    <div><label class="label">Owner</label><input class="input" name="owner_name" value="<%= risk.owner_name || '' %>"></div>
    <div><label class="label">Threat</label><input class="input" name="threat" value="<%= risk.threat || '' %>"></div>
    <div><label class="label">Vulnerability</label><input class="input" name="vulnerability" value="<%= risk.vulnerability || '' %>"></div>
    <div><label class="label">Likelihood</label>
      <select class="select" name="likelihood">
        <% lScale.forEach(l => { %><option value="<%= l.value %>" <%= risk.likelihood===l.value?'selected':'' %>><%= l.value %> · <%= l.label %></option><% }) %>
      </select>
    </div>
    <div><label class="label">Impact</label>
      <select class="select" name="impact">
        <% iScale.forEach(l => { %><option value="<%= l.value %>" <%= risk.impact===l.value?'selected':'' %>><%= l.value %> · <%= l.label %></option><% }) %>
      </select>
    </div>
    <div><label class="label">Treatment</label>
      <select class="select" name="treatment">
        <% ['modify','retain','avoid','share'].forEach(t => { %><option value="<%= t %>" <%= risk.treatment === t ? 'selected' : '' %>><%= t %></option><% }) %>
      </select>
    </div>
    <div><label class="label">Status</label>
      <select class="select" name="status">
        <% ['open','treated','accepted','closed'].forEach(s => { %><option value="<%= s %>" <%= risk.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
      </select>
    </div>
    <div><label class="label">Residual likelihood</label>
      <select class="select" name="residual_likelihood"><option value="">-</option>
        <% lScale.forEach(l => { %><option value="<%= l.value %>" <%= risk.residual_likelihood===l.value?'selected':'' %>><%= l.value %> · <%= l.label %></option><% }) %>
      </select>
    </div>
    <div><label class="label">Residual impact</label>
      <select class="select" name="residual_impact"><option value="">-</option>
        <% iScale.forEach(l => { %><option value="<%= l.value %>" <%= risk.residual_impact===l.value?'selected':'' %>><%= l.value %> · <%= l.label %></option><% }) %>
      </select>
    </div>
    <div class="col-full row">
      <button class="btn btn-primary">Save</button>
      <a href="/workspaces/<%= ws.id %>/risks/<%= risk.id %>/treatments" class="btn btn-secondary">Treatment plan →</a>
      <form method="POST" action="/workspaces/<%= ws.id %>/risks/<%= risk.id %>/delete" onsubmit="return appConfirmForm(event, 'Delete this risk?')" style="display:inline">
        <button class="btn btn-danger">Delete</button>
      </form>
    </div>
  </form>
</div>

<% if (risk.likelihood && risk.impact && risk.residual_likelihood && risk.residual_impact) { %>
<div class="panel" style="margin-bottom:14px">
  <div class="panel-head"><h2>Inherent → residual delta</h2></div>
  <div class="panel-pad">
    <% const inherentScore = risk.likelihood * risk.impact;
       const residualScore = risk.residual_likelihood * risk.residual_impact;
       const reduction = inherentScore - residualScore;
       const pctReduction = inherentScore ? Math.round(reduction / inherentScore * 100) : 0; %>
    <div class="risk-delta-grid" style="display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:14px;align-items:center;">
      <div style="text-align:center;padding:14px;background:<%= ihColor %>1a;border-radius:8px;">
        <div class="meta">Inherent</div>
        <div style="font-size:28px;font-weight: 500;color:<%= ihColor %>;"><%= inherentScore %></div>
        <div class="meta">L<%= risk.likelihood %> · I<%= risk.impact %></div>
      </div>
      <div class="text-tertiary risk-delta-arrow" style="font-size:24px;">→</div>
      <div style="text-align:center;padding:14px;background:var(--bg-subtle);border-radius:8px;border:1px dashed var(--accent);">
        <div class="meta">Controls applied</div>
        <div style="font-size:18px;font-weight: 500;color:var(--accent);"><%= reduction > 0 ? '−' : '+' %><%= Math.abs(reduction) %></div>
        <div class="meta"><%= pctReduction %>% reduction</div>
      </div>
      <div class="text-tertiary risk-delta-arrow" style="font-size:24px;">→</div>
      <div style="text-align:center;padding:14px;background:<%= resColor %>1a;border-radius:8px;">
        <div class="meta">Residual</div>
        <div style="font-size:28px;font-weight: 500;color:<%= resColor %>;"><%= residualScore %></div>
        <div class="meta">L<%= risk.residual_likelihood %> · I<%= risk.residual_impact %></div>
      </div>
    </div>
  </div>
</div>
<% } %>

<div class="panel">
  <div class="panel-head"><h2>Linked Annex A controls</h2><span class="meta">Linking auto-includes the control in the SoA</span></div>
  <% const multiLinked = (controlGroups || []).length > 1; %>
  <% if (linked.length) { %>
    <div class="divide-row">
      <% linked.forEach(c => { %>
        <div class="text-lg risk-linked-row" style="padding:8px 16px;display:flex;align-items:center;justify-content:space-between;">
          <a href="<%= c.href %>" class="link-muted"><% if (multiLinked) { %><span class="meta"><%= c.frameworkLabel %></span> <% } %><%= c.title %></a>
          <form method="POST" action="/workspaces/<%= ws.id %>/risks/<%= risk.id %>/unlink">
            <input type="hidden" name="iso_item_id" value="<%= c.id %>">
            <button class="btn btn-ghost btn-xs text-danger">Unlink</button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="t-empty">No controls linked yet.</div>
  <% } %>
  <form method="POST" action="/workspaces/<%= ws.id %>/risks/<%= risk.id %>/link" class="panel-pad risk-link-form" style="display:flex;gap:6px;border-top:1px solid var(--border);background:var(--bg-subtle);">
    <%- include('partials/requirement_select', { groups: controlGroups, name: 'iso_item_id', blank: '- pick a control -' }) %>
    <button class="btn btn-primary btn-xs" style="white-space:nowrap;">Link</button>
  </form>
</div>

<%
  const acts = (typeof actions !== 'undefined' && actions) ? actions : [];
  const openActions = acts.filter(a => a.status !== 'done' && a.status !== 'cancelled').length;
  const doneActions = acts.filter(a => a.status === 'done').length;
%>
<div class="panel" style="margin-top:18px;">
  <div class="panel-head">
    <h2>Treatment plan actions <span class="meta text-lg" style="font-weight:400;">· Clause 6.1.3</span></h2>
    <span class="meta"><strong><%= openActions %></strong> open · <%= doneActions %> done · <%= acts.length %> total</span>
  </div>

  <% if (acts.length === 0) { %>
    <div class="panel-pad meta text-md">
      No actions yet. The treatment plan turns "we'll modify this risk" into a tracked workflow with owners and dates - what an auditor expects for clause 6.1.3.
    </div>
  <% } else { %>
    <table class="t">
      <thead><tr>
        <th>Action</th>
        <th style="width:130px;">Owner</th>
        <th style="width:120px;">Due</th>
        <th style="width:130px;">Status</th>
        <th style="width:140px;">Residual on close (L · I)</th>
        <th style="width:50px;"></th>
      </tr></thead>
      <tbody>
        <% acts.forEach(a => {
             const sev = a.status === 'done' ? '#16a34a' : a.status === 'in_progress' ? '#a16207' : a.status === 'cancelled' ? 'var(--text-tertiary)' : '#0891b2';
             const overdue = a.due_date && a.status !== 'done' && a.status !== 'cancelled' && a.due_date < new Date().toISOString().slice(0,10);
        %>
          <form method="POST" action="/workspaces/<%= ws.id %>/risks/<%= risk.id %>/actions/<%= a.id %>" class="contents">
            <tr>
              <td><input type="text" name="title" value="<%= a.title %>" class="input text-md" required></td>
              <td><input type="text" name="owner_name" value="<%= a.owner_name || '' %>" class="input text-md" placeholder="-"></td>
              <td><input type="date" name="due_date" value="<%= a.due_date || '' %>" class="input" style="font-size:12px;<%= overdue ? 'border-color:#b91c1c;color:#b91c1c;' : '' %>"></td>
              <td>
                <select name="status" class="select" style="font-size:12px;color:<%= sev %>;font-weight: 500;">
                  <% ['planned','in_progress','done','cancelled'].forEach(s => { %>
                    <option value="<%= s %>" <%= a.status === s ? 'selected' : '' %>><%= s %></option>
                  <% }) %>
                </select>
              </td>
              <td style="display:flex;gap:3px;">
                <input type="number" name="residual_likelihood" value="<%= a.residual_likelihood || '' %>" min="1" max="5" class="input text-base" style="width:48%;" placeholder="L">
                <input type="number" name="residual_impact" value="<%= a.residual_impact || '' %>" min="1" max="5" class="input text-base" style="width:48%;" placeholder="I">
              </td>
              <td><button class="btn btn-ghost btn-xs text-xs">Save</button></td>
            </tr>
          </form>
        <% }) %>
      </tbody>
    </table>
  <% } %>

  <form method="POST" action="/workspaces/<%= ws.id %>/risks/<%= risk.id %>/actions" class="panel-pad risk-action-create" style="border-top:1px solid var(--border);background:var(--bg-subtle);display:grid;grid-template-columns:1fr 140px 130px auto;gap:6px;align-items:end;">
    <div><label class="label">Add action</label><input class="input" name="title" required placeholder="e.g., Implement MFA on admin accounts"></div>
    <div><label class="label">Owner</label><input class="input" name="owner_name" placeholder="Name"></div>
    <div><label class="label">Due</label><input class="input" type="date" name="due_date"></div>
    <div><button class="btn btn-primary btn-xs">Add</button></div>
  </form>
</div>

<%
  const today = new Date().toISOString().slice(0,10);
  const acc = activeAcceptance;
  const expSoonDate = new Date(Date.now() + 30 * 86400000).toISOString().slice(0,10);
  const accExpired = acc && acc.expires_at && acc.expires_at < today;
  const accExpiringSoon = acc && !accExpired && acc.expires_at && acc.expires_at < expSoonDate;
%>
<div class="panel" style="margin-top:18px;">
  <div class="panel-head">
    <h2>Risk acceptance <span class="meta text-lg" style="font-weight:400;">· Clause 6.1.3 e</span></h2>
    <% if (acc) { %>
      <span class="meta">
        Accepted by <strong><%= acc.accepter_name %></strong>
        <% if (acc.expires_at) { %> · expires <strong style="color:<%= accExpired ? '#b91c1c' : accExpiringSoon ? '#a16207' : 'var(--text)' %>;"><%= acc.expires_at %></strong><% } %>
      </span>
    <% } %>
  </div>

  <% if (acc) {
       const sevColor = accExpired ? '#b91c1c' : accExpiringSoon ? '#a16207' : '#16a34a';
       const sevLabel = accExpired ? 'EXPIRED - RE-ACCEPT' : accExpiringSoon ? 'EXPIRES SOON' : 'CURRENT';
  %>
    <div class="panel-pad" style="background:<%= accExpired ? 'rgba(185,28,28,0.04)' : accExpiringSoon ? 'rgba(161,98,7,0.04)' : 'rgba(22,163,74,0.04)' %>;">
      <div style="display:flex;gap:8px;align-items:center;margin-bottom:8px;">
        <span style="font-size:9.5px;font-weight: 500;color:white;background:<%= sevColor %>;padding:2px 7px;border-radius:3px;letter-spacing:0.05em;"><%= sevLabel %></span>
        <span class="meta text-base">Signed <%= acc.signed_at %></span>
      </div>
      <% if (acc.accepter_role) { %><div class="meta text-base"><strong>Role:</strong> <%= acc.accepter_role %></div><% } %>
      <div class="meta text-md" style="margin-top:6px;line-height:1.55;"><strong>Rationale:</strong> <%= acc.rationale %></div>
      <div class="meta text-xs" style="margin-top:6px;font-family:monospace;">Residual score at acceptance: <%= acc.residual_score %> · Signature: <%= acc.signature.slice(0,20) %>…</div>
      <div class="risk-accept-actions" style="margin-top:10px;display:flex;gap:6px;">
        <a href="/workspaces/<%= ws.id %>/risks/<%= risk.id %>/acceptances" class="btn btn-secondary btn-xs">View acceptance history →</a>
        <form method="POST" action="/workspaces/<%= ws.id %>/risks/<%= risk.id %>/acceptances/<%= acc.id %>/revoke" onsubmit="return appConfirmForm(event, 'Revoke this acceptance? Risk will return to open.')" style="display:inline;">
          <button class="btn btn-ghost btn-xs text-danger">Revoke</button>
        </form>
      </div>
    </div>
  <% } %>

  <% if (!acc || accExpired) { %>
    <form method="POST" action="/workspaces/<%= ws.id %>/risks/<%= risk.id %>/accept" class="panel-pad risk-accept-form" style="<%= acc ? 'border-top:1px solid var(--border);' : '' %>display:grid;grid-template-columns:1fr 1fr 140px;gap:10px;align-items:start;">
      <div>
        <label class="label">Accepter name</label>
        <input class="input text-md" name="accepter_name" required placeholder="Person formally accepting">
      </div>
      <div>
        <label class="label">Role / authority</label>
        <input class="input text-md" name="accepter_role" placeholder="e.g., CISO, Risk Owner">
      </div>
      <div>
        <label class="label">Expires on <span class="meta">re-accept by this date</span></label>
        <input class="input text-md" type="date" name="expires_at" required>
      </div>
      <div class="col-full">
        <label class="label">Rationale <span class="meta">why is this residual risk acceptable</span></label>
        <textarea class="textarea text-md" name="rationale" rows="3" required placeholder="Why is the residual risk acceptable to the business? What compensating factors? When and why will it be re-evaluated?"></textarea>
      </div>
      <div class="col-full risk-accept-attestation" style="display:flex;gap:8px;align-items:center;">
        <label class="text-base" style="display:flex;gap:6px;align-items:center;cursor:pointer;">
          <input type="checkbox" name="attestation" value="1" required>
          I attest that I am authorised to accept this risk on behalf of the organisation.
        </label>
        <button class="btn btn-primary btn-xs" style="margin-left:auto;"><%= acc ? 'Re-accept risk' : 'Accept risk' %></button>
      </div>
    </form>
  <% } %>
</div>

<%- include('partials/footer') %>
