<%- include('partials/header', { title: 'Roadmap', user, ws, active: 'roadmap' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">Roadmap</h1>
    <div class="page-subtitle">Implementation roadmap aligned to ISO 27001:2022 PDCA - every step mapped to the relevant clause and a sensible "done" signal. The "Needs your attention" panel surfaces what to work on next.</div>
  </div>
</div>

<% if (typeof needsAttention !== 'undefined' && needsAttention.length > 0) {
     const naHigh = needsAttention.filter(i => i.severity === 'high').length;
     const naMedium = needsAttention.filter(i => i.severity === 'medium').length;
%>
  <div class="panel" style="margin-bottom:18px;">
    <div class="panel-head">
      <h2>Needs your attention <span class="meta text-lg" style="font-weight:400;">· live from data</span></h2>
      <span class="meta">
        <% if (naHigh > 0) { %><strong class="text-danger"><%= naHigh %></strong> high · <% } %>
        <% if (naMedium > 0) { %><strong class="text-warn"><%= naMedium %></strong> medium · <% } %>
        <a href="/workspaces/<%= ws.id %>/notifications" style="color:var(--accent);">view all in inbox →</a>
      </span>
    </div>
    <% needsAttention.forEach(c => {
         const dotColor = c.severity === 'high' ? '#dc2626' : c.severity === 'medium' ? '#ca8a04' : 'var(--accent)';
    %>
      <div style="padding:9px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px;">
        <span style="width:8px;height:8px;border-radius:50%;flex-shrink:0;background:<%= dotColor %>;"></span>
        <div style="flex:1;min-width:0;">
          <div class="text-md" style="font-weight:500;"><%= c.title %></div>
          <% if (c.detail) { %><div class="meta text-xs"><%= c.detail %></div><% } %>
        </div>
        <span class="tag tag-neutral text-xxs"><%= c.category %></span>
        <a href="<%= c.link %>" class="btn btn-secondary btn-xs">→</a>
      </div>
    <% }) %>
  </div>
<% } %>

<% if (typeof roadmap !== 'undefined') {
     const completed = roadmap.filter(r => r.done).length;
     const partials = roadmap.filter(r => r.partial).length;
     const phases = [
       { key: 'plan',  label: 'Plan',  blurb: 'Context, scope, risks, SoA',           color: '#0891b2' },
       { key: 'do',    label: 'Do',    blurb: 'Implement controls and documents',     color: '#475569' },
       { key: 'check', label: 'Check', blurb: 'Internal audit and management review', color: '#a16207' },
       { key: 'act',   label: 'Act',   blurb: 'Close NCs and improve',                color: '#16a34a' }
     ];
%>
<div class="panel" style="margin-bottom:20px;">
  <div class="panel-head">
    <h2>Implementation roadmap <span class="meta text-lg" style="font-weight:400;">· PDCA</span></h2>
    <span class="meta"><strong><%= completed %></strong> / <%= roadmap.length %> done<% if (partials) { %> · <%= partials %> in progress<% } %></span>
  </div>

  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:0;border-bottom:1px solid var(--border);">
    <% phases.forEach((ph, idx) => {
         const items = roadmap.filter(r => r.phase === ph.key);
         const phDone = items.filter(r => r.done).length;
         const phPct  = items.length ? Math.round(phDone / items.length * 100) : 0;
    %>
      <div style="padding:10px 14px;<%= idx > 0 ? 'border-left:1px solid var(--border);' : '' %>">
        <div style="display:flex;justify-content:space-between;align-items:baseline;gap:8px;">
          <span style="font-weight: 500;font-size:13px;color:<%= ph.color %>;text-transform:uppercase;letter-spacing:0.04em;"><%= ph.label %></span>
          <span class="num meta text-sm"><%= phDone %>/<%= items.length %></span>
        </div>
        <div class="meta text-xs" style="margin-bottom:6px;"><%= ph.blurb %></div>
        <div style="height:4px;background:var(--bg-subtle);border-radius:2px;overflow:hidden;">
          <div style="height:100%;width:<%= phPct %>%;background:<%= ph.color %>;transition:width 0.2s;"></div>
        </div>
      </div>
    <% }) %>
  </div>

  <% phases.forEach(ph => {
       const items = roadmap.filter(r => r.phase === ph.key);
       if (items.length === 0) return;
  %>
    <div style="padding:8px 16px;background:var(--bg-subtle);border-bottom:1px solid var(--border);font-size:11px;font-weight: 500;text-transform:uppercase;letter-spacing:0.05em;color:<%= ph.color %>;">
      <%= ph.label %> <span class="meta" style="font-weight:400;text-transform:none;letter-spacing:normal;">· <%= ph.blurb %></span>
    </div>
    <% items.forEach((r, i) => {
         const tickColor = r.done ? '#16a34a' : r.partial ? '#ea580c' : 'var(--text-tertiary)';
         const tickBg    = r.done ? 'rgba(22,163,74,0.10)' : r.partial ? 'rgba(234,88,12,0.10)' : 'var(--bg-subtle)';
         const tickGlyph = r.done ? '✓' : r.partial ? '·' : (i + 1);
    %>
      <div style="display:grid;grid-template-columns:30px 1fr auto;gap:10px;padding:10px 16px;border-bottom:1px solid var(--border);align-items:start;">
        <div style="width:26px;height:26px;border-radius:13px;background:<%= tickBg %>;color:<%= tickColor %>;display:flex;align-items:center;justify-content:center;font-weight: 500;font-size:12px;flex-shrink:0;"><%= tickGlyph %></div>
        <div style="min-width:0;">
          <div style="font-size:13.5px;font-weight:500;line-height:1.3;"><%= r.label %> <span class="meta" style="font-weight:400;">· <%= r.clause %></span></div>
          <div class="meta text-base" style="margin-top:2px;line-height:1.4;"><%= r.detail %></div>
        </div>
        <a href="<%= r.link %>" class="btn <%= r.done ? 'btn-ghost' : 'btn-secondary' %> btn-xs" style="white-space:nowrap;<%= r.done ? 'color:var(--text-secondary);' : '' %>"><%= r.done ? 'Review →' : '→ ' + r.link_label %></a>
      </div>
    <% }) %>
  <% }) %>
</div>
<% } %>

<%- include('partials/footer') %>
