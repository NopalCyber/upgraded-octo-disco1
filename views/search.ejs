<%- include('partials/header', { title: 'Search', user, ws, active: 'search' }) %>

<div class="page-head">
  <div><h1 class="page-title">Search</h1>
    <div class="page-subtitle">Full-text search across risks, assets, controls, documents, suppliers, NCs, incidents.</div></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/search/rebuild" onsubmit="return appConfirmForm(event, 'Rebuild the entire search index for this client?')"><button class="btn btn-secondary btn-xs">Rebuild index</button></form>
</div>

<div class="panel" style="margin-bottom:14px">
  <form method="GET" class="panel-pad row">
    <input class="input text-xl" name="q" value="<%= q %>" placeholder="Search…" autofocus>
    <button class="btn btn-primary">Search</button>
  </form>
</div>

<% if (q && !results.length) { %>
  <div class="empty-state"><div class="empty-sub">No results for "<%= q %>". If you've recently added content, hit "Rebuild index" above.</div></div>
<% } %>

<% if (results.length) { %>
<div class="panel"><table class="t">
  <thead><tr><th>Type</th><th>Title</th><th>Excerpt</th></tr></thead>
  <tbody>
    <% results.forEach(r => {
         const link = r.entity_type === 'risk' ? `/workspaces/${ws.id}/risks/${r.entity_id}`
                   : r.entity_type === 'asset' ? `/workspaces/${ws.id}/assets/${r.entity_id}`
                   : r.entity_type === 'control' ? `/workspaces/${ws.id}/controls/${r.entity_id}`
                   : r.entity_type === 'document' ? `/workspaces/${ws.id}/documents/${r.entity_id}`
                   : r.entity_type === 'supplier' ? `/workspaces/${ws.id}/vendors/${r.entity_id}`
                   : r.entity_type === 'nc' ? `/workspaces/${ws.id}/nonconformities/${r.entity_id}`
                   : r.entity_type === 'incident' ? `/workspaces/${ws.id}/incidents/${r.entity_id}`
                   : '#';
    %>
      <tr style="cursor:pointer" onclick="location='<%= link %>'">
        <td><span class="tag tag-info text-eyebrow" style="text-transform:uppercase;"><%= r.entity_type %></span></td>
        <td><strong><%= r.title %></strong></td>
        <td class="meta text-md" style="max-width:580px;"><%- (r.excerpt || '').replace(/<<(.+?)>>/g, '<mark style="background:#fffbe6;color:#854d0e;padding:0 2px;">$1</mark>') %></td>
      </tr>
    <% }) %>
  </tbody>
</table></div>
<% } %>

<%- include('partials/footer') %>
