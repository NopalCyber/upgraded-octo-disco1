<%- include('partials/header', { title: 'Statement of Applicability', user, ws, active: 'soa' }) %>

<style>
  @media (max-width: 760px) {
    .soa-table-wrap {
      max-width: 100%;
      overflow-x: auto !important;
      overscroll-behavior-inline: contain;
      -webkit-overflow-scrolling: touch;
    }
    .soa-table-wrap > table {
      display: table;
      width: 100%;
      min-width: 1100px;
      max-width: none;
      overflow: visible;
    }
  }
</style>

<div class="page-head">
  <div>
    <h1 class="page-title">Statement of Applicability</h1>
    <div class="page-subtitle">Mandatory ISO 27001 document (clause 6.1.3.d). Applicability and justification for all 93 Annex A controls, plus any non-Annex-A controls you've added.</div>
  </div>
  <div class="row">
    <button type="button" id="soaSaveAll" class="btn btn-primary btn-xs" style="display:none;" title="Flush every pending row change in one batched request. Useful at the end of a sweep; beats waiting for the per-row debounce to settle.">Save all changes <span id="soaSaveAllCount" class="num"></span></button>
    <span class="text-xs" id="soaAutosaveStatus" style="line-height:1;align-self:center;padding:5px 10px;border-radius:999px;background:var(--bg-subtle,#f3f4f6);border:1px solid var(--border,#e5e7eb);color:var(--text-secondary,#6b7280);white-space:nowrap;" data-state="idle" title="Edits to applicability, status, and justification autosave ~500ms after you stop typing. Use Save all changes to flush immediately.">All changes saved</span>
    <form method="POST" action="/workspaces/<%= ws.id %>/soa/auto-justify" style="display:inline" onsubmit="return appConfirmForm(event, 'For every Annex A control that any open risk has selected as a treatment, mark it Included and pre-fill an inclusion justification of the form &quot;Treats {risk titles}&quot;. Existing justifications are not overwritten. This is the fastest way to a defensible first-pass SoA. You can edit each justification afterwards. Continue?')"><button class="btn btn-secondary btn-xs" title="For every control linked to a risk: mark Included + write justification of the form 'Treats X, Y, Z'. Existing justifications kept. Idempotent.">Auto-justify from risks</button></form>
    <form method="POST" action="/workspaces/<%= ws.id %>/soa/snapshot" style="display:inline"><input type="hidden" name="label" value="Manual snapshot"><button class="btn btn-secondary btn-xs" title="Capture an immutable, hashed copy of the current SoA state. Auditors compare snapshots over time - capture before each MRM and before each audit.">Capture snapshot</button></form>
    <a href="/workspaces/<%= ws.id %>/export/soa.csv" class="btn btn-secondary btn-xs">Export CSV</a>
    <a href="/workspaces/<%= ws.id %>/export/rtp.docx" class="btn btn-secondary btn-xs">RTP ↓</a>
    <% if (ws.engagement_outcome !== 'gap_assessment_only') { %><a href="/workspaces/<%= ws.id %>/export/readiness-pack.zip?stage=1" class="btn btn-primary btn-xs">Readiness pack ↓</a><% } %>
  </div>
</div>

<%- include('partials/soa_tabs', { ws, tab: 'current' }) %>

<details class="panel" style="margin-bottom:10px;<%= !soaMeta.version && !soaMeta.owner && !soaMeta.approved_by ? '' : '' %>" <%= !soaMeta.version && !soaMeta.owner && !soaMeta.approved_by ? 'open' : '' %>>
  <summary class="panel-pad text-lg" style="cursor:pointer;font-weight:500;display:flex;align-items:center;gap:8px;">
    <span style="font-weight: 500;">SoA metadata</span>
    <% if (soaMeta.version || soaMeta.owner || soaMeta.approved_by) { %>
      <% if (soaMeta.version) { %><span class="tag tag-info text-eyebrow">v<%= soaMeta.version %></span><% } %>
      <% if (soaMeta.owner) { %><span class="meta text-xs">owner: <%= soaMeta.owner %></span><% } %>
      <% if (soaMeta.approved_by) { %><span class="meta text-xs">approved by <%= soaMeta.approved_by %><% if (soaMeta.approved_at) { %> on <%= soaMeta.approved_at %><% } %></span><% } %>
    <% } else { %>
      <span class="tag tag-warn text-eyebrow">missing - auditors expect this on arrival</span>
    <% } %>
  </summary>
  <form method="POST" action="/workspaces/<%= ws.id %>/soa/metadata" class="panel-pad stack-grid" style="--cols:1fr 1fr 1fr 1fr;border-top:1px solid var(--border);background:var(--bg-subtle);gap:10px;">
    <div><label class="label">Version</label><input class="input" name="version" value="<%= soaMeta.version || '' %>" placeholder="e.g., 1.2"></div>
    <div><label class="label">Owner</label><input class="input" name="owner" value="<%= soaMeta.owner || '' %>" placeholder="e.g., CISO"></div>
    <div><label class="label">Approved by</label><input class="input" name="approved_by" value="<%= soaMeta.approved_by || '' %>" placeholder="e.g., CEO"></div>
    <div><label class="label">Approved on</label><input type="date" class="input" name="approved_at" value="<%= soaMeta.approved_at || '' %>"></div>
    <div class="col-full row-center">
      <button class="btn btn-primary btn-xs">Save metadata</button>
      <span class="meta text-xs">Saving captures a fresh SoA snapshot if none exists.</span>
    </div>
  </form>
</details>

<%
  const cTot   = (typeof soaCounts !== 'undefined') ? soaCounts.total : 93;
  const cInc   = (typeof soaCounts !== 'undefined') ? soaCounts.included : 0;
  const cExc   = (typeof soaCounts !== 'undefined') ? soaCounts.excluded : 0;
  const cUnd   = (typeof soaCounts !== 'undefined') ? soaCounts.undecided : 0;
  const willFlipAll = cTot - cInc;
  const incAllMsg = `Mark every Annex A control as Included? This will flip ${willFlipAll} row${willFlipAll === 1 ? '' : 's'} (${cUnd} undecided + ${cExc} excluded → included). The ${cInc} already-included rows are untouched. Existing per-row justifications are kept; the bulk justification only applies to rows it actually changes.`;
  const incUndMsg = `Flip every Undecided Annex A control to Included? This will change ${cUnd} row${cUnd === 1 ? '' : 's'}. Existing Included / Excluded decisions are not touched.`;
%>
<details class="panel" style="margin-bottom:10px;">
  <summary class="panel-pad text-lg" style="cursor:pointer;font-weight:500;">+ Bulk decide applicability <span class="meta" style="font-weight:400;">- <strong><%= cInc %></strong> included · <strong><%= cExc %></strong> excluded · <strong><%= cUnd %></strong> undecided</span></summary>
  <div class="panel-pad text-base text-secondary" style="border-top:1px solid var(--border);background:var(--bg-subtle);line-height:1.55;">
    <strong>Use this for the first-pass sweep.</strong> "Include all" marks every Annex A control as <em>Included</em> in one shot - auditors expect most controls to be included for ISO 27001:2022, so it's a defensible default. "Include undecided" only flips controls still marked <em>Undecided</em> (existing Excluded decisions stay). Add a justification once and it's stamped on every row affected. Per-row dropdowns below let you override individual controls afterwards (e.g., explicitly exclude controls that genuinely don't apply, with their own justification - required by clause 6.1.3.d).
  </div>
  <form method="POST" action="/workspaces/<%= ws.id %>/soa/bulk" class="panel-pad" style="border-top:1px solid var(--border);background:var(--bg-subtle);display:grid;grid-template-columns:1fr auto auto;gap:8px;align-items:end;">
    <div class="col-full">
      <label class="label">Justification (optional, applied to every affected row)</label>
      <input class="input" name="justification" placeholder="e.g., Required by linked risks per client risk register">
    </div>
    <button name="action" value="include_all" class="btn btn-secondary btn-xs" <%= willFlipAll === 0 ? 'disabled title="All rows are already Included"' : '' %> onclick="return appConfirmClick(event, '<%= incAllMsg.replace(/'/g, "\\'") %>')">Include all <span class="meta">(flips <%= willFlipAll %>)</span></button>
    <button name="action" value="include_undecided" class="btn btn-secondary btn-xs" <%= cUnd === 0 ? 'disabled title="No undecided rows"' : '' %> onclick="return appConfirmClick(event, '<%= incUndMsg.replace(/'/g, "\\'") %>')">Include undecided <span class="meta">(<%= cUnd %>)</span></button>
  </form>
</details>

<div class="panel soa-table-wrap" style="overflow:hidden">
  <table class="t">
    <thead><tr>
      <th style="width:60px">ID</th>
      <th>Control</th>
      <th style="width:200px" title="Risks treated by this control - required by 6.1.3.d.1">Risks treated</th>
      <th style="width:240px">Covered by (linked documents)</th>
      <th style="width:140px">Applicability</th>
      <th style="width:170px">Status</th>
      <th>Justification</th>
    </tr></thead>
    <tbody>
      <% rows.forEach(r => {
           const linkedDocs = (docsByControl && docsByControl[r.id]) || [];
           const linkedRisks = (typeof risksByControl !== 'undefined' && risksByControl[r.id]) || [];
      %>
        <form method="POST" action="/workspaces/<%= ws.id %>/soa/<%= r.id %>" class="contents">
          <tr>
            <td><span class="iso-ref"><%= r.id.replace('annex-', '').toUpperCase() %></span></td>
            <td><a href="/workspaces/<%= ws.id %>/controls/<%= r.id %>" class="link-muted"><%= r.title.replace(/^A\.[0-9.]+ /, '') %></a><% if (r.systemic_count >= 3) { %> <span class="tag tag-danger text-xxs" title="<%= r.systemic_count %> findings in last 12 months">SYSTEMIC</span><% } %><% if (r.last_verified_at) { %><div class="meta text-eyebrow">verified <%= r.last_verified_at.slice(0,10) %></div><% } %></td>
            <td class="text-sm" style="line-height:1.4;">
              <% if (linkedRisks.length === 0) { %>
                <% if (r.applicability === 'included') { %>
                  <span class="tag tag-warn text-xxs" title="An included control with no linked risk fails 6.1.3.d.1">unjustified</span>
                <% } else { %>
                  <span class="meta">-</span>
                <% } %>
              <% } else { %>
                <% linkedRisks.slice(0, 3).forEach((rk, idx) => { %><a href="/workspaces/<%= ws.id %>/risks/<%= rk.risk_id %>" title="<%= rk.risk_title %> · L<%= rk.likelihood %>×I<%= rk.impact %>" style="color:var(--accent);text-decoration:none;border-bottom:1px dotted var(--accent);">R-<%= rk.risk_id %></a><% if (idx < Math.min(linkedRisks.length, 3) - 1) { %><span class="meta">, </span><% } %><% }) %><% if (linkedRisks.length > 3) { %><span class="meta"> +<%= linkedRisks.length - 3 %></span><% } %>
              <% } %>
            </td>
            <td>
              <% if (linkedDocs.length === 0) { %>
                <span class="meta">-</span>
              <% } else { %>
                <% linkedDocs.forEach((d, idx) => { %><a class="text-base" href="/workspaces/<%= ws.id %>/documents/<%= d.doc_id %>" style="color:var(--accent);text-decoration:none;" title="<%= d.category || '' %> · <%= d.doc_status %>"><%= d.doc_name %><% if (d.section_ref) { %> <%= d.section_ref %><% } %></a><% if (idx < linkedDocs.length - 1) { %><span class="meta">, </span><% } %><% }) %>
              <% } %>
            </td>
            <td>
              <select name="applicability" class="select text-base" style="padding:4px 8px;">
                <option value="undecided" <%= r.applicability === 'undecided' ? 'selected' : '' %>>Undecided</option>
                <option value="included" <%= r.applicability === 'included' ? 'selected' : '' %>>Included</option>
                <option value="excluded" <%= r.applicability === 'excluded' ? 'selected' : '' %>>Excluded</option>
              </select>
            </td>
            <td>
              <select name="status" class="select text-base" style="padding:4px 8px;">
                <% ['Not Assessed','Implemented','Partially Implemented','Work In Progress','Not Implemented','Not Applicable'].forEach(s => { %>
                  <option value="<%= s %>" <%= r.status === s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </td>
            <td>
              <textarea name="<%= r.applicability === 'excluded' ? 'exclusion_justification' : 'inclusion_justification' %>" rows="1" class="textarea text-base" style="padding:4px 8px;" placeholder="<%= r.applicability === 'excluded' ? 'Why excluded' : 'Why included' %>"><%= r.applicability === 'excluded' ? (r.exclusion_justification || '') : (r.inclusion_justification || '') %></textarea>
            </td>
          </tr>
        </form>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="panel" style="margin-top:18px;">
  <div class="panel-head">
    <h3>Custom (non-Annex-A) controls <span class="meta text-base" style="font-weight:400;">- additional controls beyond Annex A (regulatory, contractual, internal)</span></h3>
    <span class="meta"><%= customControls.length %> custom</span>
  </div>
  <% if (customControls.length === 0) { %>
    <div class="panel-pad meta text-md">No custom controls. Most clients don't need any - Annex A covers the common ground. Add only if a real control exists outside Annex A.</div>
  <% } else { %>
    <div class="soa-table-wrap">
    <table class="t">
      <thead><tr>
        <th style="width:90px;">Code</th>
        <th>Title</th>
        <th style="width:120px;">Source</th>
        <th style="width:120px;">Applicability</th>
        <th style="width:140px;">Status</th>
        <th>Justification</th>
        <th style="width:60px;"></th>
      </tr></thead>
      <tbody>
        <% customControls.forEach(c => { %>
          <form method="POST" action="/workspaces/<%= ws.id %>/soa/custom-controls/<%= c.id %>" class="contents">
            <tr>
              <td><input class="input mono text-base" name="code" value="<%= c.code %>" style="padding:4px 6px;"></td>
              <td><input class="input text-md" name="title" value="<%= c.title %>" style="padding:4px 6px;"></td>
              <td><input class="input text-base" name="source_framework" value="<%= c.source_framework || '' %>" placeholder="Internal" style="padding:4px 6px;"></td>
              <td>
                <select name="applicability" class="select text-base" style="padding:4px 8px;">
                  <% ['undecided','included','excluded'].forEach(a => { %><option value="<%= a %>" <%= c.applicability === a ? 'selected' : '' %>><%= a %></option><% }) %>
                </select>
              </td>
              <td>
                <select name="status" class="select text-base" style="padding:4px 8px;">
                  <% ['Not Assessed','Implemented','Partially Implemented','Work In Progress','Not Implemented','Not Applicable'].forEach(s => { %><option value="<%= s %>" <%= c.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
                </select>
              </td>
              <td>
                <textarea name="<%= c.applicability === 'excluded' ? 'exclusion_justification' : 'inclusion_justification' %>" rows="1" class="textarea text-base" style="padding:4px 8px;"><%= c.applicability === 'excluded' ? (c.exclusion_justification || '') : (c.inclusion_justification || '') %></textarea>
              </td>
              <td>
                <button formaction="/workspaces/<%= ws.id %>/soa/custom-controls/<%= c.id %>/delete" formmethod="POST" class="btn btn-ghost btn-xs text-xs text-danger" onclick="return appConfirmClick(event, 'Delete custom control <%= c.code %>?')">×</button>
              </td>
            </tr>
          </form>
        <% }) %>
      </tbody>
    </table>
    </div>
  <% } %>
  <details style="border-top:1px solid var(--border);">
    <summary class="panel-pad text-md" style="cursor:pointer;color:var(--accent);">+ Add custom control</summary>
    <form method="POST" action="/workspaces/<%= ws.id %>/soa/custom-controls" class="panel-pad stack-grid" style="--cols:120px 1fr 160px 140px;background:var(--bg-subtle);gap:8px;">
      <input class="input mono text-md" name="code" placeholder="C-001" required>
      <input class="input text-md" name="title" placeholder="Control title" required>
      <input class="input text-md" name="source_framework" placeholder="Regulation / Internal">
      <select class="select text-md" name="applicability">
        <option value="included">Included</option>
        <option value="excluded">Excluded</option>
        <option value="undecided">Undecided</option>
      </select>
      <textarea class="textarea text-md col-full" name="description" rows="2" placeholder="What this control does (optional)"></textarea>
      <textarea class="textarea text-md col-full" name="inclusion_justification" rows="2" placeholder="Why this control is necessary - what risk does it treat?"></textarea>
      <button class="btn btn-primary btn-xs col-full">Add custom control</button>
    </form>
  </details>
</div>

<script>
(function () {
  const status = document.getElementById('soaAutosaveStatus');
  if (!status) return;

  const DEBOUNCE_MS = 500;
  const timers = new WeakMap();
  let inFlight = 0;
  let lastError = null;

  function setStatus() {
    if (lastError) {
      status.textContent = 'Couldn’t save - retrying on next edit';
      status.style.background = 'rgba(185,28,28,0.08)';
      status.style.borderColor = 'rgba(185,28,28,0.3)';
      status.style.color = '#b91c1c';
      status.dataset.state = 'error';
    } else if (inFlight > 0) {
      status.textContent = inFlight === 1 ? 'Saving…' : `Saving ${inFlight}…`;
      status.style.background = 'rgba(37,99,235,0.08)';
      status.style.borderColor = 'rgba(37,99,235,0.3)';
      status.style.color = '#1d4ed8';
      status.dataset.state = 'saving';
    } else {
      status.textContent = 'All changes saved';
      status.style.background = '';
      status.style.borderColor = '';
      status.style.color = '';
      status.dataset.state = 'idle';
    }
  }

  async function submitRow(form) {
    if (typeof window._csrfStamp === 'function') window._csrfStamp(form);
    const params = new URLSearchParams();
    new FormData(form).forEach((v, k) => params.append(k, v));
    const url = form.action + (form.action.includes('?') ? '&' : '?') + 'ajax=1';
    inFlight++;
    setStatus();
    try {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params,
        credentials: 'same-origin',
        redirect: 'manual'
      });
      const ok = res.ok || res.status === 204 || res.status === 0 || res.type === 'opaqueredirect' || (res.status >= 300 && res.status < 400);
      lastError = ok ? null : `HTTP ${res.status}`;
    } catch (e) {
      lastError = String(e);
    } finally {
      inFlight--;
      setStatus();
    }
  }

  const dirty = new Set();
  const saveAllBtn = document.getElementById('soaSaveAll');
  const saveAllCount = document.getElementById('soaSaveAllCount');
  function paintSaveAll() {
    if (!saveAllBtn) return;
    const n = dirty.size;
    if (n === 0) { saveAllBtn.style.display = 'none'; return; }
    saveAllBtn.style.display = 'inline-flex';
    saveAllCount.textContent = '(' + n + ')';
  }

  function schedule(form) {
    dirty.add(form);
    paintSaveAll();
    clearTimeout(timers.get(form));
    timers.set(form, setTimeout(() => {
      submitRow(form).then(() => {
        if (!lastError) dirty.delete(form);
        paintSaveAll();
      });
    }, DEBOUNCE_MS));
  }

  async function saveAll() {
    if (!saveAllBtn || dirty.size === 0) return;
    const wsMatch = location.pathname.match(/\/workspaces\/(\d+)/);
    if (!wsMatch) return;
    dirty.forEach(form => clearTimeout(timers.get(form)));
    const rows = [];
    dirty.forEach(form => {
      const action = form.action || '';
      const m = action.match(/\/soa\/([^?]+)/);
      if (!m) return;
      const iso_item_id = m[1];
      const fd = new FormData(form);
      rows.push({
        iso_item_id,
        applicability: fd.get('applicability') || '',
        status: fd.get('status') || '',
        inclusion_justification: fd.get('inclusion_justification') || '',
        exclusion_justification: fd.get('exclusion_justification') || ''
      });
    });
    const params = new URLSearchParams();
    params.set('rows', JSON.stringify(rows));
    if (window._csrfToken) params.set('_csrf', window._csrfToken);
    inFlight++; setStatus(); saveAllBtn.disabled = true;
    try {
      const res = await fetch(`/workspaces/${wsMatch[1]}/soa/batch`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params, credentials: 'same-origin'
      });
      if (res.ok) { dirty.clear(); lastError = null; }
      else lastError = 'HTTP ' + res.status;
    } catch (e) { lastError = String(e); }
    finally { inFlight--; saveAllBtn.disabled = false; setStatus(); paintSaveAll(); }
  }
  if (saveAllBtn) saveAllBtn.addEventListener('click', saveAll);

  function handle(e) {
    const form = e.target && e.target.form;
    if (!form) return;
    const action = form.action || '';
    if (!/\/soa\//.test(action)) return;
    schedule(form);
  }
  document.addEventListener('input', handle);
  document.addEventListener('change', handle);
})();
</script>

<%- include('partials/footer') %>
