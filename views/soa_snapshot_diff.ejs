<%- include('partials/header', { title: 'SoA diff', user, ws, active: 'soa' }) %>

<div class="page-head">
  <div><h1 class="page-title">Statement of Applicability</h1>
    <div class="page-subtitle">Diff between two snapshots - added, removed, applicability change, status change, justification edits.</div></div>
  <form class="row" method="GET" action="/workspaces/<%= ws.id %>/soa/snapshots/diff">
    <select name="a" class="select"><option value="">- pick A -</option><% all.forEach(s => { %><option value="<%= s.id %>" <%= sa && sa.id === s.id ? 'selected' : '' %>><%= s.label || s.created_at %></option><% }) %></select>
    <span class="meta" style="line-height:32px;">vs</span>
    <select name="b" class="select"><option value="">- pick B -</option><% all.forEach(s => { %><option value="<%= s.id %>" <%= sb && sb.id === s.id ? 'selected' : '' %>><%= s.label || s.created_at %></option><% }) %></select>
    <button class="btn btn-secondary btn-xs">Compare</button>
  </form>
</div>

<%- include('partials/soa_tabs', { ws, tab: 'diff' }) %>

<% if (!diff) { %><div class="panel"><div class="panel-pad meta">Pick two snapshots above.</div></div>
<% } else if (!diff.length) { %><div class="panel"><div class="panel-pad meta">No differences. Identical SoA state.</div></div>
<% } else { %>
  <div class="panel"><table class="t">
    <thead><tr><th>Control</th><th>Title</th><th>Changes</th></tr></thead>
    <tbody>
      <% diff.forEach(d => { %>
        <tr>
          <td class="mono meta"><%= d.id.replace('annex-','').toUpperCase() %></td>
          <td><%= d.title %></td>
          <td><% d.changes.forEach(c => { %><div class="meta text-sm" style="font-family:ui-monospace,monospace;"><%= c %></div><% }) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
<% } %>

<%- include('partials/footer') %>
