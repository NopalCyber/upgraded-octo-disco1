<%- include('partials/header', { title: 'SoA snapshots', user, ws, active: 'soa' }) %>

<div class="page-head">
  <div><h1 class="page-title">Statement of Applicability</h1>
    <div class="page-subtitle">Immutable, hashed snapshots of the SoA. Auditors will ask "what changed since last cert?" - capture before each MRM and before each audit.</div></div>
  <form class="row-center" method="POST" action="/workspaces/<%= ws.id %>/soa/snapshot">
    <input class="input" name="label" placeholder="Snapshot label">
    <input class="input" name="reason" placeholder="Reason">
    <button class="btn btn-primary btn-xs">Capture now</button>
  </form>
</div>

<%- include('partials/soa_tabs', { ws, tab: 'snapshots' }) %>

<% if (snapshots.length >= 2) { %>
<div class="panel" style="margin-bottom:14px">
  <form method="GET" action="/workspaces/<%= ws.id %>/soa/snapshots/diff" class="panel-pad" style="display:flex;gap:8px;align-items:center;">
    <span class="meta">Compare:</span>
    <select name="a" class="select" style="width:auto"><% snapshots.forEach(s => { %><option value="<%= s.id %>"><%= s.label || s.created_at %></option><% }) %></select>
    <span class="meta">vs</span>
    <select name="b" class="select" style="width:auto"><% snapshots.forEach((s,i) => { %><option value="<%= s.id %>" <%= i === 0 ? 'selected' : '' %>><%= s.label || s.created_at %></option><% }) %></select>
    <button class="btn btn-secondary btn-xs">Diff</button>
  </form>
</div>
<% } %>

<div class="panel">
  <table class="t">
    <thead><tr><th>Label</th><th>When</th><th>Author</th><th class="num">Controls</th><th class="num">Inc.</th><th class="num">Exc.</th><th>Hash</th></tr></thead>
    <tbody>
      <% if (!snapshots.length) { %><tr><td colspan="7" class="t-empty">No snapshots yet - capture one before your first audit.</td></tr><% } %>
      <% snapshots.forEach(s => { %>
        <tr style="cursor:pointer" onclick="location='/workspaces/<%= ws.id %>/soa/snapshots/<%= s.id %>'">
          <td><strong><%= s.label || '(unlabelled)' %></strong><% if (s.reason) { %><div class="meta"><%= s.reason %></div><% } %></td>
          <td class="meta"><%= s.created_at %></td>
          <td class="meta"><%= s.author %></td>
          <td class="num"><%= s.control_count %></td>
          <td class="num text-success"><%= s.included_count %></td>
          <td class="num text-danger"><%= s.excluded_count %></td>
          <td class="meta mono text-eyebrow"><%= s.payload_hash.slice(0,12) %>…</td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
