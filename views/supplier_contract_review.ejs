<%- include('partials/header', { title: 'Supplier contract review', user, ws, active: 'vendors' }) %>
<link rel="stylesheet" href="/tprm.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>">
<div class="tprm-workbench">
<% const retainedReadOnly = typeof tprmReadOnly !== 'undefined' && tprmReadOnly; %>
<% const canManageFindings = typeof userPerms !== 'undefined' && userPerms && (typeof userPerms.has === 'function' ? userPerms.has('tprm.finding.manage') : userPerms.includes('tprm.finding.manage')); %>
<% if (retainedReadOnly) { %><div class="panel" style="margin-bottom:16px"><div class="panel-pad"><strong>Retained history - read only.</strong><div class="meta"><%= tprmReadOnlyReason %></div></div></div><% } %>
<div class="page-head"><div><a class="link-muted text-xs" href="/workspaces/<%= ws.id %>/vendors/<%= v.id %>">← <%= v.name %></a><h1 class="page-title" style="margin-top:8px">Contract and SLA review</h1><div class="page-subtitle">Internal assessment of the executed agreement and service commitments.</div></div></div>

<% if (!bundle) { %>
  <% if (retainedReadOnly) { %><div class="panel" style="max-width:760px"><div class="panel-pad"><h2>No retained contract review</h2><p class="meta">No contract review was recorded in this concluded service period. Start a new governed service period to perform one.</p></div></div><% } else { %><div class="panel" style="max-width:760px"><div class="panel-head"><h2>Start contract review</h2></div><form method="POST" action="/workspaces/<%= ws.id %>/vendors/<%= v.id %>/contract-review/start" class="panel-pad grid-2"><div><label class="label">Agreement reference</label><input class="input" name="agreement_reference" required></div><div><label class="label">Agreement date</label><input class="input" type="date" name="agreement_date" required></div><div class="col-full"><div class="meta" style="margin-bottom:12px">Both fields identify the executed agreement and are required before the governed review can start.</div><button class="btn btn-primary">Start 47-clause review</button></div></form></div><% } %>
<% } else { %>
  <% const contractClosed = retainedReadOnly || bundle.review.status === 'complete'; %>
  <div class="panel" style="margin-bottom:16px"><div class="panel-pad" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));padding:0"><div class="kpi" style="border-right:1px solid var(--border)"><div class="sec-label">Clauses</div><div class="kpi-num"><%= bundle.progress.total %></div></div><div class="kpi" style="border-right:1px solid var(--border)"><div class="sec-label">Complete</div><div class="kpi-num"><%= bundle.progress.complete %></div></div><div class="kpi" style="border-right:1px solid var(--border)"><div class="sec-label">Gaps identified</div><div class="kpi-num"><%= bundle.progress.gaps %></div></div><div class="kpi"><div class="sec-label">Decision blockers</div><div class="kpi-num"><%= bundle.progress.open %></div></div></div></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/vendors/<%= v.id %>/contract-review">
    <div class="panel" style="margin-bottom:12px">
      <div class="panel-head"><div><h2>Executed agreement</h2><div class="meta">These identifiers are mandatory for review completion and any positive supplier decision.</div></div></div>
      <div class="panel-pad grid-2">
        <div><label class="label">Agreement reference</label><input class="input" name="agreement_reference" value="<%= bundle.review.agreement_reference || '' %>" required <%= contractClosed?'disabled':'' %>></div>
        <div><label class="label">Agreement date</label><input class="input" type="date" name="agreement_date" value="<%= bundle.review.agreement_date || '' %>" required <%= contractClosed?'disabled':'' %>></div>
      </div>
    </div>
    <% const categories=[...new Set(methodology.contractClauses.map(c=>c.category))]; categories.forEach((category,index)=>{ const clauses=methodology.contractClauses.filter(c=>c.category===category); %><details class="panel" style="margin-bottom:12px" <%= index===0?'open':'' %>><summary class="panel-head" style="cursor:pointer;list-style:none"><h2><%= category %></h2><span class="meta"><%= clauses.length %> clauses</span></summary>
      <% clauses.forEach(clause=>{ const item=bundle.itemMap[clause.id]||{}; %><div id="clause-<%= clause.id %>" style="padding:18px;border-top:1px solid var(--border);scroll-margin-top:24px"><div style="display:flex;gap:10px;align-items:flex-start"><span class="tag tag-neutral"><%= clause.id %></span><div style="font-weight:600;line-height:1.45"><%= clause.requirement.replaceAll('{{client}}',ws.client_name) %></div></div><div class="meta" style="margin:5px 0 12px 58px"><%= clause.regulatoryBasis.replaceAll('{{client}}',ws.client_name) %> · Workbook scope: <%= clause.requiredWhen %></div><div style="display:grid;grid-template-columns:120px 1fr 1fr 280px;gap:10px"><div><label class="label">Required?</label><select class="select" name="required_<%= clause.id %>" <%= contractClosed?'disabled':'' %>><option value="1" <%= item.required!==0?'selected':'' %>>Yes</option><option value="0" <%= item.required===0?'selected':'' %>>No</option></select></div><div><label class="label">Clause status</label><select class="select" name="status_<%= clause.id %>" <%= contractClosed?'disabled':'' %>><% methodology.responses.contract.forEach(option=>{ %><option <%= (item.status||'Not Reviewed')===option?'selected':'' %>><%= option %></option><% }) %></select></div><div><label class="label">Contract reference</label><input class="input" name="reference_<%= clause.id %>" value="<%= item.contract_reference||'' %>" <%= contractClosed?'disabled':'' %>></div><div><label class="label">Linked finding <% if (!contractClosed && canManageFindings) { %><a href="/workspaces/<%= ws.id %>/vendors/<%= v.id %>/assessment-findings/new?source=contract&amp;assessment_id=<%= bundle.review.id %>&amp;item_key=<%= encodeURIComponent(clause.id) %>" style="float:right;font-weight:500">Create or link</a><% } %></label><select class="select" name="finding_<%= clause.id %>" <%= contractClosed?'disabled':'' %>><option value="">No linked finding</option><% findings.forEach(finding=>{ %><option value="<%= finding.id %>" <%= Number(item.finding_id)===finding.id?'selected':'' %>>#<%= finding.id %> · <%= finding.severity %> · <%= finding.title %></option><% }) %></select></div></div><input class="input" name="comments_<%= clause.id %>" value="<%= item.reviewer_comments||'' %>" placeholder="Reviewer comments" style="margin-top:8px" <%= contractClosed?'disabled':'' %>></div><% }) %>
    </details><% }) %>
    <% if (!contractClosed) { %><div class="row" style="margin-bottom:24px"><button class="btn btn-secondary" name="action" value="save">Save review</button><button class="btn btn-primary" name="action" value="complete">Complete contract review</button></div><% } else { %><div class="panel" style="margin-bottom:24px"><div class="panel-pad"><strong>Contract review complete</strong><div class="meta">This conclusion is locked. Start a new periodic review only when the agreement or service scope changes.</div></div></div><% } %>
  </form>
  <% if (!retainedReadOnly && contractClosed) { %>
    <div class="panel" style="max-width:760px;margin-bottom:24px">
      <div class="panel-head"><div><h2>Start a replacement review</h2><div class="meta">Use this when the executed agreement or service scope changes, or when a legacy review is missing its agreement identifiers.</div></div></div>
      <form method="POST" action="/workspaces/<%= ws.id %>/vendors/<%= v.id %>/contract-review/start" class="panel-pad grid-2">
        <div><label class="label">New agreement reference</label><input class="input" name="agreement_reference" required></div>
        <div><label class="label">New agreement date</label><input class="input" type="date" name="agreement_date" required></div>
        <div class="col-full"><button class="btn btn-primary">Start replacement 47-clause review</button></div>
      </form>
    </div>
  <% } %>
<% } %>
</div>
<%- include('partials/footer') %>
