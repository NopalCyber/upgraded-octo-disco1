<%- include('partials/header', { title: 'Third-party risk methodology', user, ws, active: 'vendors' }) %>
<link rel="stylesheet" href="/tprm.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>">
<div class="tprm-workbench">
<%
  const retainedReadOnly = typeof tprmReadOnly !== 'undefined' && tprmReadOnly;
  const visibleDraft = retainedReadOnly ? null : draftMethodology;
  const active = activeMethodology.definition;
  const draft = visibleDraft && visibleDraft.definition;
  const current = draft || active;
  const enabledBaseline = current.ddqQuestions.filter(question => question.enabled !== false);
  const enabledModules = current.modules.reduce((sum, module) => sum + module.questions.filter(question => question.enabled !== false).length, 0);
  const canonicalTprmText = value => String(value || '')
    .replace(/\bVendors\b/g, 'Third parties').replace(/\bvendors\b/g, 'third parties')
    .replace(/\bVendor\b/g, 'Third party').replace(/\bvendor\b/g, 'third party')
    .replace(/\bSuppliers\b/g, 'Third parties').replace(/\bsuppliers\b/g, 'third parties')
    .replace(/\bSupplier\b/g, 'Third party').replace(/\bsupplier\b/g, 'third party');
%>

<% if (retainedReadOnly) { %><div class="panel" style="margin-bottom:16px"><div class="panel-pad"><strong>Retained history - read only.</strong><div class="meta"><%= tprmReadOnlyReason %></div></div></div><% } %>

<div class="page-head">
  <div>
    <a class="link-muted text-xs" href="/workspaces/<%= ws.id %>/tprm/third-parties">← Third-party register</a>
    <h1 class="page-title" style="margin-top:8px">Third-party assessment methodology</h1>
    <div class="page-subtitle">Tier thresholds, question scope, review cadence and published versions.</div>
  </div>
  <% if (!retainedReadOnly && !visibleDraft) { %>
    <form method="POST" action="/workspaces/<%= ws.id %>/supplier-methodology/draft"><button class="btn btn-primary">Create editable version</button></form>
  <% } else if (!retainedReadOnly) { %>
    <form method="POST" action="/workspaces/<%= ws.id %>/supplier-methodology/publish"><button class="btn btn-primary">Validate and publish version <%= visibleDraft.version %></button></form>
  <% } %>
</div>

<div class="panel" style="margin-bottom:16px">
  <div class="panel-pad" style="display:grid;grid-template-columns:minmax(0,1.5fr) repeat(3,minmax(0,.65fr));padding:0">
    <div style="padding:20px;border-right:1px solid var(--border)">
      <div class="sec-label"><%= visibleDraft ? 'Editable draft' : retainedReadOnly ? 'Retained methodology' : 'Active published methodology' %></div>
      <h2 style="margin:7px 0 5px"><%= canonicalTprmText(current.title) %></h2>
      <div class="meta">Version <%= visibleDraft ? visibleDraft.version : activeMethodology.version %> · <%= visibleDraft ? 'not used by assessments until published' : retainedReadOnly ? 'retained from the concluded service period' : 'used for every new third-party assessment' %></div>
    </div>
    <div class="kpi" style="border-right:1px solid var(--border)"><div class="sec-label">Inherent inputs</div><div class="kpi-num"><%= current.scoring.questions.length %></div></div>
    <div class="kpi" style="border-right:1px solid var(--border)"><div class="sec-label">Baseline DDQ</div><div class="kpi-num"><%= enabledBaseline.length %></div><div class="meta">enabled questions</div></div>
    <div class="kpi"><div class="sec-label">Conditional DDQ</div><div class="kpi-num"><%= enabledModules %></div><div class="meta"><%= current.modules.length %> modules</div></div>
  </div>
</div>

<div class="panel" style="margin-bottom:16px;background:var(--surface-subtle)"><div class="panel-pad">
  <strong>Published assessments never change in place.</strong>
  <div class="meta" style="margin-top:4px">Edits are held in a draft. Publishing activates the new version only for assessments started afterwards. Existing inherent-risk, due-diligence and contract records retain their exact question and scoring snapshot.</div>
</div></div>

<nav class="tabs" style="margin-bottom:16px">
  <a class="tab <%= section==='methodology'?'active':'' %>" href="?section=methodology">Risk methodology</a>
  <a class="tab <%= section==='questionnaire'?'active':'' %>" href="?section=questionnaire">Questionnaire</a>
  <a class="tab <%= section==='versions'?'active':'' %>" href="?section=versions">Version history</a>
</nav>

<% if (visibleDraft && validation && !validation.ok) { %>
  <div class="panel" style="margin-bottom:16px"><div class="panel-head"><h2>Publication checks</h2><span class="status s-todo"><%= validation.errors.length %> blocking</span></div><div class="panel-pad"><% validation.errors.forEach(error => { %><div style="padding:5px 0"><%= error %></div><% }) %></div></div>
<% } %>

<% if (section === 'methodology') { %>
  <div class="panel" style="margin-bottom:16px">
    <div class="panel-head"><div><h2>Scoring and tier policy</h2><div class="meta">Weights total 100%. Minimum scores determine the calculated tier before mandatory floors are applied.</div></div></div>
    <form method="POST" action="/workspaces/<%= ws.id %>/supplier-methodology/general" class="panel-pad">
      <input type="hidden" name="section" value="methodology">
      <label class="label">Methodology name</label><input class="input" name="title" value="<%= canonicalTprmText(current.title) %>" <%= draft?'':'disabled' %>>
      <div style="display:grid;grid-template-columns:1.2fr .6fr .6fr;gap:8px;margin-top:16px" class="sec-label"><div>Tier</div><div>Minimum score</div><div>Review cadence</div></div>
      <% ['tier_1','tier_2','tier_3','tier_4'].forEach(tierId => { const tier=current.tiers[tierId]; %>
        <div style="display:grid;grid-template-columns:1.2fr .6fr .6fr;gap:8px;margin-top:8px"><input class="input" name="label_<%= tierId %>" value="<%= canonicalTprmText(tier.label) %>" <%= draft?'':'disabled' %>><input class="input" type="number" min="0" max="100" step="0.001" name="minimum_<%= tierId %>" value="<%= tier.minimumScore %>" <%= draft?'':'disabled' %>><div style="display:flex;align-items:center;gap:7px"><input class="input" type="number" min="1" name="cadence_<%= tierId %>" value="<%= tier.reviewCadenceMonths %>" <%= draft?'':'disabled' %>><span class="meta">months</span></div></div>
      <% }) %>
      <div class="sec-label" style="margin-top:22px">Factor weights</div>
      <% current.scoring.factors.forEach((factor,index) => { %><div style="display:grid;grid-template-columns:minmax(0,1fr) 150px;gap:8px;margin-top:8px"><input class="input" name="factor_name_<%= index %>" value="<%= canonicalTprmText(factor.name) %>" <%= draft?'':'disabled' %>><div style="display:flex;align-items:center;gap:7px"><input class="input" name="factor_weight_<%= index %>" type="number" min="0" max="100" step="0.01" value="<%= factor.weight*100 %>" <%= draft?'':'disabled' %>><span>%</span></div></div><% }) %>
      <% if (draft) { %><button class="btn btn-primary" style="margin-top:16px">Save scoring settings</button><% } %>
    </form>
  </div>

  <div class="panel">
    <div class="panel-head"><div><h2>Inherent-risk questions</h2><div class="meta">Question wording, ownership and every scored response option are controlled here.</div></div><span class="tag tag-neutral"><%= current.scoring.questions.length %></span></div>
    <% current.scoring.questions.forEach(question => { %>
      <details style="border-top:1px solid var(--border)"><summary style="list-style:none;cursor:pointer;padding:14px 18px;display:grid;grid-template-columns:64px minmax(0,1fr) 180px;gap:12px;align-items:center"><strong><%= question.id %></strong><span><%= canonicalTprmText(question.question) %></span><span class="meta"><%= canonicalTprmText(question.factor) %></span></summary>
        <form method="POST" action="/workspaces/<%= ws.id %>/supplier-methodology/inherent/<%= encodeURIComponent(question.id) %>" class="panel-pad" style="background:var(--surface-subtle)">
          <input type="hidden" name="section" value="methodology"><label class="label">Question</label><textarea class="textarea" name="question" rows="2" <%= draft?'':'disabled' %>><%= canonicalTprmText(question.question) %></textarea>
          <div class="grid-2" style="margin-top:10px"><div><label class="label">Guidance</label><textarea class="textarea" name="guidance" rows="2" <%= draft?'':'disabled' %>><%= canonicalTprmText(question.guidance) %></textarea></div><div><label class="label">Accountable owner</label><input class="input" name="owner" value="<%= canonicalTprmText(question.owner) %>" <%= draft?'':'disabled' %>></div></div>
          <div class="sec-label" style="margin-top:12px">Response labels</div><div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px"><% question.options.forEach((option,index) => { %><label class="meta"><%= option.score %><input class="input" name="option_<%= index %>" value="<%= canonicalTprmText(option.label) %>" <%= draft?'':'disabled' %>></label><% }) %></div>
          <% if (draft) { %><button class="btn btn-secondary" style="margin-top:12px">Save <%= question.id %></button><% } %>
        </form>
      </details>
    <% }) %>
  </div>
<% } %>

<% if (section === 'questionnaire') { %>
  <% if (draft) { %><details class="panel" style="margin-bottom:16px"><summary class="panel-head" style="cursor:pointer;list-style:none"><div><h2>Add a question</h2><div class="meta">Create a baseline question or attach it to a conditional module.</div></div><span>+</span></summary><form method="POST" action="/workspaces/<%= ws.id %>/supplier-methodology/ddq" class="panel-pad grid-2"><input type="hidden" name="section" value="questionnaire"><div><label class="label">Question ID</label><input class="input" name="question_id" required placeholder="e.g. GOV-10"></div><div><label class="label">Location</label><select class="select" name="module_name"><option value="">Baseline questionnaire</option><% current.modules.forEach(module => { %><option value="<%= module.name %>"><%= canonicalTprmText(module.name) %></option><% }) %></select></div><div><label class="label">Domain</label><input class="input" name="domain" value="Governance"></div><div><label class="label">Theme</label><input class="input" name="theme" required></div><div class="col-full"><label class="label">Question</label><textarea class="textarea" name="question" rows="2" required></textarea></div><div><label class="label">Guidance</label><textarea class="textarea" name="guidance" rows="2"></textarea></div><div><label class="label">Evidence expected</label><textarea class="textarea" name="evidence_required" rows="2"></textarea></div><div class="col-full row"><% ['tier_1','tier_2','tier_3','tier_4'].forEach(tier => { %><label><input type="checkbox" name="tiers" value="<%= tier %>" <%= tier==='tier_1'?'checked':'' %>> <%= canonicalTprmText(current.tiers[tier].label) %></label><% }) %></div><div class="col-full"><button class="btn btn-primary">Add to draft</button></div></form></details><% } %>

  <div class="panel" style="margin-bottom:16px"><div class="panel-head"><div><h2>Baseline questionnaire</h2><div class="meta">Tier membership determines assessment depth. Disabled questions stay in version history but are not issued.</div></div><span class="tag tag-neutral"><%= enabledBaseline.length %> enabled</span></div>
    <% const domains=[...new Set(current.ddqQuestions.map(question=>question.domain))]; domains.forEach(domain => { const questions=current.ddqQuestions.filter(question=>question.domain===domain); %>
      <details style="border-top:1px solid var(--border)"><summary style="list-style:none;cursor:pointer;padding:14px 18px;display:flex;justify-content:space-between"><strong><%= domain %></strong><span class="meta"><%= questions.filter(question=>question.enabled!==false).length %>/<%= questions.length %> enabled</span></summary>
        <% questions.forEach(question => { %><details style="border-top:1px solid var(--border);margin-left:18px"><summary style="list-style:none;cursor:pointer;padding:12px 18px;display:grid;grid-template-columns:70px minmax(0,1fr) 160px;gap:10px"><strong><%= question.id %></strong><span><%= canonicalTprmText(question.question) %></span><span class="meta"><%= question.enabled===false?'Disabled':question.tiers.map(tier=>tier.replace('tier_','T')).join(', ') %></span></summary>
          <form method="POST" action="/workspaces/<%= ws.id %>/supplier-methodology/ddq/<%= encodeURIComponent(question.id) %>" class="panel-pad" style="background:var(--surface-subtle)"><input type="hidden" name="section" value="questionnaire"><div class="row"><label><input type="checkbox" name="enabled" value="1" <%= question.enabled!==false?'checked':'' %> <%= draft?'':'disabled' %>> Enabled</label><label><input type="checkbox" name="evidence_mandatory" value="1" <%= question.evidenceMandatory?'checked':'' %> <%= draft?'':'disabled' %>> Evidence mandatory</label></div><div class="grid-2" style="margin-top:10px"><div><label class="label">Domain</label><input class="input" name="domain" value="<%= canonicalTprmText(question.domain) %>" <%= draft?'':'disabled' %>></div><div><label class="label">Theme</label><input class="input" name="theme" value="<%= canonicalTprmText(question.theme) %>" <%= draft?'':'disabled' %>></div></div><label class="label" style="margin-top:10px">Question</label><textarea class="textarea" name="question" rows="2" <%= draft?'':'disabled' %>><%= canonicalTprmText(question.question) %></textarea><div class="grid-2" style="margin-top:10px"><div><label class="label">Guidance</label><textarea class="textarea" name="guidance" rows="2" <%= draft?'':'disabled' %>><%= canonicalTprmText(question.guidance) %></textarea></div><div><label class="label">Evidence expected</label><textarea class="textarea" name="evidence_required" rows="2" <%= draft?'':'disabled' %>><%= canonicalTprmText(question.evidenceRequired) %></textarea></div></div><div class="row" style="margin-top:10px"><% ['tier_1','tier_2','tier_3','tier_4'].forEach(tier => { %><label><input type="checkbox" name="tiers" value="<%= tier %>" <%= question.tiers.includes(tier)?'checked':'' %> <%= draft?'':'disabled' %>> <%= canonicalTprmText(current.tiers[tier].label) %></label><% }) %></div><% if (draft) { %><button class="btn btn-secondary" style="margin-top:10px">Save <%= question.id %></button><% } %></form>
        </details><% }) %>
      </details>
    <% }) %>
  </div>

  <% current.modules.forEach((module,moduleIndex) => { %><div class="panel" style="margin-bottom:16px"><div class="panel-head"><div><h2><%= canonicalTprmText(module.name) %></h2><div class="meta"><%= module.rule.source==='automatic'?'Routed automatically from inherent-risk answers':'Confirmed by the service owner' %></div></div><span class="tag tag-neutral"><%= module.questions.filter(question=>question.enabled!==false).length %> enabled</span></div>
    <% if (draft) { %><form method="POST" action="/workspaces/<%= ws.id %>/supplier-methodology/module/<%= moduleIndex %>" class="panel-pad" style="display:grid;grid-template-columns:1fr 1fr auto;gap:8px;align-items:end"><input type="hidden" name="section" value="questionnaire"><div><label class="label">Module name</label><input class="input" name="name" value="<%= canonicalTprmText(module.name) %>"></div><div><label class="label">Owner-validation guidance</label><input class="input" name="guidance" value="<%= canonicalTprmText(module.rule.guidance || '') %>" <%= module.rule.source==='owner_validation'?'':'disabled' %>></div><button class="btn btn-secondary">Save module</button></form><% } %>
    <% module.questions.forEach(question => { %><details style="border-top:1px solid var(--border)"><summary style="list-style:none;cursor:pointer;padding:12px 18px;display:grid;grid-template-columns:80px minmax(0,1fr) 100px;gap:10px"><strong><%= question.id %></strong><span><%= canonicalTprmText(question.question) %></span><span class="meta"><%= question.enabled===false?'Disabled':'Enabled' %></span></summary><form method="POST" action="/workspaces/<%= ws.id %>/supplier-methodology/ddq/<%= encodeURIComponent(question.id) %>" class="panel-pad" style="background:var(--surface-subtle)"><input type="hidden" name="section" value="questionnaire"><div class="row"><label><input type="checkbox" name="enabled" value="1" <%= question.enabled!==false?'checked':'' %> <%= draft?'':'disabled' %>> Enabled</label><label><input type="checkbox" name="evidence_mandatory" value="1" <%= question.evidenceMandatory?'checked':'' %> <%= draft?'':'disabled' %>> Evidence mandatory</label></div><label class="label" style="margin-top:10px">Question</label><textarea class="textarea" name="question" rows="2" <%= draft?'':'disabled' %>><%= canonicalTprmText(question.question) %></textarea><div class="grid-2" style="margin-top:10px"><div><label class="label">Guidance</label><textarea class="textarea" name="guidance" rows="2" <%= draft?'':'disabled' %>><%= canonicalTprmText(question.guidance) %></textarea></div><div><label class="label">Evidence expected</label><textarea class="textarea" name="evidence_required" rows="2" <%= draft?'':'disabled' %>><%= canonicalTprmText(question.evidenceRequired) %></textarea></div></div><input type="hidden" name="theme" value="<%= question.theme || '' %>"><% if (draft) { %><button class="btn btn-secondary" style="margin-top:10px">Save <%= question.id %></button><% } %></form></details><% }) %>
  </div><% }) %>
<% } %>

<% if (section === 'versions') { %>
  <div class="panel"><div class="panel-head"><div><h2>Methodology version history</h2><div class="meta">Content hashes make the definition used for any decision independently verifiable.</div></div></div><table class="t"><thead><tr><th>Version</th><th>Name</th><th>Status</th><th>Published</th><th>Content hash</th></tr></thead><tbody><% history.forEach(row => { %><tr><td><strong><%= row.version %></strong></td><td><%= canonicalTprmText(row.name) %></td><td><span class="status s-<%= row.is_active?'done':row.status==='draft'?'in_progress':'todo' %>"><%= row.is_active?'active':row.status %></span></td><td class="meta"><%= row.published_at || 'Not published' %></td><td class="meta" style="font-family:var(--font-mono)"><%= row.content_hash ? row.content_hash.slice(0,16) : 'Not recorded' %></td></tr><% }) %></tbody></table></div>
<% } %>

</div>
<%- include('partials/footer') %>
