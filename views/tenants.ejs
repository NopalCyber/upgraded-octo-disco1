<%- include('partials/header', { title: 'Firms (tenants)', user, ws: null, active: 'tenants' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">Firms (tenants)</h1>
    <div class="page-subtitle">A firm is a fully isolated environment - its own users, clients, evidence directory, and audit log. Most consulting practices need exactly one firm.</div>
  </div>
</div>

<div class="panel" style="margin-bottom:18px;background:rgba(202,138,4,0.04);">
  <div class="panel-pad" style="display:grid;grid-template-columns:24px 1fr;gap:12px;align-items:start;">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#b45309" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <div>
      <div style="font-size:13.5px;font-weight: 500;color:#b45309;margin-bottom:6px;">Looking to add a new client?</div>
      <div class="meta text-md" style="line-height:1.55;">
        <strong>Don't create a firm here.</strong> A firm is a separate, walled-off environment - different users, different evidence directory, different encryption keys. Almost no one needs more than one. Each client is a separate scoped area inside a firm. To add a client, go to the <a href="/dashboard" style="color:var(--accent);font-weight:500;">Clients dashboard → New client</a>.
      </div>
      <div class="meta text-sm text-secondary" style="line-height:1.55;margin-top:8px;">
        Create a firm here only if you actually run a second consulting practice (or you want a clean sandbox), and you want its data invisible to the current firm.
      </div>
    </div>
  </div>
</div>

<details style="margin-bottom:18px;">
  <summary class="btn btn-secondary btn-xs" style="cursor:pointer;list-style:none;">+ Create a separate firm</summary>
  <div class="panel" style="margin-top:8px;">
    <div class="panel-head"><h2>Create new firm</h2></div>
    <form method="POST" action="/tenants" class="panel-pad" style="display:flex;gap:8px;align-items:flex-end;">
      <div style="flex:1;">
        <label class="label">Firm name</label>
        <input class="input" name="name" required placeholder="e.g., Smith Consulting Sandbox">
      </div>
      <button class="btn btn-primary" onclick="return appConfirmClick(event, 'A firm is a fully isolated environment with its own users and evidence. Almost no consulting practice needs more than one. Most likely you want to add a client instead - that lives on the Clients dashboard. Continue creating a new firm?');">Create + switch</button>
    </form>
    <div class="meta panel-pad text-sm" style="border-top:1px solid var(--border);padding-top:8px;">
      A new firm gets a fresh firm-owner user, a clean uploads directory at <code>uploads/firm_{id}/</code>, and zero clients. You'll switch into it after creation.
    </div>
  </div>
</details>

<div class="panel">
  <div class="panel-head">
    <h2>All firms (<%= firms.length %>)</h2>
  </div>
  <table class="t">
    <thead><tr>
      <th style="width:60px;">ID</th>
      <th>Name</th>
      <th style="width:140px;">Clients</th>
      <th style="width:160px;">Created</th>
      <th style="width:280px;text-align:right;">Action</th>
    </tr></thead>
    <tbody>
      <% firms.forEach(f => { %>
        <tr style="<%= f.id === activeFirmId ? 'background:rgba(8,145,178,0.05);' : '' %>">
          <td class="mono meta"><%= f.id %></td>
          <td>
            <form class="row-center" method="POST" action="/tenants/<%= f.id %>/rename">
              <input class="input text-lg" name="name" value="<%= f.name %>" style="flex:1;">
              <button class="btn btn-ghost btn-xs" title="Rename">Save</button>
            </form>
          </td>
          <td class="num meta"><%= f.workspace_count %></td>
          <td class="meta text-sm"><%= f.created_at ? f.created_at.slice(0,10) : '-' %></td>
          <td style="text-align:right;">
            <div style="display:flex;gap:6px;justify-content:flex-end;align-items:center;">
              <% if (f.id === activeFirmId) { %>
                <span class="tag tag-success text-eyebrow">active</span>
              <% } else { %>
                <form method="POST" action="/tenants/<%= f.id %>/switch" style="display:inline;">
                  <button class="btn btn-secondary btn-xs">Switch →</button>
                </form>
              <% } %>
              <% if (firms.length > 1) { %>
                <details style="display:inline-block;">
                  <summary class="btn btn-ghost btn-xs" style="color:var(--danger,#b91c1c);cursor:pointer;list-style:none;">Delete</summary>
                  <div class="popover-panel" style="position:absolute;right:24px;margin-top:6px;background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:12px;box-shadow:0 8px 24px rgba(0,0,0,0.12);z-index:10;--popover-w:340px;text-align:left;">
                    <div class="text-base" style="font-weight: 500;margin-bottom:6px;color:var(--danger,#b91c1c);">Permanently delete "<%= f.name %>"</div>
                    <div class="meta text-xs" style="line-height:1.45;margin-bottom:8px;">Removes all clients, evidence files, users, audit log, and the <code>uploads/firm_<%= f.id %>/</code> directory. Cannot be undone.</div>
                    <form method="POST" action="/tenants/<%= f.id %>/delete" onsubmit="return appConfirmForm(event, 'Final check: delete tenant &quot;<%= f.name %>&quot; and everything under it?');">
                      <label class="label text-xs">Type <strong><%= f.name %></strong> to confirm</label>
                      <input class="input text-base" name="confirm_name" required style="margin-bottom:8px;" autocomplete="off">
                      <button class="btn btn-xs" style="background:var(--danger,#b91c1c);color:#fff;border-color:var(--danger,#b91c1c);">Delete tenant</button>
                    </form>
                  </div>
                </details>
              <% } %>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
