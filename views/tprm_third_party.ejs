<%- include('partials/header', { title: thirdParty.name, user, ws, active }) %>
<%- include('partials/tprm_nav', { ws, active, canSettings }) %>

<div class="tprm-detail-hero">
  <section class="tprm-detail-primary"><div class="tprm-kicker"><%= thirdParty.stage_label %></div><h1><%= thirdParty.name %></h1><p><%= thirdParty.service_provided || 'Service scope not recorded' %></p><dl class="tprm-facts"><div><dt>Approved tier</dt><dd><%= titleCase(thirdParty.governed_tier, 'Not assigned') %></dd></div><div><dt>Residual risk</dt><dd><%= titleCase(thirdParty.residual_risk_band, 'Not concluded') %></dd></div><div><dt>Business owner</dt><dd><%= thirdParty.business_owner || 'Not assigned' %></dd></div><div><dt>Next review</dt><dd><%= dateOnly(thirdParty.next_review_date) || 'Not scheduled' %></dd></div></dl></section>
  <aside class="tprm-detail-action"><div class="tprm-kicker">Next action</div><h2><%= thirdParty.nextAction.label %></h2><p>Pending with <strong><%= thirdParty.nextAction.waitingOn %></strong><br>Owner: <%= thirdParty.nextAction.owner %><% if (thirdParty.nextAction.dueDate) { %><br>Due: <%= dateOnly(thirdParty.nextAction.dueDate) %><% } %></p><a class="btn btn-primary" href="<%= thirdParty.nextAction.href %>">Open action</a><% if (canGenerateReport) { %><a class="btn" style="margin-top:8px" href="/workspaces/<%= ws.id %>/assurance/new?type=supplier_due_diligence&amp;supplier_id=<%= thirdParty.id %>">Generate decision report</a><% } %></aside>
</div>

<section class="tprm-section"><div class="tprm-section-head"><div><h2>Assessment lifecycle</h2></div></div><div class="tprm-section-body"><ol class="tprm-lifecycle"><% thirdParty.lifecycleRail.forEach(item => { %><li class="<%= item.state %>"><%= item.label %></li><% }) %></ol></div></section>

<section class="tprm-section" id="cycle-governance">
  <div class="tprm-section-head"><div><h2><%= cycle ? `Assessment cycle ${cycle.cycle_number} · ${titleCase(cycle.cycle_type)}` : 'Start assessment cycle' %></h2><p>The scope, assessment records, recommendation, and client authority are bound to this cycle.</p></div><% if (cycle) { %><span class="tprm-status tprm-status-<%= cycle.status %>"><%= titleCase(cycle.status) %></span><% } %></div>
  <div class="tprm-section-body">
    <% if (!cycle) { %>
      <% if (canStartCycle) { %>
        <form method="POST" action="/workspaces/<%= ws.id %>/tprm/third-parties/<%= thirdParty.id %>/cycles">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expected_current_cycle_id" value="0"><input type="hidden" name="idempotency_key" value="<%= cycleNonce %>">
          <div class="form-grid"><label class="form-field"><span>Cycle type *</span><select class="select" name="cycle_type" required><option value="onboarding">Onboarding assessment</option><option value="periodic">Periodic reassessment</option><option value="triggered">Event-triggered reassessment</option></select></label><label class="form-field"><span>Target completion date</span><input class="input" type="date" name="due_at"></label><label class="form-field"><span>Client decision authority (optional)</span><select class="select" name="client_decision_authority_id"><option value="">Assign later</option><% clientOwners.forEach(owner => { %><option value="<%= owner.id %>"><%= owner.name %> · Client owner</option><% }) %></select><small>Only an active client owner can make the final onboarding decision.</small></label><label class="form-field"><span>Reason for this cycle</span><input class="input" name="trigger_reason" maxlength="500" placeholder="New service onboarding, scheduled review or material change"></label><fieldset class="form-field" style="grid-column:1/-1"><legend>Service relationships in scope *</legend><div class="tprm-record-list"><% serviceRelationships.forEach((relationship, index) => { %><label class="tprm-record-row"><span><strong><%= relationship.relationship_name %></strong><small><%= titleCase(relationship.criticality) %> criticality · <%= titleCase(relationship.status) %></small></span><input type="checkbox" name="relationship_ids" value="<%= relationship.id %>" <%= relationship.is_primary || serviceRelationships.length === 1 ? 'checked' : '' %> aria-label="Include <%= relationship.relationship_name %>"></label><% }) %><% if (!serviceRelationships.length) { %><div class="tprm-empty"><strong>No assessable service relationship exists</strong><span>Add the scoped service relationship before starting the cycle.</span></div><% } %></div><small>Select every distinct service covered by this assessment. The scope is retained with the cycle.</small></fieldset></div>
          <% if (!clientOwners.length) { %><div class="tprm-callout" style="margin-top:12px"><strong>No active client owner is available.</strong> The assessment can start, but a client owner must be invited and assigned before the onboarding decision.</div><% } %>
          <div style="display:flex;justify-content:flex-end;margin-top:14px"><button class="btn btn-primary" type="submit" <%= serviceRelationships.length ? '' : 'disabled' %>>Start assessment cycle</button></div>
        </form>
      <% } else { %><div class="tprm-callout"><strong>Cycle not started.</strong> <%= cycleBlocked %><% if (typeof canSettings !== 'undefined' && canSettings && /service (model|period)/.test(cycleBlocked || '')) { %> <a href="/workspaces/<%= ws.id %>/tprm/settings">Open TPRM settings</a><% } %></div><% } %>
    <% } else { %>
      <div class="tprm-grid-2"><div class="tprm-record-list"><div class="tprm-record-row"><span><strong>Cycle</strong><small>Immutable</small></span><span>#<%= cycle.cycle_number %> · <%= titleCase(cycle.cycle_type) %></span></div><div class="tprm-record-row"><span><strong>Schedule</strong><small>Started <%= dateOnly(cycle.started_at) %></small></span><span>Due <%= dateOnly(cycle.due_at) || 'not set' %></span></div><div class="tprm-record-row"><span><strong>Linked assessments</strong><small>Inherent risk / due diligence / contract</small></span><span><%= [cycle.inherent_assessment_id,cycle.ddq_assessment_id,cycle.contract_review_id].filter(Boolean).length %> / 3</span></div><div class="tprm-record-row"><span><strong>Service scope</strong><small>Fixed for this cycle</small></span><span><%= cycleRelationshipScopes.length ? cycleRelationshipScopes.map(scope => scope.relationship_name).join(', ') : 'No service scope linked' %></span></div></div><div class="tprm-record-list"><div class="tprm-record-row"><span><strong>Client decision authority</strong><small>Fixed after assignment</small></span><span><%= authority ? authority.name : 'Not assigned' %></span></div><div class="tprm-record-row"><span><strong>Lifecycle stage</strong><small>System calculated</small></span><span><%= thirdParty.stage_label %></span></div><div class="tprm-record-row"><span><strong>Record version</strong></span><span><%= cycle.row_version %></span></div></div></div>
      <% if (!authority && canAssignAuthority) { %>
        <% if (clientOwners.length) { %><form class="tprm-inline-governance" method="POST" action="/workspaces/<%= ws.id %>/tprm/third-parties/<%= thirdParty.id %>/cycles/<%= cycle.id %>/authority" style="margin-top:16px;padding-top:14px;border-top:1px solid var(--border)"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expected_cycle_row_version" value="<%= cycle.row_version %>"><input type="hidden" name="idempotency_key" value="<%= authorityNonce %>"><div class="form-grid"><label class="form-field"><span>Assign client decision authority *</span><select class="select" name="client_decision_authority_id" required><option value="">Select an active client owner</option><% clientOwners.forEach(owner => { %><option value="<%= owner.id %>"><%= owner.name %> · <%= owner.email %></option><% }) %></select></label><label class="form-field"><span>Assignment reason</span><input class="input" name="reason" maxlength="500" placeholder="Named business decision authority for this service"></label></div><div style="display:flex;justify-content:flex-end;margin-top:10px"><button class="btn" type="submit">Assign authority</button></div></form><% } else { %><div class="tprm-callout" style="margin-top:14px"><strong>Decision authority blocked:</strong> invite an active client owner before assigning final onboarding authority.</div><% } %>
      <% } %>
      <% const cycleHasClientDecision = currentClientDecision && Number(currentClientDecision.cycle_id) === Number(cycle.id); %>
      <% if (canAssignAuthority && !currentRecommendation && !cycleHasClientDecision) { %>
        <details style="margin-top:16px;padding-top:14px;border-top:1px solid var(--border)">
          <summary style="cursor:pointer;font-weight:650">Cancel cycle</summary>
          <div class="tprm-callout" style="margin-top:10px"><strong>History is retained.</strong> Cancellation is permitted only before a recommendation or client decision is issued.</div>
          <form method="POST" action="/workspaces/<%= ws.id %>/tprm/third-parties/<%= thirdParty.id %>/cycles/<%= cycle.id %>/cancel" style="margin-top:10px">
            <input type="hidden" name="expected_row_version" value="<%= cycle.row_version %>">
            <label class="form-field"><span>Cancellation reason *</span><textarea class="textarea" name="cancellation_reason" minlength="10" maxlength="2000" rows="2" required placeholder="Explain why this assessment cycle is being stopped."></textarea></label>
            <label class="tprm-confirm"><input type="checkbox" required><span>I understand that the cycle and linked records remain in the audit history.</span></label>
            <div style="display:flex;justify-content:flex-end;margin-top:10px"><button class="btn" type="submit">Cancel cycle</button></div>
          </form>
        </details>
      <% } else if (canAssignAuthority && (currentRecommendation || cycleHasClientDecision)) { %>
        <div class="tprm-callout" style="margin-top:14px"><strong>Cancellation is locked.</strong> An issued recommendation or client decision is already bound to this cycle.</div>
      <% } %>
    <% } %>
  </div>
</section>

<section class="tprm-decision-grid" id="decision-boundary">
  <article class="tprm-decision-card consultancy"><div class="tprm-kicker">Consultancy</div><h2>Recommendation</h2><strong class="tprm-decision-value"><%= titleCase(currentRecommendation && currentRecommendation.outcome, 'Not issued') %></strong><p>Independent professional advice based on the assessment record. It does not authorize onboarding.</p><% if (currentRecommendation) { %><span class="tprm-status" style="margin-top:12px">Version <%= currentRecommendation.version %> · <%= dateOnly(currentRecommendation.issued_at) %></span><% } %></article>
  <article class="tprm-decision-card client"><div class="tprm-kicker">Client</div><h2>Onboarding decision</h2><strong class="tprm-decision-value"><%= titleCase(currentClientDecision && currentClientDecision.decision, 'Pending client decision') %></strong><p>Only the assigned client decision authority can onboard, impose conditions, decline, or defer.</p><% if (currentClientDecision) { %><span class="tprm-status <%= currentClientDecision.diverges_from_recommendation ? 'tprm-status-high' : 'tprm-status-complete' %>" style="margin-top:12px"><%= currentClientDecision.diverges_from_recommendation ? 'Differs from recommendation' : `Version ${currentClientDecision.version}` %></span><% } %><a class="btn" style="margin-top:12px" href="/workspaces/<%= ws.id %>/client-portal/tprm/<%= thirdParty.id %>">Open client view</a></article>
</section>

<% if (canViewEvidenceReleases) { %>
<section class="tprm-section" id="client-evidence">
  <div class="tprm-section-head"><div><h2>Client evidence disclosure</h2><p>Only explicitly released evidence is available in the client portal.</p></div><a class="btn btn-xs" href="/workspaces/<%= ws.id %>/tprm/assurance#evidence-disclosures">Disclosure register</a></div>
  <div class="tprm-section-body">
    <div class="tprm-callout tprm-disclosure-warning"><strong>Review before release.</strong> The approved label, category, purpose, and selected file metadata become visible to the client. Internal paths and notes remain private.</div>
    <% if (canReleaseEvidence && releasableEvidence.length) { %>
      <form method="POST" action="/workspaces/<%= ws.id %>/tprm/third-parties/<%= thirdParty.id %>/evidence-releases" style="margin-top:14px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="cycle_id" value="<%= cycle.id %>"><input type="hidden" name="expected_cycle_row_version" value="<%= cycle.row_version %>"><input type="hidden" name="idempotency_key" value="<%= evidenceReleaseNonce %>">
        <div class="form-grid"><label class="form-field"><span>Governed evidence source *</span><select class="select" name="evidence_reference" required><option value="">Select one exact evidence item</option><% releasableEvidence.forEach(item => { %><option value="<%= item.source_type %>:<%= item.id %>"><%= titleCase(item.source_category) %> · <%= item.source_name %><%= item.question_id ? ` · ${item.question_id}` : '' %><%= item.expiry_date ? ` · source expires ${dateOnly(item.expiry_date)}` : '' %></option><% }) %></select><small>The source must belong to this third party and, for questionnaire evidence, this exact assessment cycle.</small></label><label class="form-field"><span>Client-safe label *</span><input class="input" name="client_label" minlength="3" maxlength="240" required placeholder="e.g. Independent assurance report"></label><label class="form-field"><span>Client access expires</span><input class="input" type="date" name="expires_at" min="<%= portfolio.today %>"><small>Optional. The item automatically disappears from the client portal after this date.</small></label><label class="form-field" style="grid-column:1/-1"><span>Client-facing purpose *</span><textarea class="textarea" name="client_description" rows="2" minlength="10" maxlength="2000" required placeholder="Explain why this evidence is being shared and what it demonstrates. Do not include internal commentary."></textarea></label></div>
        <label class="tprm-confirm"><input type="checkbox" name="allow_download" value="1"><span>Allow the client to download the released file, where a protected download route is available. Leave clear for metadata-only disclosure.</span></label>
        <label class="tprm-confirm"><input type="checkbox" name="release_confirmed" value="1" required><span>I checked the label and purpose for client disclosure and understand this creates an immutable release record. Corrections require a new evidence version; withdrawal does not erase history.</span></label>
        <div style="display:flex;justify-content:flex-end;margin-top:14px"><button class="btn btn-primary" type="submit">Release to client</button></div>
      </form>
    <% } else if (canReleaseEvidence) { %><div class="tprm-callout" style="margin-top:14px"><strong>No unreleased evidence is available in this cycle.</strong> Add or version the underlying relationship document or due-diligence evidence first. A withdrawn immutable source cannot be relabelled and re-released.</div>
    <% } else if (canManageEvidenceReleases && !cycle) { %><div class="tprm-callout" style="margin-top:14px"><strong>No active assessment cycle.</strong> Start the governed cycle before releasing new evidence. Existing releases can still be withdrawn below.</div>
    <% } else { %><div class="tprm-callout" style="margin-top:14px"><strong>Disclosure management permission required.</strong> You can inspect the register, but only an authorized firm assurance user can release or withdraw client evidence.</div><% } %>
  </div>
  <div class="tprm-table-wrap"><table class="tprm-table"><thead><tr><th>Client-safe disclosure</th><th>Source category</th><th>Cycle</th><th>Released by</th><th>Client access</th><th>Status</th><th>Action</th></tr></thead><tbody>
    <% releasedEvidenceHistory.forEach(record => { const releaseExpired = record.release_expires_at && record.release_expires_at < portfolio.today; %><tr><td><strong><%= record.client_label %></strong><small><%= record.client_description || 'No client-facing purpose recorded' %></small></td><td><%= titleCase(record.source_category) %><small><%= record.question_id || record.source_filename || 'Metadata record' %><%= record.source_expiry_date ? ` · source expires ${dateOnly(record.source_expiry_date)}` : '' %></small></td><td>#<%= record.cycle_id %></td><td><%= record.released_by_name || 'Consultancy user' %><small><%= dateOnly(record.released_at) %><%= record.release_expires_at ? ` · access expires ${dateOnly(record.release_expires_at)}` : ' · no access expiry' %></small></td><td><%= record.allow_download ? 'Metadata + download' : 'Metadata only' %></td><td><span class="tprm-status <%= !record.withdrawal_id && !releaseExpired ? 'tprm-status-complete' : '' %>"><%= record.withdrawal_id ? 'Withdrawn' : (releaseExpired ? 'Expired' : 'Released') %></span><% if (record.withdrawal_id) { %><small><%= record.withdrawal_reason %> · <%= dateOnly(record.withdrawn_at) %></small><% } %></td><td><% if (!record.withdrawal_id && !releaseExpired && canManageEvidenceReleases) { %><details class="tprm-withdraw"><summary>Withdraw</summary><form method="POST" action="/workspaces/<%= ws.id %>/tprm/third-parties/<%= thirdParty.id %>/evidence-releases/<%= record.release_id %>/withdraw"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expected_release_hash" value="<%= record.release_hash %>"><input type="hidden" name="expected_withdrawal_id" value="0"><input type="hidden" name="idempotency_key" value="<%= record.withdrawalNonce %>"><label class="form-field"><span>Reason *</span><textarea class="textarea" name="reason" rows="2" minlength="10" maxlength="2000" required placeholder="Explain why client access must be withdrawn."></textarea></label><button class="btn btn-xs" type="submit">Confirm withdrawal</button></form></details><% } else { %><span class="tprm-muted"><%= record.withdrawal_id || releaseExpired ? 'Historical record' : 'Read only' %></span><% } %></td></tr><% }) %>
    <% if (!releasedEvidenceHistory.length) { %><tr><td colspan="7"><div class="tprm-empty"><strong>No evidence has been released</strong><span>The client portal remains deny-by-default.</span></div></td></tr><% } %>
  </tbody></table></div>
</section>
<% } %>

<%- include('partials/tprm_recommendation_workflow') %>

<div class="tprm-grid-2">
  <section class="tprm-section"><div class="tprm-section-head"><div><h2>Assessment status</h2></div></div><div class="tprm-section-body tprm-record-list">
    <a class="tprm-record-row" href="<%= moduleReadOnly ? `/workspaces/${ws.id}/tprm` : `/workspaces/${ws.id}/vendors/${thirdParty.id}/inherent-risk` %>"><span><strong>Inherent risk and tiering</strong><small><%= thirdParty.governed_inherent_score == null ? 'Score not approved' : `${Math.round(thirdParty.governed_inherent_score)}/100 · ${titleCase(thirdParty.governed_tier)}` %></small></span><span><%= titleCase(thirdParty.inherent_status) %></span></a>
    <a class="tprm-record-row" href="<%= moduleReadOnly ? `/workspaces/${ws.id}/tprm` : `/workspaces/${ws.id}/vendors/${thirdParty.id}/due-diligence` %>"><span><strong>Provider due diligence</strong><small><%= thirdParty.provider_contact_name || 'Provider contact not assigned' %></small></span><span><%= titleCase(thirdParty.ddq_status) %></span></a>
    <a class="tprm-record-row" href="<%= moduleReadOnly ? `/workspaces/${ws.id}/tprm` : `/workspaces/${ws.id}/vendors/${thirdParty.id}/contract-review` %>"><span><strong>Contract assurance</strong><small>Security and data protection clauses</small></span><span><%= titleCase(thirdParty.contract_status) %></span></a>
  </div></section>
  <section class="tprm-section"><div class="tprm-section-head"><div><h2>Ownership and service context</h2></div></div><div class="tprm-section-body tprm-record-list"><div class="tprm-record-row"><span><strong>Relationship owner</strong></span><span><%= thirdParty.relationship_owner || 'Not assigned' %></span></div><div class="tprm-record-row"><span><strong>Security reviewer</strong></span><span><%= thirdParty.security_reviewer || 'Not assigned' %></span></div><div class="tprm-record-row"><span><strong>Provider contact</strong></span><span><%= thirdParty.provider_contact_name || thirdParty.contact || 'Not assigned' %></span></div><div class="tprm-record-row"><span><strong>Dependency</strong></span><span><%= titleCase(thirdParty.dependency_type, 'Not recorded') %></span></div><div class="tprm-record-row"><span><strong>Data access</strong></span><span><%= titleCase(thirdParty.data_access, 'Not recorded') %></span></div></div></section>
</div>

<section class="tprm-section" id="findings"><div class="tprm-section-head"><div><h2>Open findings: <%= findings.filter(f => !['closed','verified'].includes(f.status)).length %></h2><p>Critical findings require treatment or formal acceptance before a positive recommendation.</p></div><a class="btn btn-xs" href="/workspaces/<%= ws.id %>/tprm/findings?third_party=<%= thirdParty.id %>">View findings</a></div><div class="tprm-section-body tprm-record-list"><% findings.slice(0,8).forEach(finding => { %><div class="tprm-record-row"><span><strong><%= finding.title %></strong><small><%= titleCase(finding.severity) %> · <%= finding.domain || 'General' %></small></span><span><%= titleCase(finding.status) %><small><%= dateOnly(finding.risk_acceptance_expires_at || finding.due_date) || 'No due date' %></small></span></div><% }) %><% if (!findings.length) { %><div class="tprm-empty"><strong>No findings recorded</strong><span>Assessment findings will appear here.</span></div><% } %></div></section>

<section class="tprm-section"><div class="tprm-section-head"><div><h2>Decision history</h2><p>Each client decision is linked to the applicable recommendation version.</p></div></div><div class="tprm-table-wrap"><table class="tprm-table"><thead><tr><th>Record</th><th>Version</th><th>Outcome</th><th>Accountable actor</th><th>Reviewer / authority</th><th>Date</th><th>Integrity</th></tr></thead><tbody>
<% governedRecommendations.forEach(record => { %><tr><td><strong>Consultancy recommendation</strong><small>Cycle <%= record.cycle_id %></small></td><td>v<%= record.version %></td><td><%= titleCase(record.outcome) %><small><%= titleCase(record.residual_risk_band, 'Unknown') %> residual risk</small></td><td><%= record.issuer_name || record.author_name %><small>Assessment author</small></td><td><%= record.quality_reviewer_name || record.reviewer_name %><small>Independent QA reviewer</small></td><td><%= dateOnly(record.issued_at) %></td><td><code><%= record.recommendation_hash.slice(0,12) %>…</code></td></tr><% }) %>
<% clientDecisions.forEach(record => { %><tr><td><strong>Client onboarding decision</strong><small>Recommendation v<%= record.recommendation_version %></small></td><td>v<%= record.version %></td><td><%= titleCase(record.decision) %><small><%= record.diverges_from_recommendation ? 'Differs from consultancy recommendation' : 'Aligned with recommendation' %></small></td><td><%= record.client_actor_name || record.client_actor_display_name %><small><%= record.client_actor_title %></small></td><td><%= record.authority_basis %><small>Client authority basis</small></td><td><%= dateOnly(record.decided_at) %></td><td><code><%= record.decision_hash.slice(0,12) %>…</code></td></tr><% }) %>
<% if (!governedRecommendations.length && !clientDecisions.length) { %><tr><td colspan="7"><div class="tprm-empty"><strong>No governed recommendation or client decision issued</strong><span>The assessment remains in consultancy fieldwork or review.</span></div></td></tr><% } %>
</tbody></table></div></section>

<% if (governedConditions.length) { %><section class="tprm-section" id="conditions">
  <div class="tprm-section-head"><div><h2>Conditions</h2><p>Client completion, consultancy review, and manager waiver are recorded separately.</p></div></div>
  <div class="tprm-table-wrap"><table class="tprm-table"><thead><tr><th>Condition</th><th>Owner and due date</th><th>Status</th><th>Submitted completion</th><th>Governed review</th></tr></thead><tbody>
    <% governedConditions.forEach(condition => { const conditionFinal = ['verified','waived','cancelled'].includes(condition.status); %><tr>
      <td><strong><%= condition.title %></strong><small><%= condition.description %></small><small><%= titleCase(condition.source_type) %> · <%= titleCase(condition.severity) %></small></td>
      <td><%= condition.owner_name %><small><%= titleCase(condition.owner_type) %> · due <%= dateOnly(condition.due_date) %></small></td>
      <td><span class="tprm-status <%= condition.status === 'verified' ? 'tprm-status-complete' : (condition.status === 'evidence_submitted' || condition.waiver_expired) ? 'tprm-status-high' : '' %>"><%= condition.waiver_expired ? 'Waiver expired' : titleCase(condition.effective_status || condition.status) %></span><small>Row version <%= condition.row_version %></small><% if (condition.status === 'waived') { %><small><%= condition.waiver_expired ? 'Expired' : 'Expires' %> <%= dateOnly(condition.waiver_expires_at) %></small><% } %></td>
      <td><% if (condition.completion_note) { %><%= condition.completion_note %><% } else { %><span class="tprm-muted">Not submitted</span><% } %><% if (condition.evidence_summary) { %><small><a href="/workspaces/<%= ws.id %>/tprm/third-parties/<%= thirdParty.id %>/conditions/<%= condition.id %>/evidence/latest/download">Download inspected evidence · <%= condition.evidence_summary %></a></small><% } %></td>
      <td><div style="max-width:360px"><strong><%= condition.verification_criteria %></strong>
        <% if (condition.waiver_expired) { %><div class="tprm-callout"><strong>Reassessment required.</strong> This time-limited waiver has expired and is an operative blocker again. Start a governed assessment cycle and issue a new recommendation/decision; do not extend the historic waiver in place.</div>
        <% } else if (condition.status === 'evidence_submitted') { %>
          <details style="margin-top:8px"><summary style="cursor:pointer">Review submission</summary>
            <form method="POST" action="/workspaces/<%= ws.id %>/tprm/third-parties/<%= thirdParty.id %>/conditions/<%= condition.id %>/verify" style="margin-top:8px"><input type="hidden" name="expected_row_version" value="<%= condition.row_version %>"><label class="form-field"><span>Verification conclusion *</span><textarea class="textarea" name="review_note" minlength="10" maxlength="4000" rows="2" required placeholder="State what was independently checked and why the evidence meets the condition."></textarea></label><button class="btn btn-xs" type="submit">Verify condition</button></form>
            <form method="POST" action="/workspaces/<%= ws.id %>/tprm/third-parties/<%= thirdParty.id %>/conditions/<%= condition.id %>/request-changes" style="margin-top:12px;padding-top:10px;border-top:1px solid var(--border)"><input type="hidden" name="expected_row_version" value="<%= condition.row_version %>"><label class="form-field"><span>Specific changes required *</span><textarea class="textarea" name="review_note" minlength="10" maxlength="4000" rows="2" required placeholder="Tell the client owner exactly what is missing or unsuitable."></textarea></label><button class="btn btn-xs" type="submit">Request changes</button></form>
          </details>
        <% } else if (!conditionFinal) { %><small>Waiting for the assigned client owner to submit completion.</small><% } else { %><small>Final governed state. The underlying history remains immutable.</small><% } %>
        <% if (!conditionFinal && ['manager','firm_owner'].includes(String(user.firm_role || '').toLowerCase())) { %>
          <details style="margin-top:10px"><summary style="cursor:pointer">Manager-only time-limited waiver</summary><form method="POST" action="/workspaces/<%= ws.id %>/tprm/third-parties/<%= thirdParty.id %>/conditions/<%= condition.id %>/waive" style="margin-top:8px"><input type="hidden" name="expected_row_version" value="<%= condition.row_version %>"><label class="form-field"><span>Explicit waiver rationale *</span><textarea class="textarea" name="waiver_rationale" minlength="20" maxlength="4000" rows="2" required></textarea></label><label class="form-field"><span>Waiver expires *</span><input class="input" type="date" name="waiver_expires_at" min="<%= portfolio.today %>" required></label><button class="btn btn-xs" type="submit">Record manager waiver</button></form></details>
        <% } %>
      </div></td>
    </tr><% }) %>
  </tbody></table></div>
</section><% } %>

<div class="tprm-grid-2" id="monitoring">
  <section class="tprm-section"><div class="tprm-section-head"><div><h2>Documents (<%= documents.length %>)</h2></div></div><div class="tprm-section-body tprm-record-list"><% documents.slice(0,8).forEach(doc => { %><div class="tprm-record-row"><span><strong><%= doc.name %></strong><small><%= titleCase(doc.doc_type, 'Evidence') %></small></span><span><%= dateOnly(doc.expiry_date) || 'No expiry' %></span></div><% }) %><% if (!documents.length) { %><div class="tprm-empty"><strong>No relationship documents</strong><span>Assessment evidence is retained in the due-diligence workpaper.</span></div><% } %></div></section>
  <section class="tprm-section"><div class="tprm-section-head"><div><h2>Monitoring history</h2></div></div><div class="tprm-section-body tprm-record-list"><% reviews.slice(0,4).forEach(review => { %><div class="tprm-record-row"><span><strong><%= review.outcome || 'Periodic review' %></strong><small><%= review.reviewer || 'Reviewer not recorded' %></small></span><span><%= dateOnly(review.review_date) %></span></div><% }) %><% monitoring.slice(0,4).forEach(event => { %><div class="tprm-record-row"><span><strong><%= event.source || 'Monitoring signal' %></strong><small><%= event.notes || 'No narrative recorded' %></small></span><span><%= dateOnly(event.recorded_at) %></span></div><% }) %><% if (!reviews.length && !monitoring.length) { %><div class="tprm-empty"><strong>No monitoring history</strong><span>Monitoring begins after the client onboarding decision.</span></div><% } %></div></section>
</div>

<section class="tprm-section"><div class="tprm-section-head"><div><h2>Audit history</h2><p>Superseded conclusions remain available for review.</p></div></div><div class="tprm-section-body"><% if (decisions.length) { %><div class="tprm-callout" style="margin-bottom:12px"><strong>Legacy decision quarantine:</strong> historical firm decisions are retained as evidence, not treated as client onboarding decisions. Only the assigned client decision authority can record a governed decision.</div><% } %><div class="tprm-record-list"><% decisions.slice(0,6).forEach(decision => { %><div class="tprm-record-row"><span><strong>Legacy historical decision · <%= titleCase(decision.decision) %></strong><small><%= decision.decider_name || decision.decided_by_name %> · methodology <%= decision.methodology_version %></small></span><span><%= dateOnly(decision.decided_at) %><small>Not a client decision</small></span></div><% }) %><% activity.slice(0,8).forEach(event => { %><div class="tprm-record-row"><span><strong><%= titleCase(event.action) %></strong><small><%= event.actor_name || 'System' %></small></span><span><%= dateOnly(event.created_at) %></span></div><% }) %></div></div></section>
<%- include('partials/footer') %>
